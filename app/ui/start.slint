import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, TipArea } from "components.slint";
import { MenuPopup, MenuEntry } from "menu.slint";
import { WidgetBody, WCfg, WidgetData } from "widgets.slint";
import { WidgetConfigPanel, TipBubble } from "wconfig.slint";

/// Wiersz listy aplikacji: litera (nagłówek grupy) albo aplikacja.
export struct StartRow {
    header: bool,
    name: string,
    img: image,
    has-img: bool,
    /// Ukryta, a widoczna tylko dlatego, że włączono „Pokaż ukryte”.
    hidden: bool,
    /// Drugi wiersz (folder pliku, „Ustawienia Windows”) i ikona, gdy nie ma obrazka.
    detail: string,
    icon: string,
}

/// Kafelek przypiętej aplikacji albo folder – miejsce i rozmiar liczy starttiles.rs.
export struct StartTile {
    name: string,
    img: image,
    has-img: bool,
    x: length,
    y: length,
    w: length,
    h: length,
    /// 0 – średni, 1 – mały (sama ikona), 2 – szeroki, 3 – duży.
    size: int,
    folder: bool,
    /// Folder: ikony pierwszych aplikacji (do czterech).
    minis: [image],
    /// Widżet (rodzaj) zamiast aplikacji i treść notatki.
    widget: string,
    note: string,
    /// Ustawienia widżetu („Dostosuj…”).
    cfg: WCfg,
}

/// Nagłówek grupy kafelków (nazwa do wpisania jak w Windows 10).
export struct StartHead {
    name: string,
    y: length,
}

/// Przycisk lewej kolumny (konto, foldery, ustawienia, zasilanie).
component RailButton inherits Rectangle {
    in property <string> icon;
    in property <string> tip;
    callback clicked(length, length);
    width: 48px;
    height: 44px;
    background: rb-ta.has-hover ? Theme.hover : transparent;
    Icon {
        commands: root.icon;
        size: 18px;
        color: Theme.text;
    }
    rb-ta := TipArea {
        tip: root.tip;
        clicked => {
            root.clicked(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
        }
    }
}

/// Menu Start PowerDesk – układ Windows 10: wąska kolumna z kontem, folderami, ustawieniami
/// i zasilaniem; lista aplikacji z literami; kafelki przypiętych. Pisanie od razu szuka.
export component StartWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    title: @tr("PowerDesk – Start");
    background: Theme.popup-high;
    // Rozmiar tylko proponowany – okno zmienia go start.rs (przeciąganie krawędzi, motywy);
    // stały `width`/`height` trzymał treść w 660×640 i reszta okna prześwitywała.
    preferred-width: 660px;
    preferred-height: 640px;

    in property <[StartRow]> rows;
    in property <[StartTile]> tiles;
    in property <[StartHead]> heads;
    /// Wysokość wszystkich grup (do przewijania).
    in property <length> tiles-h;
    /// Otwarty folder kafelków – jego nazwa i przycisk powrotu zamiast nagłówków grup.
    in property <bool> in-folder;
    in property <string> folder-name;
    in property <string> user;
    /// Duże ikony w siatce zamiast listy (bez liter grup).
    in property <bool> grid;
    /// Samo wyszukiwanie (Win+S): bez lewej kolumny i kafelków, lista na całą szerokość.
    in property <bool> search-only;
    /// Motyw Startu: 0 – Windows 10 (kafelki), 1 – Windows 11 (na środku, siatka aplikacji),
    /// 2 – klasyczny (wąska lista jak w Windows 7). Kafelki i widżety we wszystkich motywach.
    in property <int> style;
    property <bool> tiles-on: !root.search-only;
    in-out property <string> query;
    /// Przeciągany kafelek (-1 – żaden) i jego podgląd w obszarze kafelków.
    in-out property <int> drag-index: -1;
    in-out property <length> drag-x;
    in-out property <length> drag-y;
    in-out property <length> drag-w;
    in-out property <length> drag-h;
    // Menu podręczne (pozycje i miejsce podaje taskbar.rs).
    in property <[MenuEntry]> menu-entries;
    in property <length> menu-x;
    in property <length> menu-y;
    in property <length> menu-width: 240px;

    callback search(string);
    /// Enter w polu szukania – pierwsza znaleziona aplikacja.
    callback launch-first();
    callback launch(int);
    callback launch-tile(int);
    /// Prawy przycisk na aplikacji / kafelku – menu (współrzędne w oknie).
    callback row-context(int, length, length);
    callback tile-context(int, length, length);
    /// Kafelek przeciągnięty i puszczony w (x, y) obszaru kafelków.
    callback tile-drop(int, length, length);
    callback group-rename(int, string);
    callback folder-rename(string);
    callback folder-back();
    /// Prawy przycisk na pustym miejscu kafelków (x, y w oknie).
    callback tiles-context(length, length);
    /// Notatka w kafelku zmieniona.
    callback tile-note(int, string);
    /// Kafelek notatki, w którym teraz piszemy (-1 – żaden).
    in-out property <int> editing: -1;
    /// Lewa kolumna: 0 – konto, 1 – Dokumenty, 2 – Obrazy, 3 – Ustawienia, 4 – zasilanie.
    callback rail(int, length, length);
    callback menu-chosen(int);
    callback dismiss();
    /// Przeciąganie krawędzi: początek (0 – górna, 1 – prawa, 2 – róg), ruch, koniec.
    /// Rozmiar liczy start.rs z położenia kursora na ekranie (okno przesuwa się w trakcie).
    callback resize-start(int);
    callback resize-move();
    callback resize-end();

    public function show-menu() {
        menu.show();
    }
    public function focus-search() {
        q.focus();
    }

    HorizontalLayout {
        // Lewa kolumna – jak w Windows 10: konto na górze, reszta przy dole.
        VerticalLayout {
            width: root.search-only ? 0px : 48px;
            visible: !root.search-only;
            padding-top: 6px;
            padding-bottom: 6px;
            RailButton {
                icon: Icons.menu-lines;
                tip: root.user;
                clicked(x, y) => {
                    root.rail(0, x, y);
                }
            }
            Rectangle {
                vertical-stretch: 1;
            }
            RailButton {
                icon: Icons.pc;
                tip: @tr("Komputer");
                clicked(x, y) => {
                    root.rail(5, x, y);
                }
            }
            RailButton {
                icon: Icons.doc;
                tip: @tr("Dokumenty");
                clicked(x, y) => {
                    root.rail(1, x, y);
                }
            }
            RailButton {
                icon: Icons.image;
                tip: @tr("Obrazy");
                clicked(x, y) => {
                    root.rail(2, x, y);
                }
            }
            RailButton {
                icon: Icons.settings;
                tip: @tr("Ustawienia");
                clicked(x, y) => {
                    root.rail(3, x, y);
                }
            }
            RailButton {
                icon: Icons.power;
                tip: @tr("Zasilanie");
                clicked(x, y) => {
                    root.rail(4, x, y);
                }
            }
        }

        // Lista aplikacji z polem szukania.
        VerticalLayout {
            width: root.tiles-on ? 290px : root.width - (root.search-only ? 0px : 48px);
            padding: root.search-only ? 12px : 8px;
            spacing: 6px;
            Rectangle {
                height: 34px;
                border-radius: Theme.r-s;
                background: Theme.panel;
                border-width: 1px;
                border-color: q.has-focus ? Theme.accent : Theme.line;
                Icon {
                    x: 10px;
                    commands: Icons.search;
                    size: 14px;
                    color: Theme.dim;
                }
                if root.query == "": Text {
                    x: 32px;
                    text: root.search-only ? @tr("Szukaj aplikacji, plików i ustawień") : @tr("Wpisz, aby wyszukać");
                    font-size: 12.5px;
                    color: Theme.faint;
                }
                q := TextInput {
                    x: 32px;
                    width: parent.width - 42px;
                    text <=> root.query;
                    single-line: true;
                    vertical-alignment: center;
                    font-size: 12.5px;
                    color: Theme.text;
                    edited => {
                        root.search(self.text);
                    }
                    accepted => {
                        root.launch-first();
                    }
                    key-pressed(e) => {
                        if (e.text == Key.Escape) {
                            root.dismiss();
                            return accept;
                        }
                        reject
                    }
                }
            }
            if !root.grid: Flickable {
                vertical-stretch: 1;
                content-height: lst.preferred-height;
                lst := VerticalLayout {
                    alignment: start;
                    for r[i] in root.rows: Rectangle {
                        height: r.header ? 34px : 36px;
                        border-radius: Theme.r-s;
                        background: !r.header && ar-ta.has-hover ? Theme.hover : transparent;
                        if r.header: Text {
                            x: 10px;
                            text: r.name;
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.accent;
                        }
                        if !r.header: HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 10px;
                            Rectangle {
                                width: 24px;
                                if r.has-img: Image {
                                    width: 24px;
                                    height: 24px;
                                    source: r.img;
                                }
                                if !r.has-img: Icon {
                                    commands: r.icon != "" ? r.icon : Icons.app;
                                    size: 18px;
                                    color: Theme.dim;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: r.name;
                                    overflow: elide;
                                    font-size: 12.5px;
                                    color: r.hidden ? Theme.faint : Theme.text;
                                }
                                if r.detail != "": Text {
                                    text: r.detail;
                                    overflow: elide;
                                    font-size: 10.5px;
                                    color: Theme.faint;
                                }
                            }
                        }
                        ar-ta := TouchArea {
                            enabled: !r.header;
                            mouse-cursor: pointer;
                            clicked => {
                                root.launch(i);
                            }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                                    root.row-context(i, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                    }
                }
            }
            // Duże ikony (jak w nowym Windows): siatka kafli 86×92, podpis pod ikoną.
            if root.grid: Flickable {
                vertical-stretch: 1;
                property <int> cols: max(1, floor(self.width / 86px));
                content-height: ceil(root.rows.length / self.cols) * 92px;
                for r[i] in root.rows: Rectangle {
                    x: mod(i, parent.cols) * 86px;
                    y: floor(i / parent.cols) * 92px;
                    width: 84px;
                    height: 90px;
                    border-radius: Theme.r;
                    background: gr-ta.has-hover ? Theme.hover : transparent;
                    if r.has-img: Image {
                        y: 12px;
                        width: 36px;
                        height: 36px;
                        source: r.img;
                        opacity: r.hidden ? 0.45 : 1;
                    }
                    if !r.has-img: Icon {
                        y: 18px;
                        commands: Icons.app;
                        size: 26px;
                        color: Theme.dim;
                    }
                    Text {
                        x: 4px;
                        y: 56px;
                        width: parent.width - 8px;
                        height: 30px;
                        horizontal-alignment: center;
                        vertical-alignment: top;
                        text: r.name;
                        wrap: word-wrap;
                        overflow: elide;
                        font-size: 10.5px;
                        color: r.hidden ? Theme.faint : Theme.text;
                    }
                    gr-ta := TipArea {
                        tip: r.name;
                        clicked => {
                            root.launch(i);
                        }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                                root.row-context(i, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                    }
                }
            }
        }

        // Kafelki: grupy z nazwami, siatka 6 pól po 52 px, przeciąganie z podglądem.
        Rectangle {
            horizontal-stretch: 0;
            width: root.tiles-on ? 6 * 52px + 28px : 0px;
            visible: root.tiles-on;
            if root.tiles.length == 0 && !root.in-folder: Text {
                x: 14px;
                y: 44px;
                width: parent.width - 28px;
                text: @tr("Prawy przycisk na aplikacji → „Przypnij do Startu”.");
                wrap: word-wrap;
                font-size: 12px;
                color: Theme.faint;
            }
            // Folder: powrót i nazwa folderu.
            if root.in-folder: Rectangle {
                x: 14px;
                y: 8px;
                width: parent.width - 28px;
                height: 30px;
                Rectangle {
                    x: 0;
                    width: 28px;
                    height: 28px;
                    border-radius: Theme.r;
                    background: fb-ta.has-hover ? Theme.hover : transparent;
                    Icon {
                        commands: Icons.back;
                        size: 16px;
                        color: Theme.text;
                    }
                    fb-ta := TipArea {
                        tip: @tr("Wróć do grup");
                        clicked => {
                            root.folder-back();
                        }
                    }
                }
                TextInput {
                    x: 36px;
                    width: parent.width - 36px;
                    height: 28px;
                    vertical-alignment: center;
                    text: root.folder-name;
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.text;
                    accepted => {
                        root.folder-rename(self.text);
                    }
                }
            }
            tiles-fl := Flickable {
                x: 14px;
                y: root.in-folder ? 44px : 8px;
                width: parent.width - 14px;
                height: parent.height - self.y - 8px;
                content-height: max(root.tiles-h + 60px, self.height);
                // Puste miejsce: prawy przycisk – dodawanie widżetów.
                TouchArea {
                    width: parent.width;
                    height: max(root.tiles-h + 60px, tiles-fl.height);
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                            root.tiles-context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                }
                for h[g] in root.heads: TextInput {
                    x: 0;
                    y: h.y;
                    width: 6 * 52px - 4px;
                    height: 28px;
                    vertical-alignment: center;
                    text: h.name;
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.text;
                    // Pusta nazwa – podpowiedź jak w Windows (wpis i Enter nadaje nazwę).
                    if self.text == "" && !self.has-focus: Text {
                        text: @tr("Nazwij grupę");
                        font-size: 12px;
                        color: Theme.faint;
                        x: 0;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                    accepted => {
                        root.group-rename(g, self.text);
                    }
                }
                for t[i] in root.tiles: tile := Rectangle {
                    x: t.x;
                    y: t.y;
                    width: t.w;
                    height: t.h;
                    border-radius: Theme.r;
                    background: tl-ta.has-hover ? Theme.hover : Theme.card;
                    opacity: root.drag-index == i ? 0.4 : 1;
                    property <length> icon: t.size == 1 ? 24px : t.size == 3 ? 48px : 32px;
                    // Widżet z przyciskami (średni i większy) leży nad kafelkiem i sam przyjmuje kliknięcia.
                    property <bool> live: t.widget != "" && t.size != 1 && WidgetData.interactive(t.widget) && t.widget != "note";
                    if t.widget != "" && !tile.live: WidgetBody {
                        width: parent.width;
                        height: parent.height;
                        kind: t.widget;
                        note: t.note;
                        cfg: t.cfg;
                        editable: false;
                    }
                    if t.widget == "" && !t.folder && t.has-img: Image {
                        y: t.size == 1 ? (parent.height - parent.icon) / 2 : (parent.height - parent.icon) / 2 - 8px;
                        width: parent.icon;
                        height: parent.icon;
                        source: t.img;
                    }
                    if t.widget == "" && !t.folder && !t.has-img: Icon {
                        y: t.size == 1 ? (parent.height - 20px) / 2 : (parent.height - 24px) / 2 - 8px;
                        commands: Icons.app;
                        size: t.size == 1 ? 20px : 24px;
                        color: Theme.dim;
                    }
                    // Folder: do czterech ikon w kratce.
                    for m[k] in t.minis: Image {
                        x: (parent.width - 40px) / 2 + mod(k, 2) * 22px;
                        y: (t.size == 1 ? (parent.height - 40px) / 2 : (parent.height - 40px) / 2 - 8px) + floor(k / 2) * 22px;
                        width: 18px;
                        height: 18px;
                        source: m;
                    }
                    if t.size != 1 && t.widget == "": Text {
                        x: 6px;
                        y: parent.height - 22px;
                        width: parent.width - 12px;
                        horizontal-alignment: t.size == 0 ? center : left;
                        text: t.name;
                        overflow: elide;
                        font-size: 11px;
                        color: Theme.text;
                    }
                    tl-ta := TipArea {
                        tip: t.size == 1 ? t.name : "";
                        mouse-cursor: pointer;
                        property <bool> drag: self.pressed && (abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px);
                        property <bool> was-drag;
                        moved => {
                            if (self.drag) {
                                root.drag-index = i;
                                root.drag-x = tiles-fl.x + tiles-fl.content-x + t.x + self.mouse-x - self.pressed-x;
                                root.drag-y = tiles-fl.y + tiles-fl.content-y + t.y + self.mouse-y - self.pressed-y;
                                root.drag-w = t.w;
                                root.drag-h = t.h;
                            }
                        }
                        clicked => {
                            if (!self.was-drag) {
                                root.launch-tile(i);
                            }
                        }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                self.was-drag = false;
                            }
                            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left && root.drag-index == i) {
                                self.was-drag = true;
                                root.drag-index = -1;
                                root.tile-drop(i, t.x + self.mouse-x, t.y + self.mouse-y);
                            }
                            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                                root.tile-context(i, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                    }
                    if tile.live: WidgetBody {
                        width: parent.width;
                        height: parent.height;
                        kind: t.widget;
                        note: t.note;
                        cfg: t.cfg;
                        editable: false;
                    }
                    // Pisanie w notatce (z menu kafelka) – pole nad kafelkiem, Esc albo klik obok kończy.
                    if root.editing == i: WidgetBody {
                        width: parent.width;
                        height: parent.height;
                        kind: "note";
                        note: t.note;
                        cfg: { alpha: 1, seconds: true };
                        editable: true;
                        note-edited(txt) => {
                            root.tile-note(i, txt);
                        }
                    }
                }
            }
            // Podgląd przeciąganego kafelka.
            if root.drag-index >= 0: Rectangle {
                x: root.drag-x;
                y: root.drag-y;
                width: root.drag-w;
                height: root.drag-h;
                border-radius: Theme.r;
                background: Theme.sel;
                border-width: 1px;
                border-color: Theme.accent;
                opacity: 0.8;
            }
        }
    }

    // Uchwyty zmiany rozmiaru: górna krawędź, prawa krawędź i prawy górny róg.
    for e in [0, 1, 2]: TouchArea {
        enabled: !root.search-only;
        x: e == 0 ? 0 : root.width - 6px;
        y: 0;
        width: e == 0 ? root.width - 12px : 6px;
        height: e == 1 ? root.height : 6px;
        mouse-cursor: e == 0 ? MouseCursor.ns-resize : e == 1 ? MouseCursor.ew-resize : MouseCursor.nesw-resize;
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                root.resize-start(e);
            } else if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up) {
                root.resize-end();
            }
        }
        moved => {
            if (self.pressed) {
                root.resize-move();
            }
        }
    }

    WidgetConfigPanel {
        width: root.width;
        height: root.height;
    }

    menu := MenuPopup {
        x: root.menu-x;
        y: root.menu-y;
        menu-width: root.menu-width;
        entries: root.menu-entries;
        chosen(i) => {
            root.menu-chosen(i);
        }
    }

    TipBubble {
        width: root.width;
        height: root.height;
    }
}
