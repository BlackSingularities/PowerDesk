import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon } from "components.slint";

/// Dzień w widżecie kalendarza (siatka 7×6 od poniedziałku).
export struct WDay {
    day: int,
    /// Dzień bieżącego miesiąca (inne – przygaszone).
    cur: bool,
    today: bool,
}

/// Dysk w widżecie dysków.
export struct WDrive {
    name: string,
    used: float,
    detail: string,
}

/// Zegar w innej strefie czasowej.
export struct WZone {
    city: string,
    time: string,
    /// Różnica względem czasu lokalnego („+6 h”, „jutro”).
    note: string,
}

/// Dzień prognozy pogody.
export struct WFc {
    name: string,
    kind: int,
    hi: string,
    lo: string,
}

/// Przypomnienie: kiedy i co.
export struct WRem {
    when: string,
    text: string,
    soon: bool,
}

/// Widżet na pulpicie (miejsce i rozmiar wolne) albo w kafelku Startu.
export struct WidgetItem {
    kind: string,
    note: string,
    x: length,
    y: length,
    w: length,
    h: length,
}

/// Zadanie na liście.
export struct WTodo {
    text: string,
    done: bool,
}

/// Kurs waluty: kod, wartość w zł i zmiana od poprzedniej tabeli (+/−).
export struct WFx {
    code: string,
    value: string,
    change: string,
    up: bool,
}

/// Dane wspólne dla wszystkich widżetów okna – odświeża widgets.rs co sekundę.
export global WidgetData {
    in-out property <string> time;
    in-out property <string> seconds;
    /// Część minuty, która minęła (0–1) – pasek sekund zegara.
    in-out property <float> sec-frac;
    in-out property <string> weekday;
    in-out property <string> date;
    in-out property <string> month;
    in-out property <int> day;
    in-out property <[WDay]> days;
    in-out property <float> cpu;
    in-out property <float> ram;
    in-out property <string> cpu-text;
    in-out property <string> ram-text;
    in-out property <string> uptime;
    /// Zużycie procesora z ostatnich 40 odczytów (0–1).
    in-out property <[float]> cpu-hist;
    in-out property <[WDrive]> drives;
    // Zegary świata.
    in-out property <[WZone]> zones;
    // Pogoda: miejscowość, temperatura, opis, rodzaj (ikona), wiatr, prognoza, stan pobierania.
    in-out property <bool> w-ok;
    in-out property <string> w-city;
    in-out property <string> w-temp;
    in-out property <string> w-desc;
    in-out property <int> w-kind;
    in-out property <string> w-wind;
    in-out property <[WFc]> w-days;
    in-out property <string> w-status;
    // Co teraz gra.
    in-out property <bool> m-has;
    in-out property <string> m-title;
    in-out property <string> m-artist;
    in-out property <bool> m-playing;
    /// Przyciski: 0 – poprzedni, 1 – odtwórz/wstrzymaj, 2 – następny.
    callback media(int);
    // Zdjęcia z folderu.
    in-out property <bool> p-has;
    in-out property <image> p-img;
    in-out property <string> p-name;
    in-out property <string> p-status;
    // Przypomnienia (najbliższe).
    in-out property <[WRem]> rems;
    // Sieć: prędkości i historia pobierania (0–1 względem najwyższej).
    in-out property <string> net-down;
    in-out property <string> net-up;
    in-out property <[float]> net-hist;
    // Schowek: ostatnie teksty; klik – z powrotem do schowka.
    in-out property <[string]> clips;
    callback clip-pick(int);
    // Zadania: tekst i czy zrobione; klik – przełącza.
    in-out property <[WTodo]> todos;
    callback todo-toggle(int);
    // Kursy walut NBP i data tabeli.
    in-out property <[WFx]> fx;
    in-out property <string> fx-date;
    // Odliczanie: do czego, duża liczba z jednostką, reszta.
    in-out property <string> cd-label;
    in-out property <string> cd-big;
    in-out property <string> cd-unit;
    in-out property <string> cd-rest;
}

/// Ikona pogody rysowana kształtami (bez czcionek z emoji): słońce, chmura, deszcz, śnieg, burza, mgła.
export component WeatherIcon inherits Rectangle {
    in property <int> kind;
    in property <length> size: 40px;
    width: root.size;
    height: root.size;
    property <bool> sun: root.kind == 0 || root.kind == 1;
    property <bool> cloud: root.kind >= 1;
    // Słońce: tarcza i promienie (przy częściowym zachmurzeniu – mniejsze, w rogu).
    if root.sun: Rectangle {
        property <length> r: root.kind == 0 ? root.size * 0.24 : root.size * 0.18;
        property <length> cx: root.kind == 0 ? root.size / 2 : root.size * 0.36;
        property <length> cy: root.kind == 0 ? root.size / 2 : root.size * 0.34;
        for a in [0, 45, 90, 135, 180, 225, 270, 315]: Rectangle {
            x: parent.cx + cos(a * 1deg) * parent.r * 1.55 - self.width / 2;
            y: parent.cy + sin(a * 1deg) * parent.r * 1.55 - self.height / 2;
            width: root.size * 0.07;
            height: self.width;
            border-radius: self.width / 2;
            background: #f5b83d;
        }
        Rectangle {
            x: parent.cx - parent.r;
            y: parent.cy - parent.r;
            width: parent.r * 2;
            height: self.width;
            border-radius: parent.r;
            background: #f5b83d;
        }
    }
    // Chmura: trzy koła i podstawa.
    if root.cloud: Rectangle {
        property <color> c: root.kind == 6 ? #8a8f99 : root.kind >= 4 ? #b4bac4 : #e6e9ee;
        property <length> base: root.kind >= 4 ? root.size * 0.58 : root.size * 0.72;
        Rectangle {
            x: root.size * 0.16;
            y: parent.base - root.size * 0.22;
            width: root.size * 0.7;
            height: root.size * 0.22;
            border-radius: self.height / 2;
            background: parent.c;
        }
        Rectangle {
            x: root.size * 0.24;
            y: parent.base - root.size * 0.36;
            width: root.size * 0.28;
            height: self.width;
            border-radius: self.width / 2;
            background: parent.c;
        }
        Rectangle {
            x: root.size * 0.4;
            y: parent.base - root.size * 0.46;
            width: root.size * 0.36;
            height: self.width;
            border-radius: self.width / 2;
            background: parent.c;
        }
    }
    // Opady: krople albo płatki; burza – błyskawica; mgła – poziome kreski.
    if root.kind == 4 || root.kind == 5: Rectangle {
        for k in [0, 1, 2]: Rectangle {
            x: root.size * (0.3 + k * 0.17);
            y: root.size * (0.66 + mod(k, 2) * 0.08);
            width: root.kind == 5 ? root.size * 0.08 : root.size * 0.05;
            height: root.kind == 5 ? self.width : root.size * 0.14;
            border-radius: self.width / 2;
            background: root.kind == 5 ? #ffffff : #4f8cff;
        }
    }
    if root.kind == 6: Path {
        x: root.size * 0.38;
        y: root.size * 0.56;
        width: root.size * 0.24;
        height: root.size * 0.38;
        viewbox-width: 6;
        viewbox-height: 10;
        commands: "M 4 0 L 0 6 L 3 6 L 2 10 L 6 4 L 3 4 Z";
        fill: #f5b83d;
    }
    if root.kind == 3: Rectangle {
        for k in [0, 1, 2]: Rectangle {
            x: root.size * (0.14 + mod(k, 2) * 0.08);
            y: root.size * (0.3 + k * 0.18);
            width: root.size * 0.64;
            height: root.size * 0.06;
            border-radius: self.height / 2;
            background: #c9ced6;
        }
    }
}

/// Pasek zajętości: tło, wypełnienie w kolorze akcentu (czerwone powyżej 90%).
component Meter inherits Rectangle {
    in property <float> value;
    height: 6px;
    border-radius: 3px;
    background: Theme.line-strong;
    Rectangle {
        x: 0;
        width: parent.width * max(0, min(1, root.value));
        height: parent.height;
        border-radius: parent.border-radius;
        background: root.value > 0.9 ? #e5484d : Theme.accent;
        animate width { duration: 400ms; easing: ease-out; }
    }
}

/// Mały nagłówek widżetu: ikona i nazwa.
component WTitle inherits HorizontalLayout {
    in property <string> icon;
    in property <string> text;
    height: 18px;
    spacing: 6px;
    Icon {
        commands: root.icon;
        size: 13px;
        color: Theme.dim;
    }
    Text {
        text: root.text;
        font-size: 11px;
        font-weight: 600;
        color: Theme.dim;
        vertical-alignment: center;
    }
}

/// Treść widżetu dopasowana do rozmiaru: mały kafelek pokazuje najważniejsze, duży – więcej.
export component WidgetBody inherits Rectangle {
    in property <string> kind;
    in property <string> note;
    /// Notatka do pisania (na pulpicie zawsze, w Starcie – po „Edytuj notatkę”).
    in property <bool> editable: true;
    callback note-edited(string);
    property <bool> compact: root.height < 120px;
    property <length> pad: root.compact ? 10px : 14px;
    border-radius: Theme.r;
    clip: true;
    background: root.kind == "note" ? Theme.accent.mix(Theme.popup-high, 0.18).with-alpha(0.92) : Theme.popup-high.with-alpha(0.86);

    // ---------- Zegar ----------
    if root.kind == "clock": clk := Rectangle {
        property <length> big: min(root.height * (root.compact ? 0.42 : 0.34), root.width * 0.24);
        VerticalLayout {
            padding: root.pad;
            spacing: 2px;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                spacing: 4px;
                Text {
                    text: WidgetData.time;
                    font-size: clk.big;
                    font-weight: 300;
                    color: Theme.text;
                }
                if !root.compact: Text {
                    y: parent.height - self.height - 6px;
                    text: WidgetData.seconds;
                    font-size: clk.big * 0.36;
                    color: Theme.dim;
                }
            }
            if root.height >= 90px: Text {
                horizontal-alignment: center;
                text: root.compact ? WidgetData.weekday : WidgetData.weekday + ", " + WidgetData.date;
                font-size: root.compact ? 11px : 13px;
                color: Theme.dim;
                overflow: elide;
            }
        }
        // Upływ minuty – cienka linia u dołu.
        Rectangle {
            x: 0;
            y: root.height - 3px;
            width: root.width * WidgetData.sec-frac;
            height: 3px;
            background: Theme.accent.with-alpha(0.8);
        }
    }

    // ---------- Kalendarz ----------
    // Mały: dzień tygodnia i duża liczba (jak kafelek Kalendarza w Windows 10); duży – cały miesiąc.
    if root.kind == "calendar" && (root.height < 190px || root.width < 190px): VerticalLayout {
        padding: root.pad;
        alignment: center;
        Text {
            horizontal-alignment: center;
            text: WidgetData.weekday;
            font-size: 12px;
            color: Theme.dim;
        }
        Text {
            horizontal-alignment: center;
            text: WidgetData.day;
            font-size: min(root.height * 0.42, root.width * 0.4);
            font-weight: 300;
            color: Theme.text;
        }
        if root.height >= 110px: Text {
            horizontal-alignment: center;
            text: WidgetData.month;
            font-size: 11px;
            color: Theme.dim;
        }
    }
    if root.kind == "calendar" && root.height >= 190px && root.width >= 190px: Rectangle {
        property <length> cw: (root.width - 2 * root.pad) / 7;
        property <length> ch: (root.height - 2 * root.pad - 46px) / 6;
        Text {
            x: root.pad;
            y: root.pad;
            text: WidgetData.month;
            font-size: 13px;
            font-weight: 600;
            color: Theme.text;
        }
        for n[k] in ["pn", "wt", "śr", "cz", "pt", "so", "nd"]: Text {
            x: root.pad + k * parent.cw;
            y: root.pad + 22px;
            width: parent.cw;
            horizontal-alignment: center;
            text: n;
            font-size: 10.5px;
            color: Theme.faint;
        }
        for d[i] in WidgetData.days: Rectangle {
            x: root.pad + mod(i, 7) * parent.cw;
            y: root.pad + 42px + floor(i / 7) * parent.ch;
            width: parent.cw;
            height: parent.ch;
            Rectangle {
                width: min(parent.width, parent.height) - 2px;
                height: self.width;
                border-radius: self.width / 2;
                background: d.today ? Theme.accent : transparent;
            }
            Text {
                text: d.day;
                font-size: 11.5px;
                font-weight: d.today ? 700 : 400;
                color: d.today ? white : d.cur ? Theme.text : Theme.faint;
            }
        }
    }

    // ---------- System ----------
    if root.kind == "system": VerticalLayout {
        padding: root.pad;
        spacing: root.compact ? 6px : 8px;
        if !root.compact: WTitle {
            icon: Icons.bolt;
            text: "System · działa " + WidgetData.uptime;
        }
        HorizontalLayout {
            Text {
                text: "Procesor";
                font-size: 11.5px;
                color: Theme.dim;
                horizontal-stretch: 1;
            }
            Text {
                text: WidgetData.cpu-text;
                font-size: 11.5px;
                font-weight: 600;
                color: Theme.text;
            }
        }
        Meter {
            value: WidgetData.cpu;
        }
        HorizontalLayout {
            Text {
                text: "Pamięć";
                font-size: 11.5px;
                color: Theme.dim;
                horizontal-stretch: 1;
            }
            Text {
                text: WidgetData.ram-text;
                font-size: 11.5px;
                font-weight: 600;
                color: Theme.text;
            }
        }
        Meter {
            value: WidgetData.ram;
        }
        // Historia procesora – słupki, gdy jest miejsce.
        if root.height >= 170px: Rectangle {
            vertical-stretch: 1;
            min-height: 30px;
            for v[i] in WidgetData.cpu-hist: Rectangle {
                x: i * parent.width / 40;
                width: max(1px, parent.width / 40 - 1px);
                height: max(1px, v * parent.height);
                y: parent.height - self.height;
                border-radius: 1px;
                background: Theme.accent.with-alpha(0.35 + v * 0.5);
            }
        }
    }

    // ---------- Dyski ----------
    if root.kind == "drives": VerticalLayout {
        padding: root.pad;
        spacing: 6px;
        if !root.compact: WTitle {
            icon: Icons.drive;
            text: "Dyski";
        }
        for d in WidgetData.drives: VerticalLayout {
            spacing: 3px;
            HorizontalLayout {
                Text {
                    text: d.name;
                    font-size: 11.5px;
                    color: Theme.text;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.width >= 150px: Text {
                    text: d.detail;
                    font-size: 10.5px;
                    color: Theme.dim;
                }
            }
            Meter {
                value: d.used;
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }
    }

    // ---------- Zegary świata ----------
    if root.kind == "clocks": VerticalLayout {
        padding: root.pad;
        spacing: root.compact ? 4px : 8px;
        if !root.compact: WTitle {
            icon: Icons.history;
            text: "Zegary świata";
        }
        for z in WidgetData.zones: HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: z.city;
                    font-size: 12.5px;
                    color: Theme.text;
                    overflow: elide;
                }
                if !root.compact: Text {
                    text: z.note;
                    font-size: 10.5px;
                    color: Theme.dim;
                }
            }
            Text {
                text: z.time;
                font-size: root.compact ? 16px : 22px;
                font-weight: 300;
                color: Theme.text;
                vertical-alignment: center;
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }
    }

    // ---------- Pogoda ----------
    if root.kind == "weather" && !WidgetData.w-ok: VerticalLayout {
        padding: root.pad;
        alignment: center;
        spacing: 6px;
        HorizontalLayout {
            alignment: center;
            WeatherIcon {
                kind: 2;
                size: 36px;
            }
        }
        Text {
            horizontal-alignment: center;
            text: WidgetData.w-status;
            wrap: word-wrap;
            font-size: 11.5px;
            color: Theme.dim;
        }
    }
    if root.kind == "weather" && WidgetData.w-ok: VerticalLayout {
        padding: root.pad;
        spacing: 6px;
        HorizontalLayout {
            spacing: 10px;
            WeatherIcon {
                kind: WidgetData.w-kind;
                size: root.compact ? 40px : 54px;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: WidgetData.w-temp;
                    font-size: root.compact ? 26px : 34px;
                    font-weight: 300;
                    color: Theme.text;
                }
                Text {
                    text: WidgetData.w-desc;
                    font-size: 11.5px;
                    color: Theme.dim;
                    overflow: elide;
                }
            }
        }
        if !root.compact: Text {
            text: WidgetData.w-city + " · wiatr " + WidgetData.w-wind;
            font-size: 11px;
            color: Theme.faint;
            overflow: elide;
        }
        // Prognoza na kolejne dni, gdy jest miejsce.
        if root.height >= 170px: HorizontalLayout {
            spacing: 4px;
            for d in WidgetData.w-days: VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    horizontal-alignment: center;
                    text: d.name;
                    font-size: 10.5px;
                    color: Theme.dim;
                }
                HorizontalLayout {
                    alignment: center;
                    WeatherIcon {
                        kind: d.kind;
                        size: 24px;
                    }
                }
                Text {
                    horizontal-alignment: center;
                    text: d.hi + " " + d.lo;
                    font-size: 10.5px;
                    color: Theme.text;
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }
    }

    // ---------- Co teraz gra ----------
    if root.kind == "media": VerticalLayout {
        padding: root.pad;
        padding-top: root.compact ? root.pad : 24px;
        spacing: 4px;
        alignment: center;
        Text {
            text: WidgetData.m-has ? WidgetData.m-title : "Nic nie gra";
            font-size: 13.5px;
            font-weight: 600;
            color: WidgetData.m-has ? Theme.text : Theme.faint;
            overflow: elide;
        }
        if WidgetData.m-has && WidgetData.m-artist != "": Text {
            text: WidgetData.m-artist;
            font-size: 11.5px;
            color: Theme.dim;
            overflow: elide;
        }
        if WidgetData.m-has && root.height >= 90px: HorizontalLayout {
            alignment: center;
            spacing: 6px;
            for k in [0, 1, 2]: Rectangle {
                width: k == 1 ? 36px : 30px;
                height: self.width;
                border-radius: self.width / 2;
                background: k == 1 ? Theme.accent : mb-ta.has-hover ? Theme.hover : transparent;
                Icon {
                    commands: k == 1 ? (WidgetData.m-playing ? Icons.pause : Icons.play) : k == 0 ? Icons.back : Icons.fwd;
                    size: 16px;
                    color: k == 1 ? white : Theme.text;
                }
                mb-ta := TouchArea {
                    clicked => {
                        WidgetData.media(k);
                    }
                }
            }
        }
    }

    // ---------- Zdjęcia ----------
    if root.kind == "photos" && WidgetData.p-has: Rectangle {
        Image {
            width: root.width;
            height: root.height;
            source: WidgetData.p-img;
            image-fit: cover;
        }
        if root.height >= 120px: Rectangle {
            y: root.height - 26px;
            height: 26px;
            background: @linear-gradient(0deg, #00000099 0%, #00000000 100%);
            Text {
                x: 10px;
                width: parent.width - 20px;
                text: WidgetData.p-name;
                font-size: 11px;
                color: #ffffffdd;
                overflow: elide;
                vertical-alignment: center;
            }
        }
    }
    if root.kind == "photos" && !WidgetData.p-has: VerticalLayout {
        padding: root.pad;
        alignment: center;
        spacing: 6px;
        HorizontalLayout {
            alignment: center;
            Icon {
                commands: Icons.image;
                size: 28px;
                color: Theme.faint;
            }
        }
        Text {
            horizontal-alignment: center;
            text: WidgetData.p-status;
            wrap: word-wrap;
            font-size: 11.5px;
            color: Theme.dim;
        }
    }

    // ---------- Przypomnienia ----------
    if root.kind == "reminders": VerticalLayout {
        padding: root.pad;
        spacing: 6px;
        if !root.compact: WTitle {
            icon: Icons.check;
            text: "Przypomnienia";
        }
        if WidgetData.rems.length == 0: Text {
            text: "Brak – prawy przycisk → „Dodaj przypomnienie…”";
            wrap: word-wrap;
            font-size: 11.5px;
            color: Theme.faint;
        }
        for r in WidgetData.rems: HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 6px;
                height: 6px;
                y: 6px;
                border-radius: 3px;
                background: r.soon ? Theme.accent : Theme.faint;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                Text {
                    text: r.text;
                    font-size: 12px;
                    color: Theme.text;
                    overflow: elide;
                }
                Text {
                    text: r.when;
                    font-size: 10.5px;
                    color: r.soon ? Theme.accent : Theme.dim;
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }
    }

    // ---------- Sieć ----------
    if root.kind == "network": VerticalLayout {
        padding: root.pad;
        spacing: 6px;
        if !root.compact: WTitle {
            icon: Icons.wifi;
            text: "Sieć";
        }
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                Text {
                    text: "↓ pobieranie";
                    font-size: 10.5px;
                    color: Theme.dim;
                }
                Text {
                    text: WidgetData.net-down;
                    font-size: root.compact ? 15px : 19px;
                    font-weight: 300;
                    color: Theme.text;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                Text {
                    text: "↑ wysyłanie";
                    font-size: 10.5px;
                    color: Theme.dim;
                }
                Text {
                    text: WidgetData.net-up;
                    font-size: root.compact ? 15px : 19px;
                    font-weight: 300;
                    color: Theme.text;
                }
            }
        }
        if root.height >= 140px: Rectangle {
            vertical-stretch: 1;
            min-height: 26px;
            for v[i] in WidgetData.net-hist: Rectangle {
                x: i * parent.width / 40;
                width: max(1px, parent.width / 40 - 1px);
                height: max(1px, v * parent.height);
                y: parent.height - self.height;
                border-radius: 1px;
                background: Theme.accent.with-alpha(0.3 + v * 0.55);
            }
        }
    }

    // ---------- Schowek ----------
    if root.kind == "clipboard": VerticalLayout {
        padding: root.pad;
        spacing: 4px;
        if !root.compact: WTitle {
            icon: Icons.paste;
            text: "Schowek · klik – skopiuj ponownie";
        }
        if WidgetData.clips.length == 0: Text {
            text: "Nic jeszcze nie skopiowano";
            font-size: 11.5px;
            color: Theme.faint;
        }
        for c[i] in WidgetData.clips: Rectangle {
            height: 24px;
            border-radius: Theme.r-s;
            background: cp-ta.has-hover ? Theme.hover : transparent;
            Text {
                x: 6px;
                width: parent.width - 12px;
                text: c;
                font-size: 12px;
                color: Theme.text;
                overflow: elide;
                vertical-alignment: center;
            }
            cp-ta := TouchArea {
                clicked => {
                    WidgetData.clip-pick(i);
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }
    }

    // ---------- Zadania ----------
    if root.kind == "todo": VerticalLayout {
        padding: root.pad;
        padding-top: root.compact ? root.pad : 24px;
        spacing: 2px;
        if WidgetData.todos.length == 0: Text {
            text: "Brak zadań – prawy przycisk → „Dodaj zadanie…”";
            wrap: word-wrap;
            font-size: 11.5px;
            color: Theme.faint;
        }
        for t[i] in WidgetData.todos: Rectangle {
            height: 26px;
            border-radius: Theme.r-s;
            background: td-ta.has-hover ? Theme.hover : transparent;
            HorizontalLayout {
                padding-left: 4px;
                spacing: 8px;
                Rectangle {
                    y: (parent.height - 14px) / 2;
                    width: 14px;
                    height: 14px;
                    border-radius: 4px;
                    border-width: 1.5px;
                    border-color: t.done ? Theme.accent : Theme.dim;
                    background: t.done ? Theme.accent : transparent;
                    if t.done: Icon {
                        commands: Icons.check;
                        size: 11px;
                        color: white;
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    text: t.text;
                    font-size: 12px;
                    color: t.done ? Theme.faint : Theme.text;
                    overflow: elide;
                }
            }
            td-ta := TouchArea {
                clicked => {
                    WidgetData.todo-toggle(i);
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }
    }

    // ---------- Kursy walut ----------
    if root.kind == "currency": VerticalLayout {
        padding: root.pad;
        spacing: 4px;
        if !root.compact: WTitle {
            icon: Icons.hash;
            text: "Kursy NBP · " + WidgetData.fx-date;
        }
        if WidgetData.fx.length == 0: Text {
            text: "Pobieranie kursów…";
            font-size: 11.5px;
            color: Theme.faint;
        }
        for f in WidgetData.fx: HorizontalLayout {
            spacing: 8px;
            Text {
                width: 40px;
                text: f.code;
                font-size: 12px;
                font-weight: 600;
                color: Theme.dim;
            }
            Text {
                horizontal-stretch: 1;
                text: f.value;
                font-size: root.compact ? 13px : 15px;
                color: Theme.text;
            }
            Text {
                text: f.change;
                font-size: 11px;
                color: f.up ? #3ddc84 : #ff6b6b;
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }
    }

    // ---------- Odliczanie ----------
    if root.kind == "countdown": VerticalLayout {
        padding: root.pad;
        alignment: center;
        spacing: 2px;
        Text {
            horizontal-alignment: center;
            text: WidgetData.cd-label;
            font-size: 12px;
            color: Theme.dim;
            overflow: elide;
        }
        HorizontalLayout {
            alignment: center;
            spacing: 6px;
            Text {
                text: WidgetData.cd-big;
                font-size: min(root.height * 0.36, root.width * 0.26);
                font-weight: 300;
                color: Theme.text;
            }
            Text {
                y: parent.height - self.height - 8px;
                text: WidgetData.cd-unit;
                font-size: 13px;
                color: Theme.dim;
            }
        }
        if root.height >= 100px: Text {
            horizontal-alignment: center;
            text: WidgetData.cd-rest;
            font-size: 11px;
            color: Theme.faint;
        }
    }

    // ---------- Notatka ----------
    if root.kind == "note": Rectangle {
        if root.note == "" && !note-in.has-focus: Text {
            x: root.pad;
            y: root.pad;
            text: root.editable ? "Kliknij i pisz…" : "Pusta notatka";
            font-size: 13px;
            color: Theme.faint;
        }
        note-in := TextInput {
            x: root.pad;
            y: root.pad;
            width: root.width - 2 * root.pad;
            height: root.height - 2 * root.pad;
            text: root.note;
            enabled: root.editable;
            read-only: !root.editable;
            single-line: false;
            wrap: word-wrap;
            font-size: 13px;
            color: Theme.text;
            edited => {
                root.note-edited(self.text);
            }
        }
    }
}
