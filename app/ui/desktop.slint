import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon } from "components.slint";
import { MenuPopup, MenuEntry } from "menu.slint";

/// Ikona na pulpicie (plik lub folder z Pulpitu użytkownika albo publicznego).
export struct DeskIcon {
    name: string,
    path: string,
    img: image,
    has-img: bool,
    dir: bool,
    /// Miejsce w siatce (kolumna, wiersz) – ręczne albo wyliczone w desktop.rs.
    col: int,
    row: int,
    /// Lewy górny róg w oknie: z siatki albo dowolny (pulpit bez wyrównania do siatki).
    x: length,
    y: length,
    sel: bool,
    /// Pole zmiany nazwy zamiast podpisu.
    renaming: bool,
}

/// Pulpit na jednym monitorze (desktop.rs): tapeta z ustawień Windows i ikony w siatce.
/// Zaznaczanie kliknięciem, z Ctrl i Shift oraz ramką; przeciąganie przenosi zaznaczone
/// ikony na inne miejsca; menu w stylu PowerDesk. Okno jest dzieckiem Progman (desktop.rs).
import { WidgetBody, WidgetItem } from "widgets.slint";

export component DesktopWindow inherits Window {
    no-frame: true;
    title: "PowerDesk – pulpit";
    background: root.bg;

    in property <image> wallpaper;
    in property <bool> has-wallpaper;
    /// 0 – wypełnij, 1 – dopasuj, 2 – rozciągnij, 3 – wyśrodkuj, 4 – sąsiadująco.
    in property <int> fit;
    in property <color> bg: #000000;
    in property <[DeskIcon]> icons;
    /// Widżety na tym monitorze (miejsce i rozmiar wolne, przesuwane i zmieniane myszą).
    in property <[WidgetItem]> widgets;
    callback widget-moved(int, length, length);
    callback widget-resized(int, length, length);
    callback widget-context(int, length, length);
    callback widget-note(int, string);

    // Menu (MenuPopup jak w głównym oknie) – pozycje i miejsce podaje desktop.rs.
    in property <[MenuEntry]> menu-entries;
    in property <length> menu-x;
    in property <length> menu-y;
    in property <length> menu-width: 240px;

    callback open(int);
    /// Klik na ikonie (-1 – w puste miejsce) z klawiszami Ctrl i Shift.
    callback select(int, bool, bool);
    /// Koniec zaznaczania ramką: lewy górny róg, rozmiar, Ctrl (dodaje do zaznaczenia).
    callback band-done(length, length, length, length, bool);
    /// Prawy przycisk na ikonie (-1 – na pustym miejscu).
    callback context(int, length, length);
    /// Upuszczenie przeciąganych ikon – przesunięcie od miejsca startu.
    callback dropped(length, length);
    callback key(string, bool, bool);
    callback rename-done(int, string);
    callback rename-cancel();
    callback menu-chosen(int);
    callback refresh();

    /// Pole ikony i jej rozmiar – z ustawień (małe, średnie, duże ikony pulpitu).
    in property <length> cell-w: 84px;
    in property <length> cell-h: 96px;
    in property <length> icon-size: 48px;
    out property <length> margin: 8px;

    // Przeciąganie ikon.
    property <bool> dragging;
    property <bool> just-dragged;
    property <length> drag-dx;
    property <length> drag-dy;
    property <bool> click-ctrl;
    property <bool> click-shift;
    // Ramka zaznaczania.
    property <bool> banding;
    property <bool> band-ctrl;
    property <length> band-x0;
    property <length> band-y0;
    property <length> band-x1;
    property <length> band-y1;
    property <length> bl: min(root.band-x0, root.band-x1);
    property <length> bt: min(root.band-y0, root.band-y1);
    property <length> br: max(root.band-x0, root.band-x1);
    property <length> bb: max(root.band-y0, root.band-y1);

    public function show-menu() {
        menu.show();
    }

    if root.has-wallpaper: Image {
        width: parent.width;
        height: parent.height;
        source: root.wallpaper;
        image-fit: root.fit == 1 ? contain : root.fit == 2 ? fill : root.fit == 3 ? preserve : cover;
        horizontal-tiling: root.fit == 4 ? repeat : none;
        vertical-tiling: root.fit == 4 ? repeat : none;
    }

    // Puste miejsce: klik zdejmuje zaznaczenie, przeciąganie rysuje ramkę, prawy – menu pulpitu.
    bg-ta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.band-x0 = self.mouse-x;
                root.band-y0 = self.mouse-y;
                root.band-x1 = self.mouse-x;
                root.band-y1 = self.mouse-y;
                root.band-ctrl = e.modifiers.control;
                fs.focus();
            }
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                if (root.banding) {
                    root.banding = false;
                    root.band-done(root.bl, root.bt, root.br - root.bl, root.bb - root.bt, root.band-ctrl);
                } else if (!e.modifiers.control) {
                    root.select(-1, false, false);
                }
            }
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                root.context(-1, self.mouse-x, self.mouse-y);
            }
        }
        moved => {
            if (self.pressed) {
                root.band-x1 = self.mouse-x;
                root.band-y1 = self.mouse-y;
                if (abs(root.band-x1 - root.band-x0) > 4px || abs(root.band-y1 - root.band-y0) > 4px) {
                    root.banding = true;
                }
            }
        }
    }

    for it[i] in root.icons: Rectangle {
        property <bool> moving: root.dragging && it.sel;
        property <length> ix: it.x;
        property <length> iy: it.y;
        // Ikona w ramce zaznaczania – podświetlona na bieżąco.
        property <bool> in-band: root.banding && self.ix < root.br && self.ix + root.cell-w > root.bl && self.iy < root.bb && self.iy + root.cell-h > root.bt;
        x: self.ix + (self.moving ? root.drag-dx : 0);
        y: self.iy + (self.moving ? root.drag-dy : 0);
        width: root.cell-w - 4px;
        height: root.cell-h - 4px;
        opacity: self.moving ? 0.7 : 1;
        border-radius: Theme.r-s;
        background: it.sel || self.in-band ? #ffffff40 : ic-ta.has-hover ? #ffffff22 : transparent;
        border-width: it.sel ? 1px : 0;
        border-color: #ffffff66;

        ic-ta := TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.just-dragged = false;
                    root.click-ctrl = e.modifiers.control;
                    root.click-shift = e.modifiers.shift;
                    fs.focus();
                }
                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left && root.dragging) {
                    root.dragging = false;
                    root.just-dragged = true;
                    root.dropped(root.drag-dx, root.drag-dy);
                    root.drag-dx = 0;
                    root.drag-dy = 0;
                }
                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                    if (!it.sel) {
                        root.select(i, false, false);
                    }
                    root.context(i, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
            moved => {
                if (self.pressed && !it.renaming) {
                    if (!root.dragging && (abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px)) {
                        // Przeciągamy zaznaczenie; ikona spoza niego zaznacza się sama.
                        if (!it.sel) {
                            root.select(i, false, false);
                        }
                        root.dragging = true;
                    }
                    if (root.dragging) {
                        root.drag-dx = self.mouse-x - self.pressed-x;
                        root.drag-dy = self.mouse-y - self.pressed-y;
                    }
                }
            }
            clicked => {
                if (root.just-dragged) {
                    root.just-dragged = false;
                } else {
                    root.select(i, root.click-ctrl, root.click-shift);
                }
            }
            double-clicked => {
                root.open(i);
            }
        }

        VerticalLayout {
            padding: 4px;
            spacing: 4px;
            alignment: start;
            Rectangle {
                height: root.icon-size;
                if it.has-img: Image {
                    width: root.icon-size;
                    height: root.icon-size;
                    source: it.img;
                    image-fit: contain;
                }
                if !it.has-img: Icon {
                    commands: it.path == "::{20D04FE0-3AEA-1069-A2D8-08002B30309D}" ? Icons.pc : it.dir ? Icons.folder : Icons.file;
                    size: root.icon-size * 0.84;
                    color: #ffffff;
                }
            }
            // Podpis z miękkim cieniem jak na pulpicie Windows 10/11 – obrys liter wyglądał
            // na jasnych tapetach jak w Windows XP (postrzępione krawędzie).
            if !it.renaming: Rectangle {
                height: it.sel ? lbl.preferred-height : min(lbl.preferred-height, 32px);
                Text {
                    x: 0px;
                    y: 1px;
                    width: parent.width;
                    height: parent.height;
                    text: it.name;
                    color: #00000090;
                    font-size: 12px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    overflow: elide;
                }
                Text {
                    x: 1px;
                    y: 1px;
                    width: parent.width;
                    height: parent.height;
                    text: it.name;
                    color: #00000060;
                    font-size: 12px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    overflow: elide;
                }
                lbl := Text {
                    width: parent.width;
                    height: parent.height;
                    text: it.name;
                    color: #ffffff;
                    font-size: 12px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }
            // Zmiana nazwy w miejscu podpisu (F2 albo z menu).
            if it.renaming: Rectangle {
                height: 24px;
                border-radius: Theme.r-xs;
                background: Theme.popup-high;
                border-width: 1px;
                border-color: Theme.accent;
                ed := TextInput {
                    x: 4px;
                    width: parent.width - 8px;
                    text: it.name;
                    font-size: 12px;
                    color: Theme.text;
                    vertical-alignment: center;
                    single-line: true;
                    selection-background-color: Theme.sel-strong;
                    init => {
                        self.focus();
                        self.select-all();
                    }
                    accepted => {
                        root.rename-done(i, self.text);
                    }
                    key-pressed(e) => {
                        if (e.text == Key.Escape) {
                            root.rename-cancel();
                            return accept;
                        }
                        reject
                    }
                }
            }
        }
    }

    // Widżety: nad ikonami. Przeciąganie za cały widżet (notatka – za górny pasek),
    // zmiana rozmiaru – prawy dolny róg; położenie zapisuje desktop.rs po puszczeniu.
    for wd[i] in root.widgets: wbox := Rectangle {
        property <length> dx;
        property <length> dy;
        property <length> dw;
        property <length> dh;
        x: wd.x + self.dx;
        y: wd.y + self.dy;
        width: max(120px, wd.w + self.dw);
        height: max(80px, wd.h + self.dh);
        drop-shadow-blur: 18px;
        drop-shadow-color: #00000055;
        border-radius: Theme.r;
        // Notatka i multimedia mają w środku pole albo przyciski – chwyta się je za górny pasek.
        property <bool> grab-bar: wd.kind == "note" || wd.kind == "media" || wd.kind == "todo" || wd.kind == "clipboard";
        mv-ta := TouchArea {
            height: parent.grab-bar ? 22px : parent.height;
            y: 0;
            mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.default;
            moved => {
                if (self.pressed) {
                    parent.dx += self.mouse-x - self.pressed-x;
                    parent.dy += self.mouse-y - self.pressed-y;
                }
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left && (parent.dx != 0 || parent.dy != 0)) {
                    root.widget-moved(i, wd.x + parent.dx, wd.y + parent.dy);
                    parent.dx = 0;
                    parent.dy = 0;
                }
                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                    root.widget-context(i, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
        WidgetBody {
            width: parent.width;
            height: parent.height;
            kind: wd.kind;
            note: wd.note;
            // Poza notatką treść nie łapie myszy – przeciąganie działa w całym widżecie.
            note-edited(txt) => {
                root.widget-note(i, txt);
            }
        }
        if !wbox.grab-bar: TouchArea {
            mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.default;
            moved => {
                if (self.pressed) {
                    parent.dx += self.mouse-x - self.pressed-x;
                    parent.dy += self.mouse-y - self.pressed-y;
                }
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left && (parent.dx != 0 || parent.dy != 0)) {
                    root.widget-moved(i, wd.x + parent.dx, wd.y + parent.dy);
                    parent.dx = 0;
                    parent.dy = 0;
                }
                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                    root.widget-context(i, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
        // Pasek do chwytania notatki – widoczny pod kursorem.
        if wbox.grab-bar: Rectangle {
            y: 0;
            height: 22px;
            border-radius: Theme.r;
            background: mv-ta.has-hover ? #ffffff14 : transparent;
            Rectangle {
                y: 9px;
                width: 28px;
                height: 4px;
                border-radius: 2px;
                background: mv-ta.has-hover ? Theme.dim : transparent;
            }
        }
        // Uchwyt rozmiaru.
        Rectangle {
            x: parent.width - 16px;
            y: parent.height - 16px;
            width: 16px;
            height: 16px;
            rs-ta := TouchArea {
                mouse-cursor: MouseCursor.nwse-resize;
                moved => {
                    if (self.pressed) {
                        wbox.dw += self.mouse-x - self.pressed-x;
                        wbox.dh += self.mouse-y - self.pressed-y;
                    }
                }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                        root.widget-resized(i, max(120px, wd.w + wbox.dw), max(80px, wd.h + wbox.dh));
                        wbox.dw = 0;
                        wbox.dh = 0;
                    }
                }
            }
            Path {
                width: 10px;
                height: 10px;
                x: 3px;
                y: 3px;
                commands: "M 10 0 L 0 10 M 10 5 L 5 10";
                stroke: rs-ta.has-hover ? Theme.text : Theme.faint;
                stroke-width: 1.2px;
                viewbox-width: 10;
                viewbox-height: 10;
            }
        }
    }

    // Ramka zaznaczania.
    if root.banding: Rectangle {
        x: root.bl;
        y: root.bt;
        width: root.br - root.bl;
        height: root.bb - root.bt;
        background: Theme.accent.with-alpha(0.18);
        border-width: 1px;
        border-color: Theme.accent;
    }

    menu := MenuPopup {
        x: root.menu-x;
        y: root.menu-y;
        menu-width: root.menu-width;
        entries: root.menu-entries;
        chosen(i) => {
            root.menu-chosen(i);
        }
    }

    fs := FocusScope {
        width: 0;
        height: 0;
        key-pressed(e) => {
            if (e.text == Key.F5) {
                root.refresh();
                return accept;
            }
            // Reszta (Enter, Del, F2, Ctrl+A/C/X/V) – w desktop.rs.
            root.key(e.text, e.modifiers.control, e.modifiers.shift);
            accept
        }
    }

    init => {
        fs.focus();
    }
}
