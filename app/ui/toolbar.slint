import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, IconButton, Label, TipArea } from "components.slint";

export struct Crumb {
    name: string,
    path: string,
}

/// Przycisk filtra kategorii (fchip): `id` to indeks KindFilter::ALL.
export struct FilterChip {
    id: int,
    tip: string,
    icon: string,
    on: bool,
}

/// Element paska faset: 0 – nazwa grupy, 1 – filtr, 2 – „Wyczyść filtry”, 3 – liczba wyników.
export struct FacetChip {
    kind: int,
    tip: string,
    id: string,
    label: string,
    count: string,
    on: bool,
}

/// Wiersz paska faset – Rust układa filtry w wiersze według szerokości (zawijanie jak flex-wrap).
export struct FacetRow {
    items: [FacetChip],
}

/// Pasek narzędzi (Toolbar.svelte): nawigacja, okruszki z podfolderami, filtr/wyszukiwanie,
/// polecenia, sortowanie, wielkość miniatur i przełącznik widoków.
export component Toolbar inherits Rectangle {
    in property <[Crumb]> crumbs;
    in property <string> path;
    in property <image> folder-icon;
    in property <bool> special;
    in property <bool> can-back;
    in property <bool> can-forward;
    in property <bool> has-selection;
    in property <bool> searching;
    in property <bool> search-active;
    in property <string> sort-label;
    in property <[FilterChip]> filters;
    /// Przycisk „więcej filtrów”: są fasety, pasek otwarty, liczba wybranych.
    in property <bool> has-facets;
    in property <bool> facets-open;
    in property <int> facets-chosen;
    in property <bool> can-save-search;
    out property <bool> search-focused: search-input.has-focus;
    out property <length> search-right: sbox.absolute-position.x + sbox.width;
    out property <length> search-bottom: sbox.absolute-position.y + sbox.height;
    in property <int> view;
    in-out property <float> zoom;
    in property <float> zoom-min: 84;
    in property <float> zoom-max: 280;
    in-out property <string> query;

    callback back;
    callback forward;
    callback up;
    callback refresh;
    callback navigate(string);
    callback crumb-menu(string, length, length);
    callback filter-changed(string);
    callback search(string);
    callback clear-search;
    callback sort-menu(length, length);
    callback set-view(int);
    callback zoom-changed(float);
    callback new-menu(length, length);
    callback command(string);
    callback set-kind(int);
    callback toggle-facets;
    callback toggle-facet(string);
    callback clear-facets;
    callback save-search;

    property <bool> editing;

    public function edit-address() {
        editing = true;
        addr.text = root.path;
        addr.focus();
        addr.select-all();
    }
    public function focus-search() {
        search-input.focus();
        search-input.select-all();
    }

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 6px;
        spacing: 6px;

        // Wiersz nawigacji.
        HorizontalLayout {
            height: 36px;
            spacing: 2px;
            IconButton {
                y: 3px;
                icon: Icons.back;
                tooltip: "Wstecz (Alt+←)";
                icon-size: 18px;
                enabled: root.can-back;
                clicked => {
                    root.back();
                }
            }
            IconButton {
                y: 3px;
                icon: Icons.fwd;
                tooltip: "Dalej (Alt+→)";
                icon-size: 18px;
                enabled: root.can-forward;
                clicked => {
                    root.forward();
                }
            }
            IconButton {
                y: 3px;
                icon: Icons.up;
                tooltip: "W górę (Alt+↑)";
                icon-size: 18px;
                enabled: !root.special;
                clicked => {
                    root.up();
                }
            }
            IconButton {
                y: 3px;
                icon: Icons.refresh;
                tooltip: "Odśwież (F5)";
                icon-size: 17px;
                clicked => {
                    root.refresh();
                }
            }
            Rectangle {
                width: 6px;
            }

            // Pasek adresu: okruszki albo pole edycji.
            Rectangle {
                horizontal-stretch: 1;
                border-radius: Theme.r;
                background: root.editing ? Theme.higher : Theme.high;
                clip: true;

                if !root.editing: TipArea {
                    tip: "Kliknij, aby wpisać ścieżkę (Ctrl+L)";
                    clicked => {
                        root.edit-address();
                    }
                }
                if !root.editing: HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: start;
                    Image {
                        y: (parent.height - 16px) / 2;
                        width: 16px;
                        height: 16px;
                        source: root.folder-icon;
                    }
                    Rectangle {
                        width: 4px;
                    }
                    for c[i] in root.crumbs: HorizontalLayout {
                        Rectangle {
                            y: 4px;
                            height: 28px;
                            width: crumb-text.preferred-width + 16px;
                            border-radius: Theme.r-s;
                            background: crumb-ta.has-hover ? Theme.press : transparent;
                            crumb-text := Label {
                                x: 8px;
                                width: min(self.preferred-width, 260px);
                                text: c.name;
                                color: i == root.crumbs.length - 1 || crumb-ta.has-hover ? Theme.text : Theme.dim;
                                font-weight: i == root.crumbs.length - 1 ? 600 : 400;
                            }
                            crumb-ta := TipArea {
                                tip: c.path;
                                clicked => {
                                    root.navigate(c.path);
                                }
                            }
                        }
                        if i < root.crumbs.length - 1: Rectangle {
                            y: 5px;
                            width: 18px;
                            height: 26px;
                            border-radius: Theme.r-xs;
                            background: sep-ta.has-hover ? Theme.press : transparent;
                            Icon {
                                commands: Icons.chevron;
                                size: 13px;
                                color: sep-ta.has-hover ? Theme.text : Theme.faint;
                            }
                            sep-ta := TipArea {
                                tip: "Podfoldery";
                                clicked => {
                                    root.crumb-menu(c.path, self.absolute-position.x, self.absolute-position.y + 30px);
                                }
                            }
                        }
                    }
                }
                addr := TextInput {
                    visible: root.editing;
                    x: 14px;
                    width: parent.width - 28px;
                    color: Theme.text;
                    font-family: Theme.font;
                    font-size: Theme.font-size;
                    vertical-alignment: center;
                    single-line: true;
                    selection-background-color: Theme.sel-strong;
                    accepted => {
                        root.editing = false;
                        root.navigate(self.text);
                    }
                    key-pressed(e) => {
                        if (e.text == Key.Escape) {
                            root.editing = false;
                            return accept;
                        }
                        reject
                    }
                    changed has-focus => {
                        if (!self.has-focus) {
                            root.editing = false;
                        }
                    }
                }
            }
            Rectangle {
                width: 6px;
            }

            // Filtr / wyszukiwanie.
            sbox := Rectangle {
                width: search-input.has-focus || root.search-active ? 380px : 300px;
                animate width { duration: 200ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                border-radius: Theme.r;
                background: search-input.has-focus || root.search-active ? Theme.higher : Theme.high;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 8px;
                    spacing: 8px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        commands: Icons.search;
                        size: 16px;
                        color: search-input.has-focus || root.search-active ? Theme.text : Theme.faint;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        search-input := TextInput {
                            width: 100%;
                            text <=> root.query;
                            enabled: !root.special;
                            color: Theme.text;
                            font-family: Theme.font;
                            font-size: Theme.font-size;
                            vertical-alignment: center;
                            single-line: true;
                            selection-background-color: Theme.sel-strong;
                            edited => {
                                root.filter-changed(self.text);
                            }
                            accepted => {
                                if (self.text != "") {
                                    root.search(self.text);
                                }
                            }
                            key-pressed(e) => {
                                if (e.text == Key.Escape) {
                                    root.query = "";
                                    root.clear-search();
                                    return accept;
                                }
                                reject
                            }
                        }
                        Label {
                            visible: root.query == "";
                            text: root.special ? "Szukaj…" : "Filtruj · Enter: szukaj w podfolderach";
                            color: Theme.faint;
                        }
                    }
                    if root.can-save-search: IconButton {
                        y: (parent.height - self.height) / 2;
                        size: 24px;
                        icon: Icons.star;
                        tooltip: "Zapisz wyszukiwanie w panelu bocznym";
                        icon-size: 14px;
                        clicked => {
                            root.save-search();
                        }
                    }
                    if root.searching: Rectangle {
                        y: (parent.height - 6px) / 2;
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.accent;
                    }
                    if root.query != "" || root.search-active: IconButton {
                        y: (parent.height - self.height) / 2;
                        size: 24px;
                        icon: Icons.close;
                        tooltip: "Wyczyść (Esc)";
                        icon-size: 13px;
                        clicked => {
                            root.query = "";
                            root.clear-search();
                        }
                    }
                }
            }
        }

        // Wiersz poleceń.
        if !root.special: HorizontalLayout {
            height: 34px;
            spacing: 2px;
            // Przycisk „Nowy” (btn primary sm).
            Rectangle {
                y: 2px;
                height: 30px;
                width: new-row.preferred-width + 24px;
                border-radius: Theme.r-s;
                background: new-ta.has-hover ? Theme.accent.darker(0.1) : Theme.accent;
                new-row := HorizontalLayout {
                    x: 10px;
                    spacing: 6px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        commands: Icons.plus;
                        size: 16px;
                        color: Theme.on-accent;
                    }
                    Label {
                        text: "Nowy";
                        color: Theme.on-accent;
                        font-weight: 600;
                    }
                }
                new-ta := TipArea {
                    tip: "Nowy folder, plik lub dokument";
                    clicked => {
                        root.new-menu(self.absolute-position.x, self.absolute-position.y + 34px);
                    }
                }
            }
            Rectangle {
                width: 13px;
                Rectangle {
                    width: 1px;
                    height: 18px;
                    background: Theme.line;
                }
            }
            for c in [
                { id: "cut", icon: Icons.cut, sel: true, tip: "Wytnij (Ctrl+X)" },
                { id: "copy", icon: Icons.copy, sel: true, tip: "Kopiuj (Ctrl+C)" },
                { id: "paste", icon: Icons.paste, sel: false, tip: "Wklej (Ctrl+V)" },
                { id: "rename", icon: Icons.edit, sel: true, tip: "Zmień nazwę (F2)" },
                { id: "trash", icon: Icons.trash, sel: true, tip: "Do Kosza (Del)" },
                { id: "props", icon: Icons.info, sel: true, tip: "Właściwości (Alt+Enter)" },
            ]: IconButton {
                tooltip: c.tip;
                y: 2px;
                icon: c.icon;
                icon-size: 18px;
                enabled: !c.sel || root.has-selection;
                clicked => {
                    root.command(c.id);
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            // Filtry kategorii – tylko gdy w folderze są co najmniej dwie różne.
            if root.filters.length > 2 || root.has-facets: HorizontalLayout {
                spacing: 4px;
                for f in root.filters: Rectangle {
                    y: 3px;
                    width: 30px;
                    height: 28px;
                    border-radius: Theme.r-s;
                    background: f.on ? Theme.accent : chip-ta.has-hover ? Theme.hover : transparent;
                    Icon {
                        commands: f.icon;
                        size: 15px;
                        color: f.on ? Theme.on-accent : chip-ta.has-hover ? Theme.text : Theme.faint;
                    }
                    chip-ta := TipArea {
                        tip: f.tip;
                        clicked => {
                            root.set-kind(f.id);
                        }
                    }
                }
                // Filtry dopasowane do zawartości (fchip more).
                if root.has-facets: Rectangle {
                    y: 3px;
                    height: 28px;
                    width: max(30px, more-row.preferred-width + 12px);
                    border-radius: Theme.r-s;
                    background: root.facets-open ? Theme.accent : root.facets-chosen > 0 ? Theme.sel : more-ta.has-hover ? Theme.hover : transparent;
                    more-row := HorizontalLayout {
                        alignment: center;
                        spacing: 4px;
                        Icon {
                            y: (parent.height - self.height) / 2;
                            commands: Icons.sort;
                            size: 15px;
                            color: root.facets-open ? Theme.on-accent : root.facets-chosen > 0 || more-ta.has-hover ? Theme.text : Theme.faint;
                        }
                        if root.facets-chosen > 0: Label {
                            text: root.facets-chosen;
                            font-size: 11px;
                            font-weight: 600;
                            color: root.facets-open ? Theme.on-accent : Theme.text;
                        }
                    }
                    more-ta := TipArea {
                        tip: "Filtry dopasowane do zawartości";
                        clicked => {
                            root.toggle-facets();
                        }
                    }
                }
            }
            // Sortowanie (btn ghost sm).
            Rectangle {
                y: 2px;
                height: 30px;
                width: sort-row.preferred-width + 20px;
                border-radius: Theme.r-s;
                background: sort-ta.has-hover ? Theme.hover : transparent;
                sort-row := HorizontalLayout {
                    x: 10px;
                    spacing: 6px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        commands: Icons.sort;
                        size: 16px;
                        color: Theme.dim;
                    }
                    Label {
                        text: root.sort-label;
                        color: Theme.dim;
                    }
                }
                sort-ta := TipArea {
                    tip: "Sortowanie i grupowanie";
                    clicked => {
                        root.sort-menu(self.absolute-position.x, self.absolute-position.y + 34px);
                    }
                }
            }
            // Wielkość miniatur.
            if root.view != 0: Rectangle {
                width: 110px;
                Rectangle {
                    x: 8px;
                    y: (parent.height - 4px) / 2;
                    width: parent.width - 16px;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.line-strong;
                    Rectangle {
                        x: 0;
                        width: parent.width * (root.zoom - root.zoom-min) / (root.zoom-max - root.zoom-min);
                        border-radius: 2px;
                        background: Theme.dim;
                    }
                }
                Rectangle {
                    x: 8px + (parent.width - 16px) * (root.zoom - root.zoom-min) / (root.zoom-max - root.zoom-min) - 7px;
                    y: (parent.height - 14px) / 2;
                    width: 14px;
                    height: 14px;
                    border-radius: 7px;
                    background: Theme.text;
                }
                TipArea {
                    tip: "Wielkość miniatur (Ctrl+kółko)";
                    moved => {
                        if (self.pressed) {
                            root.zoom = clamp(root.zoom-min + (self.mouse-x - 8px) / (self.width - 16px) * (root.zoom-max - root.zoom-min), root.zoom-min, root.zoom-max);
                            root.zoom-changed(root.zoom);
                        }
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            root.zoom = clamp(root.zoom-min + (self.mouse-x - 8px) / (self.width - 16px) * (root.zoom-max - root.zoom-min), root.zoom-min, root.zoom-max);
                            root.zoom-changed(root.zoom);
                        }
                    }
                }
            }
            // Przełącznik widoków (seg).
            Rectangle {
                y: 2px;
                height: 30px;
                width: 3 * 30px + 4px;
                border-radius: Theme.r-s;
                background: Theme.high;
                HorizontalLayout {
                    padding: 2px;
                    for v[i] in [
                        { icon: Icons.list, size: 17px },
                        { icon: Icons.grid, size: 16px },
                        { icon: Icons.gallery, size: 16px },
                    ]: Rectangle {
                        width: 30px;
                        border-radius: Theme.r-xs;
                        background: root.view == i ? Theme.higher : seg-ta.has-hover ? Theme.hover : transparent;
                        Icon {
                            commands: v.icon;
                            size: v.size;
                            color: root.view == i ? Theme.text : Theme.dim;
                        }
                        seg-ta := TipArea {
                            tip: i == 0 ? "Lista (Ctrl+1)" : i == 1 ? "Siatka (Ctrl+2)" : "Galeria (Ctrl+3)";
                            clicked => {
                                root.set-view(i);
                            }
                        }
                    }
                }
            }
        }
    }
}

/// Panel faset (facets) – wysuwa się nad listą zamiast rozpychać pasek narzędzi.
export component FacetPanel inherits Rectangle {
    in property <[FacetRow]> facet-rows;
    callback toggle-facet(string);
    callback clear-facets;
    height: rows.preferred-height;
    border-radius: Theme.r-l;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-blur: 50px;
    drop-shadow-offset-y: 20px;
    drop-shadow-color: Theme.shadow;
    TouchArea { }
    rows := VerticalLayout {
        padding: 12px;
        spacing: 5px;
        for row in root.facet-rows: HorizontalLayout {
            height: 26px;
            spacing: 5px;
            alignment: start;
            for c in row.items: Rectangle {
                // Szerokość z niewidocznych miar (elementów w `if` nie można mierzyć z zewnątrz).
                m-label := Label {
                    visible: false;
                    text: c.label;
                    font-size: c.kind == 0 ? 11px : 12px;
                    font-weight: c.kind == 0 || c.on ? 600 : 400;
                }
                m-count := Label {
                    visible: false;
                    text: c.count;
                    font-size: 11px;
                }
                width: c.kind == 0 ? m-label.preferred-width + 10px : c.kind == 3 ? m-label.preferred-width + 4px : c.kind == 2 ? m-label.preferred-width + 12px + 6px + 22px : m-label.preferred-width + 6px + m-count.preferred-width + 22px;
                border-radius: Theme.r-s;
                border-width: c.kind == 2 ? 1px : 0;
                border-color: Theme.line-strong;
                background: c.kind == 0 || c.kind == 3 ? transparent : c.on ? Theme.accent : fc-ta.has-hover ? Theme.press : c.kind == 2 ? transparent : Theme.card;
                if c.kind == 0: Label {
                    x: 6px;
                    text: c.label;
                    font-size: 11px;
                    font-weight: 600;
                    letter-spacing: 0.44px;
                    color: Theme.ghost;
                }
                if c.kind == 3: Label {
                    x: 4px;
                    text: c.label;
                    font-size: 12px;
                    color: Theme.faint;
                }
                if c.kind == 1 || c.kind == 2: HorizontalLayout {
                    x: 11px;
                    spacing: 6px;
                    if c.kind == 2: Icon {
                        y: (parent.height - self.height) / 2;
                        commands: Icons.close;
                        size: 12px;
                        color: fc-ta.has-hover ? Theme.text : Theme.dim;
                    }
                    Label {
                        text: c.label;
                        font-size: 12px;
                        font-weight: c.on ? 600 : 400;
                        color: c.on ? Theme.on-accent : fc-ta.has-hover ? Theme.text : Theme.dim;
                    }
                    if c.kind == 1: Label {
                        text: c.count;
                        font-size: 11px;
                        color: c.on ? Theme.on-accent : Theme.dim;
                        opacity: 0.55;
                    }
                }
                fc-ta := TipArea {
                    tip: c.tip;
                    enabled: c.kind == 1 || c.kind == 2;
                    clicked => {
                        if (c.kind == 1) {
                            root.toggle-facet(c.id);
                        } else {
                            root.clear-facets();
                        }
                    }
                }
            }
        }
    }
}
