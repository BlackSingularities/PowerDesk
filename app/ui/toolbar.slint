import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, IconButton, Label, TipArea, Drag } from "components.slint";

export struct Crumb {
    name: string,
    path: string,
}

/// Element paska faset: 0 – nazwa grupy, 1 – filtr, 2 – „Wyczyść filtry”, 3 – liczba wyników.
export struct FacetChip {
    kind: int,
    tip: string,
    id: string,
    label: string,
    count: string,
    on: bool,
}

/// Wiersz panelu filtrów – Rust układa filtry grupy w wiersze według szerokości (zawijanie jak flex-wrap).
/// `group` – nazwa grupy w pierwszym wierszu grupy, w kolejnych pusta.
export struct FacetRow {
    group: string,
    items: [FacetChip],
}

/// Pasek narzędzi (Toolbar.svelte): nawigacja, okruszki z podfolderami, filtr/wyszukiwanie,
/// polecenia, sortowanie, wielkość miniatur i przełącznik widoków.
export component Toolbar inherits Rectangle {
    in property <[Crumb]> crumbs;
    in property <string> path;
    in property <image> folder-icon;
    in property <bool> special;
    in property <bool> can-back;
    in property <bool> can-forward;
    in property <bool> searching;
    in property <bool> search-active;
    in property <string> sort-label;
    /// Opis aktywnych filtrów (rodzaj, fasety) – w pasku adresu, od prawej.
    in property <string> filter-summary;
    /// Przycisk „więcej filtrów”: są fasety, pasek otwarty, liczba wybranych.
    in property <bool> has-facets;
    in property <bool> facets-open;
    in property <int> facets-chosen;
    in property <bool> can-save-search;
    out property <bool> search-focused: search-input.has-focus;
    out property <length> search-right: sbox.absolute-position.x + sbox.width;
    out property <length> search-bottom: sbox.absolute-position.y + sbox.height;
    in property <int> view;
    /// Galeria tylko tam, gdzie przeważają zdjęcia i filmy (albo gdy jest już włączona).
    in property <bool> gallery-ok;
    /// Półka: liczba pozycji i czy panel jest otwarty.
    in property <int> shelf-count;
    in property <bool> shelf-open;
    in property <bool> preview-open;
    in-out property <float> zoom;
    in property <float> zoom-min: 84;
    in property <float> zoom-max: 280;
    in-out property <string> query;

    callback back;
    callback forward;
    callback up;
    callback refresh;
    callback navigate(string);
    callback crumb-menu(string, length, length);
    callback filter-changed(string);
    callback search(string);
    callback clear-search;
    callback sort-menu(length, length);
    callback set-view(int);
    callback zoom-changed(float);
    callback toggle-facets;
    callback toggle-shelf;
    callback toggle-preview;
    callback toggle-facet(string);
    callback clear-facets;
    callback save-search;

    property <bool> editing;

    public function edit-address() {
        editing = true;
        addr.text = root.path;
        addr.focus();
        addr.select-all();
    }
    public function focus-search() {
        search-input.focus();
        search-input.select-all();
    }

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 6px;

        // Wiersz nawigacji.
        HorizontalLayout {
            height: 36px;
            spacing: 2px;
            IconButton {
                y: 3px;
                icon: Icons.back;
                tooltip: "Wstecz (Alt+←)";
                icon-size: 18px;
                enabled: root.can-back;
                clicked => {
                    root.back();
                }
            }
            IconButton {
                y: 3px;
                icon: Icons.fwd;
                tooltip: "Dalej (Alt+→)";
                icon-size: 18px;
                enabled: root.can-forward;
                clicked => {
                    root.forward();
                }
            }
            IconButton {
                y: 3px;
                icon: Icons.up;
                tooltip: "W górę (Alt+↑)";
                icon-size: 18px;
                enabled: !root.special;
                clicked => {
                    root.up();
                }
            }
            IconButton {
                y: 3px;
                icon: Icons.refresh;
                tooltip: "Odśwież (F5)";
                icon-size: 17px;
                clicked => {
                    root.refresh();
                }
            }
            Rectangle {
                width: 6px;
            }

            // Pasek adresu: okruszki albo pole edycji.
            Rectangle {
                horizontal-stretch: 1;
                border-radius: Theme.r;
                background: root.editing ? Theme.higher : Theme.high;
                clip: true;

                if !root.editing: TipArea {
                    tip: "Kliknij, aby wpisać ścieżkę (Ctrl+L)";
                    clicked => {
                        root.edit-address();
                    }
                }
                if !root.editing: HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: start;
                    Image {
                        y: (parent.height - 16px) / 2;
                        width: 16px;
                        height: 16px;
                        source: root.folder-icon;
                    }
                    Rectangle {
                        width: 4px;
                    }
                    for c[i] in root.crumbs: HorizontalLayout {
                        Rectangle {
                            y: 4px;
                            height: 28px;
                            width: crumb-text.preferred-width + 16px;
                            border-radius: Theme.r-s;
                            background: Drag.active && Drag.target == c.path ? Theme.sel-strong : crumb-ta.has-hover ? Theme.press : transparent;
                            crumb-text := Label {
                                x: 8px;
                                width: min(self.preferred-width, 260px);
                                text: c.name;
                                color: i == root.crumbs.length - 1 || crumb-ta.has-hover ? Theme.text : Theme.dim;
                                font-weight: i == root.crumbs.length - 1 ? 600 : 400;
                            }
                            crumb-ta := TipArea {
                                tip: c.path;
                                drop: c.path;
                                clicked => {
                                    root.navigate(c.path);
                                }
                            }
                        }
                        if i < root.crumbs.length - 1: Rectangle {
                            y: 5px;
                            width: 18px;
                            height: 26px;
                            border-radius: Theme.r-xs;
                            background: sep-ta.has-hover ? Theme.press : transparent;
                            Icon {
                                commands: Icons.chevron;
                                size: 13px;
                                color: sep-ta.has-hover ? Theme.text : Theme.faint;
                            }
                            sep-ta := TipArea {
                                tip: "Podfoldery";
                                clicked => {
                                    root.crumb-menu(c.path, self.absolute-position.x, self.absolute-position.y + 30px);
                                }
                            }
                        }
                    }
                }
                // Aktywne filtry – przy prawej krawędzi paska, nad okruszkami.
                if !root.editing && root.filter-summary != "": Rectangle {
                    x: parent.width - self.width;
                    width: min(fs-row.preferred-width + 16px, parent.width * 0.5);
                    background: Theme.high;
                    fs-row := HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 4px;
                        spacing: 6px;
                        alignment: end;
                        Icon {
                            y: (parent.height - self.height) / 2;
                            commands: Icons.filter;
                            size: 13px;
                            color: Theme.dim;
                        }
                        Label {
                            horizontal-alignment: right;
                            text: root.filter-summary;
                            font-size: 12px;
                            color: Theme.text;
                        }
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 22px;
                            height: 22px;
                            border-radius: Theme.r-xs;
                            background: fs-ta.has-hover ? Theme.press : transparent;
                            Icon {
                                commands: Icons.close;
                                size: 12px;
                                color: fs-ta.has-hover ? Theme.text : Theme.dim;
                            }
                            fs-ta := TipArea {
                                tip: "Wyłącz filtry";
                                clicked => {
                                    root.clear-facets();
                                }
                            }
                        }
                    }
                    TipArea {
                        z: -1;
                        tip: "Filtry: " + root.filter-summary;
                        clicked => {
                            root.toggle-facets();
                        }
                    }
                }
                addr := TextInput {
                    visible: root.editing;
                    x: 14px;
                    width: parent.width - 28px;
                    color: Theme.text;
                    font-family: Theme.font;
                    font-size: Theme.font-size;
                    vertical-alignment: center;
                    single-line: true;
                    selection-background-color: Theme.sel-strong;
                    accepted => {
                        root.editing = false;
                        root.navigate(self.text);
                    }
                    key-pressed(e) => {
                        if (e.text == Key.Escape) {
                            root.editing = false;
                            return accept;
                        }
                        reject
                    }
                    changed has-focus => {
                        if (!self.has-focus) {
                            root.editing = false;
                        }
                    }
                }
            }
            Rectangle {
                width: 6px;
            }

            // Kontrolki widoku: filtry kategorii, fasety, sortowanie, miniatury, przełącznik widoków.
            if !root.special: HorizontalLayout {
                spacing: 2px;
                // Jeden przycisk filtrów: rodzaj plików i filtry dopasowane do zawartości są w panelu.
                if root.has-facets || root.facets-chosen > 0: Rectangle {
                    y: 2px;
                    height: 30px;
                    width: max(30px, more-row.preferred-width + 14px);
                    border-radius: Theme.r-s;
                    background: root.facets-open ? Theme.accent : root.facets-chosen > 0 ? Theme.sel : more-ta.has-hover ? Theme.hover : transparent;
                    more-row := HorizontalLayout {
                        alignment: center;
                        spacing: 4px;
                        Icon {
                            y: (parent.height - self.height) / 2;
                            commands: Icons.filter;
                            size: 15px;
                            color: root.facets-open ? Theme.on-accent : root.facets-chosen > 0 || more-ta.has-hover ? Theme.text : Theme.dim;
                        }
                        if root.facets-chosen > 0: Label {
                            text: root.facets-chosen;
                            font-size: 11px;
                            font-weight: 600;
                            color: root.facets-open ? Theme.on-accent : Theme.text;
                        }
                    }
                    more-ta := TipArea {
                        tip: "Filtry";
                        clicked => {
                            root.toggle-facets();
                        }
                    }
                }
                // Sortowanie (btn ghost sm).
                Rectangle {
                    y: 2px;
                    height: 30px;
                    width: sort-row.preferred-width + 20px;
                    border-radius: Theme.r-s;
                    background: sort-ta.has-hover ? Theme.hover : transparent;
                    sort-row := HorizontalLayout {
                        x: 10px;
                        spacing: 6px;
                        Icon {
                            y: (parent.height - self.height) / 2;
                            commands: Icons.sort;
                            size: 16px;
                            color: Theme.dim;
                        }
                        Label {
                            text: root.sort-label;
                            color: Theme.dim;
                        }
                    }
                    sort-ta := TipArea {
                        tip: "Sortowanie i grupowanie";
                        clicked => {
                            root.sort-menu(self.absolute-position.x, self.absolute-position.y + 34px);
                        }
                    }
                }
                // Wielkość miniatur.
                if root.view != 0: Rectangle {
                    width: 110px;
                    Rectangle {
                        x: 8px;
                        y: (parent.height - 4px) / 2;
                        width: parent.width - 16px;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.line-strong;
                        Rectangle {
                            x: 0;
                            width: parent.width * (root.zoom - root.zoom-min) / (root.zoom-max - root.zoom-min);
                            border-radius: 2px;
                            background: Theme.dim;
                        }
                    }
                    Rectangle {
                        x: 8px + (parent.width - 16px) * (root.zoom - root.zoom-min) / (root.zoom-max - root.zoom-min) - 7px;
                        y: (parent.height - 14px) / 2;
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        background: Theme.text;
                    }
                    TipArea {
                        tip: "Wielkość miniatur (Ctrl+kółko)";
                        moved => {
                            if (self.pressed) {
                                root.zoom = clamp(root.zoom-min + (self.mouse-x - 8px) / (self.width - 16px) * (root.zoom-max - root.zoom-min), root.zoom-min, root.zoom-max);
                                root.zoom-changed(root.zoom);
                            }
                        }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                root.zoom = clamp(root.zoom-min + (self.mouse-x - 8px) / (self.width - 16px) * (root.zoom-max - root.zoom-min), root.zoom-min, root.zoom-max);
                                root.zoom-changed(root.zoom);
                            }
                        }
                    }
                }
                // Półka (schowek plików) z liczbą pozycji.
                Rectangle {
                    y: 2px;
                    width: 30px;
                    height: 30px;
                    border-radius: Theme.r-s;
                    background: root.shelf-open ? Theme.sel : shelf-ta.has-hover ? Theme.hover : transparent;
                    Icon {
                        commands: Icons.archive;
                        size: 16px;
                        color: root.shelf-open || shelf-ta.has-hover ? Theme.text : Theme.dim;
                    }
                    if root.shelf-count > 0: Rectangle {
                        x: parent.width - self.width + 2px;
                        y: -2px;
                        height: 15px;
                        width: max(15px, badge.preferred-width + 8px);
                        border-radius: 7.5px;
                        background: Theme.accent;
                        badge := Label {
                            text: root.shelf-count;
                            font-size: 10px;
                            font-weight: 600;
                            color: Theme.on-accent;
                        }
                    }
                    shelf-ta := TipArea {
                        tip: "Półka (Ctrl+Shift+S)";
                        drop: "ofp:shelf";
                        clicked => {
                            root.toggle-shelf();
                        }
                    }
                }
                // Panel podglądu.
                Rectangle {
                    y: 2px;
                    width: 30px;
                    height: 30px;
                    border-radius: Theme.r-s;
                    background: root.preview-open ? Theme.sel : pv-ta.has-hover ? Theme.hover : transparent;
                    Icon {
                        commands: Icons.panel;
                        size: 16px;
                        color: root.preview-open || pv-ta.has-hover ? Theme.text : Theme.dim;
                    }
                    pv-ta := TipArea {
                        tip: root.preview-open ? "Ukryj podgląd (Alt+P)" : "Pokaż podgląd (Alt+P)";
                        clicked => {
                            root.toggle-preview();
                        }
                    }
                }
                // Przełącznik widoków (seg).
                Rectangle {
                    y: 2px;
                    height: 30px;
                    width: (root.gallery-ok ? 3 : 2) * 30px + 4px;
                    border-radius: Theme.r-s;
                    background: Theme.high;
                    HorizontalLayout {
                        padding: 2px;
                        for v[i] in [
                            { icon: Icons.list, size: 17px },
                            { icon: Icons.grid, size: 16px },
                            { icon: Icons.gallery, size: 16px },
                        ]: Rectangle {
                            visible: i < 2 || root.gallery-ok;
                            width: 30px;
                            border-radius: Theme.r-xs;
                            background: root.view == i ? Theme.higher : seg-ta.has-hover ? Theme.hover : transparent;
                            Icon {
                                commands: v.icon;
                                size: v.size;
                                color: root.view == i ? Theme.text : Theme.dim;
                            }
                            seg-ta := TipArea {
                                tip: i == 0 ? "Lista (Ctrl+1)" : i == 1 ? "Siatka (Ctrl+2)" : "Galeria (Ctrl+3)";
                                clicked => {
                                    root.set-view(i);
                                }
                            }
                        }
                    }
                }
            }
            Rectangle {
                width: 6px;
            }

            // Filtr / wyszukiwanie: wąskie pole, po kliknięciu poszerza się w lewo – nad kontrolkami, bez przesuwania.
            Rectangle {
                width: 200px;
            sbox := Rectangle {
                x: parent.width - self.width;
                width: search-input.has-focus || root.query != "" || root.search-active ? 380px : 200px;
                animate width { duration: 200ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                border-radius: Theme.r;
                background: search-input.has-focus || root.search-active ? Theme.higher : Theme.high;
                drop-shadow-blur: search-input.has-focus ? 18px : 0;
                drop-shadow-color: Theme.shadow;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 8px;
                    spacing: 8px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        commands: Icons.search;
                        size: 16px;
                        color: search-input.has-focus || root.search-active ? Theme.text : Theme.faint;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        search-input := TextInput {
                            width: 100%;
                            text <=> root.query;
                            enabled: !root.special;
                            color: Theme.text;
                            font-family: Theme.font;
                            font-size: Theme.font-size;
                            vertical-alignment: center;
                            single-line: true;
                            selection-background-color: Theme.sel-strong;
                            edited => {
                                root.filter-changed(self.text);
                            }
                            accepted => {
                                if (self.text != "") {
                                    root.search(self.text);
                                }
                            }
                            key-pressed(e) => {
                                if (e.text == Key.Escape) {
                                    root.query = "";
                                    root.clear-search();
                                    return accept;
                                }
                                reject
                            }
                        }
                        Label {
                            x: 0;
                            width: parent.width;
                            visible: root.query == "";
                            text: root.special ? "Szukaj…" : "Filtruj · Enter: szukaj w podfolderach";
                            color: Theme.faint;
                        }
                    }
                    if root.can-save-search: IconButton {
                        y: (parent.height - self.height) / 2;
                        size: 24px;
                        icon: Icons.star;
                        tooltip: "Zapisz wyszukiwanie w panelu bocznym";
                        icon-size: 14px;
                        clicked => {
                            root.save-search();
                        }
                    }
                    if root.searching: Rectangle {
                        y: (parent.height - 6px) / 2;
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.accent;
                    }
                    if root.query != "" || root.search-active: IconButton {
                        y: (parent.height - self.height) / 2;
                        size: 24px;
                        icon: Icons.close;
                        tooltip: "Wyczyść (Esc)";
                        icon-size: 13px;
                        clicked => {
                            root.query = "";
                            root.clear-search();
                        }
                    }
                }
            }
            }
        }
    }
}

/// Panel filtrów – wysuwa się nad listą zamiast rozpychać pasek narzędzi. Każda grupa od nowego
/// wiersza z nazwą w kolumnie po lewej; na dole liczba wyników i „Wyczyść filtry”, gdy coś wybrano.
export component FacetPanel inherits Rectangle {
    in property <[FacetRow]> facet-rows;
    in property <string> results;
    callback toggle-facet(string);
    callback clear-facets;
    height: box.preferred-height;
    border-radius: Theme.r-l;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-blur: 50px;
    drop-shadow-offset-y: 20px;
    drop-shadow-color: Theme.shadow;
    TouchArea { }
    box := VerticalLayout {
        padding: 14px;
        padding-top: 12px;
        spacing: 6px;
        for row[r] in root.facet-rows: HorizontalLayout {
            spacing: 8px;
            padding-top: row.group != "" && r > 0 ? 6px : 0;
            Label {
                width: 76px;
                height: 28px;
                text: row.group;
                font-size: 12px;
                color: Theme.dim;
            }
            HorizontalLayout {
                spacing: 5px;
                alignment: start;
                for c in row.items: Rectangle {
                    height: 28px;
                    width: chip.preferred-width;
                    border-radius: Theme.r-s;
                    background: c.on ? Theme.accent : fc-ta.has-hover ? Theme.press : Theme.card;
                    chip := HorizontalLayout {
                        padding-left: 11px;
                        padding-right: 11px;
                        spacing: 7px;
                        Label {
                            text: c.label;
                            font-size: 12px;
                            font-weight: c.on ? 600 : 400;
                            color: c.on ? Theme.on-accent : Theme.text;
                        }
                        Label {
                            text: c.count;
                            font-size: 11px;
                            color: c.on ? Theme.on-accent : Theme.faint;
                        }
                    }
                    fc-ta := TipArea {
                        tip: c.tip;
                        clicked => {
                            root.toggle-facet(c.id);
                        }
                    }
                }
            }
        }
        if root.results != "": Rectangle {
            height: 1px;
            background: Theme.line;
        }
        if root.results != "": HorizontalLayout {
            padding-top: 2px;
            Label {
                text: root.results;
                font-size: 12px;
                color: Theme.dim;
            }
            Rectangle {
                height: 28px;
                width: clr-row.preferred-width;
                border-radius: Theme.r-s;
                background: clr-ta.has-hover ? Theme.press : transparent;
                clr-row := HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        commands: Icons.close;
                        size: 12px;
                        color: clr-ta.has-hover ? Theme.text : Theme.dim;
                    }
                    Label {
                        text: "Wyczyść filtry";
                        font-size: 12px;
                        color: clr-ta.has-hover ? Theme.text : Theme.dim;
                    }
                }
                clr-ta := TipArea {
                    tip: "Wyłącz wszystkie filtry";
                    clicked => {
                        root.clear-facets();
                    }
                }
            }
        }
    }
}
