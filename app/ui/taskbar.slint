import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, TipArea } from "components.slint";

/// Przycisk okna na pasku (taskbar.rs trzyma uchwyty w tej samej kolejności).
export struct TaskButton {
    title: string,
    img: image,
    has-img: bool,
    active: bool,
    minimized: bool,
}

/// Pasek zadań PowerDesk na jednym monitorze – tryb testowy: leży na wierzchu,
/// nad paskiem Windows, który dalej działa pod spodem.
export component TaskbarWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    title: "PowerDesk – pasek zadań";
    background: Theme.panel;

    in property <[TaskButton]> buttons;
    in property <string> time;
    in property <string> date;
    in property <bool> test: true;
    callback start();
    callback activate(int);
    /// Prawy przycisk na oknie – współrzędne w oknie paska.
    callback context(int, length, length);
    callback close-test();

    // Górna linia oddziela pasek od pulpitu.
    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.line;
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;

        // Start – na razie menu Start Windows.
        Rectangle {
            width: 44px;
            height: 40px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.r;
            background: st-ta.has-hover ? Theme.hover : transparent;
            Icon {
                commands: Icons.grid;
                size: 20px;
                color: Theme.accent;
            }
            st-ta := TipArea {
                tip: "Start";
                clicked => {
                    root.start();
                }
            }
        }

        // Okna programów – szerokość dzielona po równo, najwyżej 200 px na przycisk.
        Rectangle {
            horizontal-stretch: 1;
            property <length> each: root.buttons.length == 0 ? 0 : min(200px, (self.width - 4px * root.buttons.length) / root.buttons.length);
            for b[i] in root.buttons: Rectangle {
                x: i * (parent.each + 4px);
                y: (parent.height - self.height) / 2;
                width: parent.each;
                height: 40px;
                border-radius: Theme.r;
                background: b.active ? Theme.sel : tb-ta.has-hover ? Theme.hover : transparent;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    alignment: parent.width < 80px ? center : start;
                    Rectangle {
                        width: 20px;
                        if b.has-img: Image {
                            y: (parent.height - 20px) / 2;
                            width: 20px;
                            height: 20px;
                            source: b.img;
                        }
                        if !b.has-img: Icon {
                            commands: Icons.file;
                            size: 18px;
                            color: Theme.dim;
                        }
                    }
                    if parent.width >= 80px: Text {
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        text: b.title;
                        overflow: elide;
                        font-size: 12px;
                        color: b.minimized ? Theme.faint : Theme.text;
                    }
                }
                // Aktywne okno – kreska u dołu przycisku.
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - 3px;
                    width: b.active ? 18px : 8px;
                    height: 3px;
                    border-radius: 1.5px;
                    background: b.active ? Theme.accent : Theme.faint;
                    animate width { duration: 120ms; }
                }
                tb-ta := TipArea {
                    tip: b.title;
                    clicked => {
                        root.activate(i);
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                            root.context(i, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                }
            }
        }

        // Zegar i data.
        VerticalLayout {
            alignment: center;
            padding-left: 8px;
            padding-right: 8px;
            Text {
                text: root.time;
                horizontal-alignment: right;
                font-size: 12.5px;
                color: Theme.text;
            }
            Text {
                text: root.date;
                horizontal-alignment: right;
                font-size: 11px;
                color: Theme.dim;
            }
        }

        if root.test: Rectangle {
            width: 32px;
            height: 32px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.r-s;
            background: ct-ta.has-hover ? Theme.hover : transparent;
            Icon {
                commands: Icons.close;
                size: 14px;
                color: Theme.dim;
            }
            ct-ta := TipArea {
                tip: "Zamknij pasek testowy";
                clicked => {
                    root.close-test();
                }
            }
        }
    }
}
