import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, TipArea, Tip } from "components.slint";
import { MenuBody, MenuEntry } from "menu.slint";
import { Track } from "player.slint";

/// Menu paska w osobnym oknie nad kliknięciem – pasek ma 48 px, menu by się w nim nie zmieściło.
/// Wygląd jak menu w oknie PowerDesk; zamyka się po wyborze albo utracie fokusu (taskbar.rs).
export component BarMenuWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: Theme.popup-high;
    in property <[MenuEntry]> entries;
    in property <length> menu-width: 240px;
    callback chosen(int);
    /// Escape – zamknięcie bez wyboru.
    callback dismiss();
    width: root.menu-width;
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.dismiss();
                return accept;
            }
            reject
        }
        MenuBody {
            framed: false;
            entries: root.entries;
            chosen(i) => {
                root.chosen(i);
            }
        }
    }
}

/// Przycisk okna na pasku (taskbar.rs trzyma uchwyty w tej samej kolejności).
export struct TaskButton {
    title: string,
    img: image,
    has-img: bool,
    active: bool,
    minimized: bool,
    /// Okno programu woła o uwagę (miga jak w Windows).
    flash: bool,
    /// Pasek postępu programu (ITaskbarList3): 0 brak, 1 nieokreślony, 2 zwykły, 3 błąd, 4 wstrzymany.
    progress-state: int,
    /// Postęp 0..1.
    progress: float,
    /// Plakietka programu na ikonie (np. liczba wiadomości).
    badge: image,
    has-badge: bool,
    /// Okna programu pod tym przyciskiem (0 – przypięty program, który nie działa).
    count: int,
    pinned: bool,
    /// Przypiętych bez okien przed tym przyciskiem – do wyliczenia jego miejsca.
    idle-before: int,
}

/// Ikona zasobnika: 28 px szerokości, wysokość z paska; podświetlenie pod kursorem, podpowiedź.
/// `lit` – podświetlenie z zewnątrz (strzałka, nad którą wisi przeciągana ikona).
component TrayIcon inherits Rectangle {
    in property <string> icon;
    in property <string> tip;
    in property <bool> dim;
    in property <bool> lit;
    callback clicked();
    callback middle();
    /// +1 – kółko w górę, -1 – w dół.
    callback wheel(int);
    width: 28px;
    border-radius: Theme.r;
    background: root.lit ? Theme.sel : ti-ta.has-hover ? Theme.hover : transparent;
    Icon {
        commands: root.icon;
        size: 18px;
        color: root.dim ? Theme.faint : Theme.text;
    }
    @children
    ti-ta := TipArea {
        tip: root.tip;
        clicked => {
            root.clicked();
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.middle) {
                root.middle();
            }
        }
        scroll-event(e) => {
            if (e.delta-y == 0) {
                return reject;
            }
            // Jedno zdarzenie może nieść kilka ząbków (ok. 40 px na ząbek).
            root.wheel(e.delta-y > 0 ? max(1, round(e.delta-y / 40px)) : min(-1, round(e.delta-y / 40px)));
            accept
        }
    }
}

/// Ikona programu w zasobniku (tryb powłoki – własny Shell_TrayWnd, trayhost.rs).
export struct TrayApp {
    /// Klucz do kliknięć (ważny w tym uruchomieniu).
    key: string,
    /// Stały identyfikator – do zapamiętania miejsca ikony (pasek albo okienko ukrytych).
    id: string,
    img: image,
    tip: string,
}

/// Ikona programu w zasobniku: obraz od programu, kliki odsyłane do niego. Przeciągnięcie
/// (lewy przycisk, ponad 6 px) zamiast kliku – taskbar.rs sprawdza, gdzie ją puszczono.
component TrayAppIcon inherits Rectangle {
    in property <image> img;
    in property <string> tip;
    /// 0 – lewy, 1 – dwuklik, 2 – prawy (współrzędne kursora wylicza taskbar.rs).
    callback pressed(int);
    /// Puszczona po przeciągnięciu – przesunięcie w poziomie od miejsca chwycenia i x kursora w oknie.
    callback dropped(length, length);
    /// W trakcie przeciągania: x kursora w oknie (-1 – koniec przeciągania).
    callback drag-at(length);
    property <bool> dragging;
    /// Klik po przeciągnięciu się nie liczy.
    property <bool> was-drag;
    width: 24px;
    border-radius: Theme.r;
    background: ta-ta.has-hover || root.dragging ? Theme.hover : transparent;
    opacity: root.dragging ? 0.45 : 1;
    Image {
        source: root.img;
        width: 16px;
        height: 16px;
        image-rendering: smooth;
    }
    ta-ta := TipArea {
        tip: root.dragging ? "" : root.tip;
        mouse-cursor: root.dragging ? MouseCursor.grabbing : MouseCursor.default;
        clicked => {
            if (root.was-drag) {
                root.was-drag = false;
            } else {
                root.pressed(0);
            }
        }
        double-clicked => {
            root.pressed(1);
        }
        moved => {
            if (self.pressed && !root.dragging && (abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px)) {
                root.dragging = true;
            }
            if (root.dragging) {
                root.drag-at(self.absolute-position.x + self.mouse-x);
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.was-drag = false;
            }
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left && root.dragging) {
                root.dragging = false;
                root.was-drag = true;
                // Najpierw upuszczenie – strzałka musi jeszcze stać, żeby rozpoznać upuszczenie na niej.
                root.dropped(self.mouse-x - self.pressed-x, self.absolute-position.x + self.mouse-x);
                root.drag-at(-1px);
            }
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                root.pressed(2);
            }
        }
    }
}

/// Dymek podpowiedzi nad paskiem i jego okienkami – osobne okno, bo pasek ma 48 px wysokości.
/// Nie bierze fokusu ani myszy (taskbar.rs); rozmiar z `want-w` × `want-h`.
export component TipWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: Theme.higher;
    in property <string> text;
    out property <length> want-w: min(t.preferred-width, 420px) + 20px;
    out property <length> want-h: t.preferred-height + 12px;
    t := Text {
        x: 10px;
        y: 6px;
        width: parent.width - 20px;
        text: root.text;
        overflow: elide;
        font-size: 12px;
        color: Theme.text;
    }
}

/// Ukryte ikony zasobnika nad strzałką: siatka po 7, przeciągnięcie na pasek przypina ikonę,
/// przełącznik pokazuje wszystkie na pasku. Wysokość liczy taskbar.rs (te same wymiary).
export component TrayOverflowWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: Theme.popup-high;
    in property <[TrayApp]> apps;
    in property <bool> show-all;
    property <int> cols: 7;
    callback app-click(string, int);
    callback app-drop(string);
    callback set-show-all(bool);
    /// Podpowiedź pod kursorem zmieniona (tekst i punkt w oknie; pusty tekst – schować).
    callback tip(string, length, length);
    property <int> tip-serial: Tip.serial;
    property <string> tip-now: Tip.text;
    changed tip-serial => {
        root.tip(Tip.text, Tip.x, Tip.y);
    }
    changed tip-now => {
        if (self.tip-now == "") {
            root.tip("", 0, 0);
        }
    }
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        Text {
            height: 20px;
            text: "Ukryte ikony";
            font-size: 13px;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
        }
        if root.apps.length == 0: Text {
            height: 40px;
            text: "Wszystkie ikony są na pasku";
            font-size: 12px;
            color: Theme.faint;
            vertical-alignment: center;
        }
        for row[r] in ceil(root.apps.length / root.cols): HorizontalLayout {
            height: 40px;
            spacing: 4px;
            alignment: start;
            for a[i] in root.apps: TrayAppIcon {
                property <bool> here: i >= r * root.cols && i < (r + 1) * root.cols;
                visible: self.here;
                width: self.here ? 28px : 0px;
                img: a.img;
                tip: a.tip;
                pressed(b) => {
                    root.app-click(a.key, b);
                }
                dropped(dx, at) => {
                    root.app-drop(a.id);
                }
            }
        }
        Text {
            height: 14px;
            text: "Przeciągnij ikonę na pasek albo z paska tutaj";
            font-size: 10.5px;
            color: Theme.faint;
            vertical-alignment: center;
        }
        Rectangle {
            height: 30px;
            border-radius: Theme.r-s;
            background: sa-ta.has-hover ? Theme.hover : transparent;
            HorizontalLayout {
                padding-left: 6px;
                spacing: 8px;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 16px;
                    height: 16px;
                    border-radius: 4px;
                    border-width: root.show-all ? 0 : 1px;
                    border-color: Theme.dim;
                    background: root.show-all ? Theme.accent : transparent;
                    if root.show-all: Icon {
                        commands: Icons.check;
                        size: 12px;
                        color: Theme.on-accent;
                    }
                }
                Text {
                    text: "Wszystkie ikony na pasku";
                    font-size: 12px;
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }
            sa-ta := TouchArea {
                clicked => {
                    root.set-show-all(!root.show-all);
                }
            }
        }
    }
}

/// Aplikacja w mikserze głośności.
export struct AppVol {
    /// 0 – dźwięki systemowe.
    pid: int,
    name: string,
    img: image,
    has-img: bool,
    level: float,
    muted: bool,
}

/// Wiersz miksera: ikona (klik wycisza), nazwa nad suwakiem, procent.
component VolRow inherits HorizontalLayout {
    in property <string> name;
    in property <image> img;
    in property <bool> has-img;
    in property <bool> system;
    in property <float> level;
    in property <bool> muted;
    in property <bool> main;
    callback set(float);
    callback mute();
    spacing: 10px;
    height: root.main ? 36px : 44px;
    Rectangle {
        width: 32px;
        height: 32px;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.r-s;
        background: mt-ta.has-hover ? Theme.hover : transparent;
        if root.has-img: Image {
            width: 20px;
            height: 20px;
            source: root.img;
            opacity: root.muted ? 0.4 : 1;
        }
        if !root.has-img: Icon {
            commands: root.muted || root.level == 0 ? Icons.mute : root.system ? Icons.bolt : Icons.volume;
            size: 18px;
            color: root.muted ? Theme.faint : Theme.text;
        }
        // Wyciszona aplikacja z ikoną – mały znaczek wyciszenia w rogu.
        if root.has-img && root.muted: Rectangle {
            x: parent.width - 14px;
            y: parent.height - 14px;
            width: 13px;
            height: 13px;
            border-radius: 6.5px;
            background: Theme.popup-high;
            Icon {
                commands: Icons.mute;
                size: 10px;
                color: Theme.text;
            }
        }
        mt-ta := TipArea {
            tip: root.muted ? "Włącz dźwięk" : "Wycisz";
            clicked => {
                root.mute();
            }
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        if !root.main: Text {
            text: root.name;
            overflow: elide;
            font-size: 11.5px;
            color: Theme.dim;
        }
        Track {
            value: root.muted ? 0 : root.level;
            changed-by-user(v) => {
                root.set(v);
            }
        }
    }
    Text {
        width: 34px;
        vertical-alignment: center;
        horizontal-alignment: right;
        text: round((root.muted ? 0 : root.level) * 100);
        font-size: 13px;
        color: Theme.text;
    }
}

/// Urządzenie odtwarzające na liście wyboru.
export struct OutDev {
    name: string,
    current: bool,
}

/// Okienko głośności nad ikoną: urządzenie odtwarzające (klik rozwija listę), głośność ogólna,
/// mikser aplikacji, „Ustawienia dźwięku”.
/// Wysokość liczy taskbar.rs (zależy od liczby aplikacji).
export component VolumeWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: Theme.popup-high;
    width: 320px;
    in property <float> volume;
    in property <bool> muted;
    in property <[AppVol]> apps;
    in property <[OutDev]> outputs;
    /// Lista urządzeń rozwinięta (wysokość okienka zmienia taskbar.rs).
    in property <bool> devices-open;
    callback toggle-devices();
    /// Nazwa bieżącego urządzenia (pusta lista – brak).
    in property <string> current-name;
    callback pick-output(int);
    callback set-volume(float);
    callback toggle-mute();
    callback app-volume(int, float);
    callback app-mute(int);
    callback settings();
    VerticalLayout {
        padding: 14px;
        spacing: 6px;
        alignment: start;
        // Bieżące urządzenie – klik rozwija listę (jak strzałka przy głośności w Windows).
        Rectangle {
            height: 32px;
            border-radius: Theme.r-s;
            background: dv-ta.has-hover ? Theme.hover : transparent;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    text: root.current-name;
                    overflow: elide;
                    font-size: 12px;
                    color: Theme.text;
                }
                Icon {
                    y: (parent.height - 14px) / 2;
                    commands: root.devices-open ? Icons.arrow-up : Icons.chevron-down;
                    size: 14px;
                    color: Theme.dim;
                }
            }
            dv-ta := TipArea {
                tip: "Urządzenie odtwarzające";
                clicked => {
                    root.toggle-devices();
                }
            }
        }
        if root.devices-open: VerticalLayout {
            spacing: 2px;
            for o[i] in root.outputs: Rectangle {
                height: 32px;
                border-radius: Theme.r-s;
                background: o.current ? Theme.sel : od-ta.has-hover ? Theme.hover : transparent;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    Rectangle {
                        width: 14px;
                        if o.current: Icon {
                            commands: Icons.check;
                            size: 14px;
                            color: Theme.accent;
                        }
                    }
                    Text {
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        text: o.name;
                        overflow: elide;
                        font-size: 12px;
                        color: Theme.text;
                    }
                }
                od-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.pick-output(i);
                    }
                }
            }
        }
        VolRow {
            main: true;
            level: root.volume;
            muted: root.muted;
            set(v) => {
                root.set-volume(v);
            }
            mute => {
                root.toggle-mute();
            }
        }
        if root.apps.length > 0: Text {
            height: 24px;
            vertical-alignment: bottom;
            text: "Aplikacje";
            font-size: 11px;
            font-weight: 600;
            color: Theme.dim;
        }
        for a in root.apps: VolRow {
            name: a.name;
            img: a.img;
            has-img: a.has-img;
            system: a.pid == 0;
            level: a.level;
            muted: a.muted;
            set(v) => {
                root.app-volume(a.pid, v);
            }
            mute => {
                root.app-mute(a.pid);
            }
        }
        HorizontalLayout {
            height: 24px;
            alignment: end;
            Text {
                vertical-alignment: bottom;
                text: "Ustawienia dźwięku";
                font-size: 12px;
                color: vs-ta.has-hover ? Theme.text : Theme.accent;
                vs-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.settings();
                    }
                }
            }
        }
    }
}

/// Sieć Wi-Fi w okienku sieci.
export struct NetRow {
    ssid: string,
    /// 0–100.
    signal: int,
    secured: bool,
    connected: bool,
    known: bool,
}

/// Przycisk tekstowy okienek zasobnika.
component PopButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    height: 30px;
    width: max(84px, pb-t.preferred-width + 24px);
    border-radius: Theme.r-s;
    background: root.primary ? (pb-ta.has-hover ? Theme.accent.darker(10%) : Theme.accent) : (pb-ta.has-hover ? Theme.hover : Theme.line);
    opacity: root.enabled ? 1 : 0.5;
    pb-t := Text {
        text: root.text;
        font-size: 12px;
        color: root.primary ? white : Theme.text;
    }
    pb-ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

/// Okienko sieci: połączenie przewodowe albo lista sieci Wi-Fi; wybrana sieć rozwija się
/// z „Połącz” / „Rozłącz” i polem hasła dla nowej zabezpieczonej sieci.
/// Kafelek szybkich ustawień: włączony – w kolorze akcentu; `link` – otwiera Ustawienia Windows.
component QuickTile inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> on;
    in property <bool> link;
    in property <string> tip;
    callback clicked();
    height: 56px;
    border-radius: Theme.r;
    background: root.on ? Theme.accent : qt-ta.has-hover ? Theme.hover : Theme.card;
    VerticalLayout {
        padding: 6px;
        spacing: 4px;
        alignment: center;
        Icon {
            commands: root.icon;
            size: 16px;
            color: root.on ? white : Theme.text;
        }
        Text {
            horizontal-alignment: center;
            text: root.text;
            overflow: elide;
            font-size: 10.5px;
            color: root.on ? white : Theme.text;
        }
    }
    qt-ta := TipArea {
        tip: root.tip;
        clicked => {
            root.clicked();
        }
    }
}

export component NetworkWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: Theme.popup-high;
    preferred-width: 340px;
    preferred-height: 580px;
    in property <bool> has-wifi;
    /// Nazwa karty, gdy internet idzie kablem (pusta – brak kabla).
    in property <string> wired;
    in property <[NetRow]> nets;
    /// Rozwinięta sieć (-1 – żadna).
    in-out property <int> open: -1;
    /// Komunikat pod rozwiniętą siecią (błąd albo „Łączenie…”).
    in property <string> note;
    in property <bool> scanning;
    /// Hasło wpisywane dla rozwiniętej sieci.
    in-out property <string> pass;
    callback connect(string, string);
    callback disconnect();
    callback rescan();
    callback settings();
    /// Szybkie ustawienia: Bluetooth (-1 – brak karty, 0 – wył., 1 – wł.), tryb samolotowy,
    /// jasność 0–1 (ujemna – nie da się ustawić). `quick` – kafelek po nazwie.
    in property <int> bt: -1;
    in property <bool> airplane;
    in property <float> brightness: -1;
    callback quick(string);
    callback set-brightness(float);
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 6px;
            QuickTile {
                icon: Icons.bluetooth;
                text: "Bluetooth";
                on: root.bt == 1;
                tip: root.bt < 0 ? "Bluetooth niedostępny – klik otwiera ustawienia urządzeń" : root.bt == 1 ? "Wyłącz Bluetooth" : "Włącz Bluetooth";
                clicked => {
                    root.quick(root.bt < 0 ? "bluetooth-settings" : "bluetooth");
                }
            }
            QuickTile {
                icon: Icons.plane;
                text: "Samolot";
                on: root.airplane;
                tip: root.airplane ? "Wyłącz tryb samolotowy" : "Tryb samolotowy – wyłącza Wi-Fi, Bluetooth i sieć komórkową";
                clicked => {
                    root.quick("airplane");
                }
            }
            QuickTile {
                icon: Icons.hotspot;
                text: "Hotspot";
                link: true;
                tip: "Udostępnianie internetu – Ustawienia Windows";
                clicked => {
                    root.quick("hotspot");
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            QuickTile {
                icon: Icons.moon;
                text: "Światło nocne";
                link: true;
                tip: "Światło nocne – Ustawienia Windows";
                clicked => {
                    root.quick("nightlight");
                }
            }
            QuickTile {
                icon: Icons.leaf;
                text: "Oszczędzanie";
                link: true;
                tip: "Oszczędzanie baterii – Ustawienia Windows";
                clicked => {
                    root.quick("batterysaver");
                }
            }
            QuickTile {
                icon: Icons.settings;
                text: "Wszystkie";
                link: true;
                tip: "Ustawienia Windows";
                clicked => {
                    root.quick("settings");
                }
            }
        }
        if root.brightness >= 0: HorizontalLayout {
            height: 28px;
            spacing: 10px;
            Icon {
                y: (parent.height - 16px) / 2;
                commands: Icons.sun;
                size: 16px;
                color: Theme.dim;
            }
            Track {
                y: (parent.height - self.height) / 2;
                horizontal-stretch: 1;
                value: root.brightness;
                changed-by-user(v) => {
                    root.set-brightness(v);
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.line;
        }
        HorizontalLayout {
            spacing: 6px;
            Text {
                horizontal-stretch: 1;
                vertical-alignment: center;
                text: "Sieć";
                font-size: 14px;
                font-weight: 600;
                color: Theme.text;
            }
            if root.has-wifi: Rectangle {
                width: 28px;
                height: 28px;
                border-radius: Theme.r-s;
                background: rs-ta.has-hover ? Theme.hover : transparent;
                Icon {
                    commands: Icons.refresh;
                    size: 14px;
                    color: root.scanning ? Theme.accent : Theme.dim;
                }
                rs-ta := TipArea {
                    tip: root.scanning ? "Szukanie sieci…" : "Szukaj sieci";
                    clicked => {
                        root.rescan();
                    }
                }
            }
        }
        if root.wired != "": HorizontalLayout {
            height: 44px;
            spacing: 10px;
            Rectangle {
                width: 32px;
                Icon {
                    commands: Icons.ethernet;
                    size: 18px;
                    color: Theme.accent;
                }
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.wired;
                    overflow: elide;
                    font-size: 12.5px;
                    color: Theme.text;
                }
                Text {
                    text: "Połączono kablem";
                    font-size: 11px;
                    color: Theme.dim;
                }
            }
        }
        if !root.has-wifi: Text {
            text: "Ten komputer nie ma karty Wi-Fi.";
            font-size: 12px;
            color: Theme.dim;
        }
        if root.has-wifi && root.nets.length == 0: Text {
            text: root.scanning ? "Szukanie sieci…" : "Nie widać żadnych sieci Wi-Fi.";
            font-size: 12px;
            color: Theme.dim;
        }
        Flickable {
            vertical-stretch: 1;
            content-height: list.preferred-height;
            list := VerticalLayout {
                alignment: start;
                spacing: 2px;
                for n[i] in root.nets: Rectangle {
                    property <bool> is-open: root.open == i;
                    height: self.is-open ? (n.connected || !n.secured || n.known ? 96px : 132px) + (root.note != "" ? 18px : 0) : 48px;
                    border-radius: Theme.r;
                    background: self.is-open ? Theme.sel : nr-ta.has-hover ? Theme.hover : transparent;
                    nr-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.open = parent.is-open ? -1 : i;
                            root.pass = "";
                        }
                    }
                    // Siła sygnału – jaśniejsza ikona przy słabym.
                    Icon {
                        x: 10px;
                        y: 15px;
                        commands: Icons.wifi;
                        size: 18px;
                        color: n.connected ? Theme.accent : Theme.text;
                        opacity: n.signal >= 60 ? 1 : n.signal >= 30 ? 0.7 : 0.45;
                    }
                    VerticalLayout {
                        x: 42px;
                        y: 6px;
                        width: parent.width - 52px;
                        height: 36px;
                        alignment: center;
                        Text {
                            text: n.ssid;
                            overflow: elide;
                            font-size: 12.5px;
                            color: Theme.text;
                        }
                        Text {
                            text: (n.connected ? "Połączono" : n.known ? "Zapisana" : "") + (n.connected || n.known ? ", " : "") + (n.secured ? "zabezpieczona" : "otwarta") + " · " + n.signal + "%";
                            font-size: 11px;
                            color: Theme.dim;
                        }
                    }
                    if root.open == i: VerticalLayout {
                        x: 42px;
                        y: 48px;
                        width: parent.width - 52px;
                        spacing: 8px;
                        if !n.connected && n.secured && !n.known: Rectangle {
                            height: 30px;
                            border-radius: Theme.r-s;
                            background: Theme.panel;
                            border-width: 1px;
                            border-color: pw.has-focus ? Theme.line-strong : Theme.line;
                            if root.pass == "": Text {
                                x: 10px;
                                text: "Hasło sieci";
                                font-size: 12px;
                                color: Theme.faint;
                            }
                            pw := TextInput {
                                x: 10px;
                                width: parent.width - 20px;
                                text <=> root.pass;
                                single-line: true;
                                input-type: password;
                                vertical-alignment: center;
                                font-size: 12px;
                                color: Theme.text;
                                accepted => {
                                    root.connect(n.ssid, self.text);
                                }
                            }
                        }
                        if root.note != "": Text {
                            text: root.note;
                            font-size: 11px;
                            color: Theme.dim;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            alignment: end;
                            if n.connected: PopButton {
                                text: "Rozłącz";
                                clicked => {
                                    root.disconnect();
                                }
                            }
                            if !n.connected: PopButton {
                                text: "Połącz";
                                primary: true;
                                enabled: !n.secured || n.known || root.pass != "";
                                clicked => {
                                    root.connect(n.ssid, root.pass);
                                }
                            }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            height: 20px;
            alignment: end;
            Text {
                text: "Ustawienia sieci i internetu";
                font-size: 12px;
                color: ns-ta.has-hover ? Theme.text : Theme.accent;
                ns-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.settings();
                    }
                }
            }
        }
    }
}

/// Dzień w siatce kalendarza.
export struct CalDay {
    num: int,
    today: bool,
    /// Dzień z sąsiedniego miesiąca – przygaszony.
    other: bool,
}

/// Kalendarz po kliknięciu w zegar: pełna data, miesiąc z przełączaniem, dzisiaj zaznaczone.
export component CalendarWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: Theme.popup-high;
    width: 316px;
    height: 372px;
    in property <string> long-date;
    in property <string> month;
    in property <[CalDay]> days;
    /// -1 / +1 – sąsiedni miesiąc, 0 – powrót do bieżącego.
    callback shift(int);
    callback settings();
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        Text {
            text: root.long-date;
            font-size: 14px;
            font-weight: 600;
            color: ld-ta.has-hover ? Theme.accent : Theme.text;
            ld-ta := TipArea {
                tip: "Wróć do bieżącego miesiąca";
                clicked => {
                    root.shift(0);
                }
            }
        }
        HorizontalLayout {
            spacing: 4px;
            Text {
                horizontal-stretch: 1;
                vertical-alignment: center;
                text: root.month;
                font-size: 13px;
                color: Theme.text;
            }
            for d in [-1, 1]: Rectangle {
                width: 28px;
                height: 28px;
                border-radius: Theme.r-s;
                background: mv-ta.has-hover ? Theme.hover : transparent;
                Icon {
                    commands: d < 0 ? Icons.arrow-up : Icons.arrow-down;
                    size: 14px;
                    color: Theme.dim;
                }
                mv-ta := TipArea {
                    tip: d < 0 ? "Poprzedni miesiąc" : "Następny miesiąc";
                    clicked => {
                        root.shift(d);
                    }
                }
            }
        }
        // Nagłówki dni i siatka 6×7 (od poniedziałku); kółko przewija miesiące.
        Rectangle {
            height: 32px + 6 * 38px;
            TouchArea {
                scroll-event(e) => {
                    if (e.delta-y == 0) {
                        return reject;
                    }
                    root.shift(e.delta-y > 0 ? -1 : 1);
                    accept
                }
            }
            for n[i] in ["pn", "wt", "śr", "cz", "pt", "so", "nd"]: Text {
                x: i * 41px;
                y: 0;
                width: 38px;
                height: 28px;
                horizontal-alignment: center;
                vertical-alignment: center;
                text: n;
                font-size: 11px;
                color: Theme.dim;
            }
            for day[i] in root.days: Rectangle {
                x: mod(i, 7) * 41px + 1px;
                y: 32px + floor(i / 7) * 38px;
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: day.today ? Theme.accent : transparent;
                Text {
                    text: day.num;
                    font-size: 12.5px;
                    color: day.today ? white : day.other ? Theme.faint : Theme.text;
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            Text {
                text: "Ustawienia daty i godziny";
                font-size: 12px;
                color: cs-ta.has-hover ? Theme.text : Theme.accent;
                cs-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.settings();
                    }
                }
            }
        }
    }
}

/// Karta podglądu okna nad przyciskiem paska.
export struct ThumbCard {
    title: string,
    img: image,
    has-img: bool,
    active: bool,
    minimized: bool,
    /// Obraz okna (taskbar.rs odświeża go, póki podglądy są otwarte).
    shot: image,
    has-shot: bool,
}

/// Podglądy okien grupy nad przyciskiem: obraz okna, a bez niego (okno zminimalizowane,
/// obraz jeszcze się robi) – ikona programu.
export component ThumbWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: Theme.popup-high;
    in property <[ThumbCard]> cards;
    /// Wymiary karty i podglądu – te same stałe co w taskbar.rs.
    out property <length> card-w: 220px;
    out property <length> card-h: 160px;
    out property <length> gap: 8px;
    callback activate(int);
    callback close-win(int);
    width: root.cards.length * (root.card-w + root.gap) + root.gap;
    height: root.card-h + 2 * root.gap;
    for c[i] in root.cards: Rectangle {
        x: root.gap + i * (root.card-w + root.gap);
        y: root.gap;
        width: root.card-w;
        height: root.card-h;
        border-radius: Theme.r;
        background: card-ta.has-hover ? Theme.hover : c.active ? Theme.sel : transparent;
        card-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.activate(i);
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.middle) {
                    root.close-win(i);
                }
            }
        }
        // Pasek tytułu karty: ikona, tytuł, zamknięcie.
        HorizontalLayout {
            y: 0;
            height: 30px;
            padding-left: 8px;
            padding-right: 4px;
            spacing: 6px;
            Rectangle {
                width: 16px;
                if c.has-img: Image {
                    y: (parent.height - 16px) / 2;
                    width: 16px;
                    height: 16px;
                    source: c.img;
                }
            }
            Text {
                horizontal-stretch: 1;
                vertical-alignment: center;
                text: c.title;
                overflow: elide;
                font-size: 11.5px;
                color: c.minimized ? Theme.dim : Theme.text;
            }
            Rectangle {
                width: 24px;
                height: 24px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.r-s;
                background: cl-ta.has-hover ? #e5484d : transparent;
                opacity: card-ta.has-hover || cl-ta.has-hover ? 1 : 0;
                Icon {
                    commands: Icons.close;
                    size: 12px;
                    color: cl-ta.has-hover ? white : Theme.dim;
                }
                cl-ta := TipArea {
                    tip: "Zamknij okno";
                    clicked => {
                        root.close-win(i);
                    }
                }
            }
        }
        // Miejsce podglądu (8, 30, 204×122) – obraz przy górze, tuż pod tytułem.
        Rectangle {
            x: 8px;
            y: 30px;
            width: parent.width - 16px;
            height: parent.height - 38px;
            border-radius: Theme.r-s;
            clip: true;
            if c.has-shot: Image {
                width: parent.width;
                height: parent.height;
                source: c.shot;
                image-fit: contain;
                vertical-alignment: top;
                image-rendering: smooth;
            }
            if !c.has-shot && c.has-img: Image {
                width: 32px;
                height: 32px;
                source: c.img;
                opacity: c.minimized ? 0.6 : 0.35;
            }
        }
    }
}

/// Pasek zadań PowerDesk na jednym monitorze – zastępuje pasek Windows (ukryty, taskbar.rs),
/// zarejestrowany jako AppBar, więc okna zmaksymalizowane kończą się nad nim.
export component TaskbarWindow inherits Window {
    /// Pas przycisków programów – do trafienia przycisku przy upuszczaniu plików (taskbar.rs).
    out property <length> lane-x: lane.absolute-position.x + lane.left;
    out property <length> lane-each: lane.each;
    no-frame: true;
    always-on-top: true;
    title: "PowerDesk – pasek zadań";
    /// Krycie tła (0–1) – z ustawień albo 0, gdy na monitorze widać pulpit (taskbar.rs).
    in property <float> bg-alpha: 1;
    background: Theme.panel.with-alpha(root.bg-alpha);
    animate background { duration: 250ms; }

    in property <[TaskButton]> buttons;
    /// Przypięte programy bez okien – wąskie przyciski z samą ikoną.
    in property <int> idle;
    /// Nazwy okien obok ikon (false – same ikony) i przyciski na środku paska.
    in property <bool> labels: true;
    in property <bool> centered;
    /// Data pod godziną.
    in property <bool> show-date: true;
    /// Własny przycisk Start: obraz z klatkami jedna pod drugą (zwykły, pod kursorem, wciśnięty,
    /// otwarty Start), ich liczba i proporcje jednej klatki (szerokość / wysokość).
    in property <image> start-img;
    in property <bool> has-start-img;
    in property <int> start-frames: 1;
    in property <float> start-aspect: 1;
    /// Start (albo wyszukiwanie) jest otwarty – przycisk podświetlony.
    in property <bool> start-open;
    /// Wysokość przycisków – z wysokości paska (pasek 48 px – przyciski 40 px).
    property <length> ih: clamp(root.bar-h - 8px, 24px, 64px);
    /// Wysokość paska z ustawień (taskbar.rs) – nie z wysokości okna, bo to dawałoby pętlę układu.
    in property <length> bar-h: 48px;
    /// Ikony programów na przyciskach (z ustawień) – nie większe niż pozwala wysokość paska.
    in property <length> app-icon: 28px;
    property <length> ai: min(root.app-icon, root.ih - 6px);
    /// Szerokość przycisku z samą ikoną (przypięty bez okien, tryb samych ikon).
    property <length> pin-w: max(44px, root.ai + 18px);
    /// Przeciągana ikona zasobnika: x kursora (-1 – nic nie przeciągamy).
    property <length> tray-drag-x: -1px;
    /// Początek i koniec przeciągania ikony zasobnika (taskbar.rs wstrzymuje wtedy zmiany listy).
    callback tray-drag-state(bool);
    property <bool> tray-dragging: root.tray-drag-x >= 0;
    changed tray-dragging => {
        root.tray-drag-state(self.tray-dragging);
    }
    in property <string> time;
    in property <string> date;
    /// Język klawiatury aktywnego okna (POL, ENG; puste – jeden układ, bez wskaźnika) i jego pełna nazwa.
    in property <string> kbd-short;
    in property <string> kbd-name;
    callback kbd-next();
    // Zasobnik: głośność (0–1), sieć (0 – brak, 1 – Wi-Fi, 2 – kabel), bateria.
    in property <bool> has-volume;
    in property <float> volume;
    in property <bool> muted;
    in property <int> net-kind;
    in property <string> net-name;
    in property <bool> has-battery;
    /// Pasek głównego monitora – tylko on ma zasobnik i powiadomienia; pozostałe sam zegar.
    in property <bool> main-bar: true;
    /// Podłączony dysk wymienny – ikona „Bezpieczne usuwanie sprzętu”.
    in property <bool> has-usb;
    callback usb-open(length);
    in property <int> battery;
    in property <bool> charging;
    /// Nieprzeczytane powiadomienia (centrum powiadomień przy zegarze).
    in property <int> notice-count;
    callback notices-open(length);
    /// Pulpity wirtualne: widoczny przełącznik, nazwa bieżącego i numer/liczba.
    in property <bool> vd-show;
    in property <string> vd-name;
    in property <string> vd-count;
    callback vd-menu(length);
    /// Kółko nad przełącznikiem – sąsiedni pulpit (-1 / +1).
    callback vd-wheel(int);
    /// Ikony programów w zasobniku przypięte do paska; ukryte – w okienku nad strzałką.
    in property <[TrayApp]> tray-apps;
    /// Ile ikon czeka w okienku ukrytych (0 – bez strzałki, chyba że wszystkie są na pasku).
    in property <int> tray-hidden;
    /// Wszystkie ikony na pasku – strzałka zostaje, żeby dało się to wyłączyć.
    in property <bool> tray-all;
    /// Podpowiedź pod kursorem zmieniona (tekst i punkt w oknie; pusty tekst – schować).
    callback tip(string, length, length);
    property <int> tip-serial: Tip.serial;
    property <string> tip-now: Tip.text;
    changed tip-serial => {
        root.tip(Tip.text, Tip.x, Tip.y);
    }
    changed tip-now => {
        if (self.tip-now == "") {
            root.tip("", 0, 0);
        }
    }
    /// Strzałka – okienko ukrytych ikon nad nią (x w oknie paska).
    callback tray-overflow(length);
    /// Klik na ikonie programu: klucz ikony i przycisk (0 – lewy, 1 – dwuklik, 2 – prawy).
    callback tray-app-click(string, int);
    /// Ikona przeciągnięta po pasku: identyfikator, przesunięcie w poziomie i czy puszczona
    /// na strzałce (wtedy trafia do ukrytych – jak w Windows).
    callback tray-app-drop(string, length, bool);
    /// Okienko głośności i kalendarz – x w oknie paska.
    callback volume-open(length);
    /// Kółko nad ikoną głośności – krok w górę (+1) albo w dół (-1).
    callback volume-wheel(int);
    callback toggle-mute();
    callback network-open(length);
    callback battery-open();
    callback calendar-open(length);
    callback start();
    /// Prawy przycisk na Start – menu PowerDesk (x w oknie paska).
    callback start-context(length);
    /// Prawy przycisk na pustym miejscu paska (x w oknie paska).
    callback bar-context(length);
    /// Wąski przycisk na prawym końcu – pokaż pulpit (Win+D).
    callback show-desktop();
    /// Podgląd pulpitu po najechaniu na „Pokaż pulpit” (włącz / wyłącz).
    callback peek(bool);
    callback activate(int);
    /// Przypięty przeciągnięty w nowe miejsce: numer przycisku, x upuszczenia w pasie przycisków
    /// i szerokość przycisku z oknami (do wyliczenia miejsca w taskbar.rs).
    callback reorder(int, length, length);
    /// Prawy przycisk na oknie – współrzędne w oknie paska.
    callback context(int, length, length);
    /// Kursor nad przyciskiem (środek przycisku w oknie paska) i zejście z niego – podglądy okien.
    callback hover(int, length);
    callback unhover();

    // Puste miejsce paska – prawy przycisk otwiera menu paska (przyciski leżą wyżej i mają swoje).
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                root.bar-context(self.mouse-x);
            }
        }
    }

    // Górna linia oddziela pasek od pulpitu (znika razem z tłem).
    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.line;
        opacity: root.bg-alpha;
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 0px;
        spacing: 4px;

        // Start: ikona PowerDesk albo własny obraz z ustawień (klatki: zwykły, pod kursorem,
        // wciśnięty, otwarty Start – jak „kulki” Start z innych programów).
        Rectangle {
            property <length> img-h: root.bar-h - 2px;
            width: root.has-start-img ? max(24px, self.img-h * root.start-aspect) : 44px;
            height: root.has-start-img ? self.img-h : root.ih;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.r;
            // Jak przyciski programów – bez tła; otwarty Start i kursor rozjaśniają samą ikonę.
            background: transparent;
            if !root.has-start-img: Icon {
                commands: Icons.grid;
                size: min(26px, root.ai);
                color: Theme.accent;
                opacity: root.start-open || st-ta.has-hover ? 1 : 0.85;
            }
            if root.has-start-img: Image {
                property <int> fh: floor(root.start-img.height / max(1, root.start-frames));
                property <int> frame: root.start-frames >= 4 && root.start-open ? 3 : root.start-frames >= 3 && (st-ta.pressed || root.start-open) ? 2 : root.start-frames >= 2 && st-ta.has-hover ? 1 : 0;
                width: parent.width;
                height: parent.height;
                source: root.start-img;
                source-clip-x: 0;
                source-clip-y: self.frame * self.fh;
                source-clip-width: root.start-img.width;
                source-clip-height: self.fh;
                image-fit: contain;
                image-rendering: smooth;
                // Obraz z jedną klatką – rozjaśnienie pod kursorem zamiast klatki „pod kursorem”.
                opacity: root.start-frames < 2 && st-ta.has-hover ? 0.85 : 1;
            }
            st-ta := TipArea {
                tip: "Start";
                clicked => {
                    root.start();
                }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                        root.start-context(self.absolute-position.x + self.mouse-x);
                    }
                }
            }
        }

        // Pulpity wirtualne: numer bieżącego, klik – lista, kółko – sąsiedni.
        if root.vd-show: Rectangle {
            width: vd.preferred-width + 16px;
            height: root.ih;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.r;
            background: vd-ta.has-hover ? Theme.hover : transparent;
            vd := HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                alignment: center;
                Icon {
                    y: (parent.height - 16px) / 2;
                    commands: Icons.grid;
                    size: 16px;
                    color: Theme.dim;
                }
                Text {
                    vertical-alignment: center;
                    text: root.vd-count;
                    font-size: 11.5px;
                    color: Theme.text;
                }
            }
            vd-ta := TipArea {
                tip: root.vd-name + " · kółko – sąsiedni pulpit";
                clicked => {
                    root.vd-menu(self.absolute-position.x);
                }
                scroll-event(e) => {
                    if (e.delta-y == 0) {
                        return reject;
                    }
                    root.vd-wheel(e.delta-y > 0 ? -1 : 1);
                    accept
                }
            }
        }

        // Programy – przypięte bez okien mają 44 px, reszta dzieli miejsce po równo
        // (najwyżej 200 px na przycisk).
        lane := Rectangle {
            horizontal-stretch: 1;
            property <int> busy: root.buttons.length - root.idle;
            property <length> each: self.busy == 0 ? 0 : root.labels ? min(200px, (self.width - 4px * root.buttons.length - root.pin-w * root.idle) / self.busy) : min(root.pin-w, (self.width - 4px * root.buttons.length - root.pin-w * root.idle) / self.busy);
            /// Wszystkie przyciski razem – do wyśrodkowania.
            property <length> used: root.idle * (root.pin-w + 4px) + self.busy * (self.each + 4px);
            property <length> left: root.centered ? max(0px, (self.width - self.used) / 2) : 0px;
            for b[i] in root.buttons: Rectangle {
                x: parent.left + b.idle-before * (root.pin-w + 4px) + (i - b.idle-before) * (parent.each + 4px);
                y: (parent.height - self.height) / 2;
                width: b.count == 0 ? root.pin-w : parent.each;
                height: root.ih;
                // Bez teł i kształtów pod ikoną – stan pokazuje kreska pod spodem (niżej).
                background: transparent;
                // Przeciąganie przycisku (przypiętego i uruchomionego): przycisk przygasa, miejsce wybiera puszczenie.
                property <bool> dragging: tb-ta.pressed && abs(tb-ta.mouse-x - tb-ta.pressed-x) > 8px;
                property <bool> was-drag;
                opacity: self.dragging ? 0.5 : 1;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    alignment: parent.width < 80px || b.count == 0 ? LayoutAlignment.center : LayoutAlignment.start;
                    Rectangle {
                        width: root.ai;
                        if b.has-img: Image {
                            // Ikona stoi w miejscu – bez podskoku pod kursorem.
                            y: (parent.height - root.ai) / 2;
                            width: root.ai;
                            height: root.ai;
                            source: b.img;
                            image-rendering: smooth;
                        }
                        // Plakietka w prawym dolnym rogu ikony, jak w Windows.
                        if b.has-badge: Image {
                            x: root.ai * 0.45;
                            y: (parent.height - root.ai) / 2 + root.ai * 0.45;
                            width: root.ai * 0.6;
                            height: root.ai * 0.6;
                            source: b.badge;
                            image-rendering: smooth;
                        }
                        if !b.has-img: Icon {
                            commands: Icons.file;
                            size: root.ai * 0.9;
                            color: Theme.dim;
                        }
                    }
                    if root.labels && parent.width >= 80px && b.count > 0: Text {
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        text: b.title;
                        overflow: elide;
                        font-size: 12px;
                        color: b.minimized ? Theme.faint : Theme.text;
                    }
                }
                // Stan programu: tylko aktywne okno ma kreskę w kolorze akcentu – bez kropek
                // pod uruchomionymi i przypiętymi.
                // Program woła o uwagę: pomarańczowa kreska pod ikoną, pulsuje.
                // Postęp programu (pobieranie, kopiowanie): pasek przez dół przycisku, kolor wg stanu.
                if b.progress-state > 0: Rectangle {
                    x: 4px;
                    y: parent.height - 3px;
                    width: parent.width - 8px;
                    height: 3px;
                    border-radius: 1.5px;
                    background: Theme.hover;
                    Rectangle {
                        property <float> run: mod(animation-tick() / 1ms, 1500) / 1500;
                        x: b.progress-state == 1 ? (parent.width * 0.7) * self.run : 0px;
                        width: b.progress-state == 1 ? parent.width * 0.3 : parent.width * clamp(b.progress, 0, 1);
                        height: parent.height;
                        border-radius: 1.5px;
                        background: b.progress-state == 3 ? #e5484d : b.progress-state == 4 ? #f7a531 : #3fb950;
                    }
                }
                if b.flash && !b.active: Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - 4px;
                    width: 24px;
                    height: 3px;
                    border-radius: 1.5px;
                    background: #f7a531;
                    opacity: 0.55 + 0.45 * abs(sin(animation-tick() / 1ms * 0.36deg));
                }
                if b.active && b.count > 0: Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - 4px;
                    width: 16px;
                    height: 3px;
                    border-radius: 1.5px;
                    background: Theme.accent;
                }
                // Przy oknach podpowiedź zastępują podglądy (jak w Windows).
                property <bool> hov: tb-ta.has-hover;
                changed hov => {
                    if (self.hov) {
                        root.hover(i, self.absolute-position.x + self.width / 2);
                    } else {
                        root.unhover();
                    }
                }
                tb-ta := TipArea {
                    tip: b.count == 0 ? b.title + " · przypięty" : "";
                    clicked => {
                        if (!parent.was-drag) {
                            root.activate(i);
                        }
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                            parent.was-drag = false;
                        }
                        if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left && parent.dragging) {
                            parent.was-drag = true;
                            root.reorder(i, self.absolute-position.x - lane.absolute-position.x - lane.left + self.mouse-x, lane.each);
                        }
                        if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                            root.context(i, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                }
            }
        }

        // Zasobnik: sieć, głośność, bateria – jak w Windows, tuż przed zegarem; ikony 40 px
        // wyśrodkowane w pionie w pasku 48 px (jak zegar). Tylko na pasku głównego monitora.
        if root.main-bar: HorizontalLayout {
            horizontal-stretch: 0;
            alignment: center;
            spacing: 0px;
            padding-top: (root.bar-h - root.ih) / 2;
            padding-bottom: (root.bar-h - root.ih) / 2;
            // Ukryte ikony: strzałka w górę jak w Windows – okienko nad nią. W trakcie
            // przeciągania ikony jest zawsze – puszczona na niej ikona trafia do ukrytych.
            // Strzałka stoi zawsze, gdy są ikony programów: pojawiając się dopiero przy
            // przeciąganiu, przestawiała cały zasobnik pod kursorem i nie dało się w nią trafić.
            property <bool> arrow-on: root.tray-hidden > 0 || root.tray-all || root.tray-apps.length > 0 || root.tray-drag-x >= 0;
            // Pole trafienia szersze od samej strzałki (po 8 px z każdej strony).
            property <bool> over-arrow: root.tray-drag-x >= arrow.absolute-position.x - 8px && root.tray-drag-x < arrow.absolute-position.x + arrow.width + 8px;
            arrow := TrayIcon {
                visible: parent.arrow-on;
                width: parent.arrow-on ? 28px : 0px;
                icon: Icons.chevron-down;
                lit: parent.over-arrow;
                tip: root.tray-drag-x >= 0 ? "" : root.tray-all ? "Ikony zasobnika" : "Pokaż ukryte ikony (" + root.tray-hidden + ")";
                transform-rotation: 180deg;
                clicked => {
                    root.tray-overflow(self.absolute-position.x);
                }
            }
            for a[i] in root.tray-apps: TrayAppIcon {
                img: a.img;
                tip: a.tip;
                pressed(b) => {
                    root.tray-app-click(a.key, b);
                }
                drag-at(x) => {
                    root.tray-drag-x = x;
                }
                dropped(dx, at) => {
                    root.tray-app-drop(a.id, dx, at >= arrow.absolute-position.x - 8px && at < arrow.absolute-position.x + arrow.width + 8px);
                }
            }
            TrayIcon {
                icon: root.net-kind == 0 ? Icons.wifi-off : root.net-kind == 1 ? Icons.wifi : Icons.ethernet;
                dim: root.net-kind == 0;
                tip: root.net-kind == 0 ? "Brak połączenia z internetem" : root.net-name;
                clicked => {
                    root.network-open(self.absolute-position.x);
                }
            }
            if root.has-volume: TrayIcon {
                icon: root.muted || root.volume == 0 ? Icons.mute : Icons.volume;
                tip: root.muted ? "Głośność: wyciszona" : "Głośność: " + round(root.volume * 100) + "%";
                clicked => {
                    root.volume-open(self.absolute-position.x);
                }
                middle => {
                    root.toggle-mute();
                }
                wheel(d) => {
                    root.volume-wheel(d);
                }
            }
            if root.has-usb: TrayIcon {
                icon: Icons.usb;
                tip: "Bezpieczne usuwanie sprzętu";
                clicked => {
                    root.usb-open(self.absolute-position.x);
                }
            }
            if root.has-battery: TrayIcon {
                icon: Icons.battery;
                tip: "Bateria: " + root.battery + "%" + (root.charging ? " · ładowanie" : "");
                clicked => {
                    root.battery-open();
                }
                // Wypełnienie baterii – kolor ostrzega przy niskim stanie.
                Rectangle {
                    x: (parent.width - 18px) / 2 + 4px;
                    y: (parent.height - 18px) / 2 + 7.5px;
                    width: 10px * root.battery / 100;
                    height: 3px;
                    border-radius: 1px;
                    background: root.charging ? Theme.accent : root.battery <= 15 ? #e5484d : Theme.text;
                }
            }
        }

        // Centrum powiadomień – z licznikiem nieprzeczytanych (tylko na głównym monitorze).
        nt := Rectangle {
            visible: root.main-bar;
            width: root.main-bar ? 30px : 0px;
            height: root.ih;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.r;
            background: nt-ta.has-hover ? Theme.hover : transparent;
            Icon {
                commands: Icons.menu-lines;
                size: 16px;
                color: root.notice-count > 0 ? Theme.text : Theme.dim;
            }
            if root.notice-count > 0: Rectangle {
                x: parent.width - 16px;
                y: 6px;
                width: max(14px, nc.preferred-width + 6px);
                height: 14px;
                border-radius: 7px;
                background: Theme.accent;
                nc := Text {
                    text: root.notice-count > 99 ? "99+" : root.notice-count;
                    font-size: 9px;
                    font-weight: 700;
                    color: white;
                }
            }
            nt-ta := TipArea {
                tip: root.notice-count > 0 ? "Powiadomienia (" + root.notice-count + " nowe)" : "Powiadomienia";
                clicked => {
                    root.notices-open(nt.absolute-position.x);
                }
            }
        }

        // Język klawiatury – klik przełącza na następny układ (jak Win+Spacja).
        if root.kbd-short != "": Rectangle {
            height: root.ih;
            y: (parent.height - self.height) / 2;
            width: kb.preferred-width + 12px;
            border-radius: Theme.r;
            background: kb-ta.has-hover ? Theme.hover : transparent;
            kb := Text {
                text: root.kbd-short;
                font-size: 11.5px;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            kb-ta := TipArea {
                tip: (root.kbd-name != "" ? root.kbd-name + " · " : "") + "kliknij, by zmienić język (Win+Spacja)";
                clicked => {
                    root.kbd-next();
                }
            }
        }

        // Zegar i data – klik otwiera kalendarz.
        clock := Rectangle {
            height: root.ih;
            y: (parent.height - self.height) / 2;
            width: ck.preferred-width;
            border-radius: Theme.r;
            background: ck-ta.has-hover ? Theme.hover : transparent;
            ck := VerticalLayout {
                alignment: center;
                padding-left: 8px;
                padding-right: 8px;
                Text {
                    text: root.time;
                    horizontal-alignment: right;
                    font-size: 12.5px;
                    color: Theme.text;
                }
                if root.show-date: Text {
                    text: root.date;
                    horizontal-alignment: right;
                    font-size: 11px;
                    color: Theme.dim;
                }
            }
            ck-ta := TipArea {
                tip: "Kalendarz";
                clicked => {
                    root.calendar-open(clock.absolute-position.x);
                }
            }
        }

        // Pokaż pulpit – wąski pasek przy prawej krawędzi, jak w Windows 10.
        // Bez kreski – cienka linia przy zegarze wyglądała jak krzyżyk; pole widać pod kursorem.
        Rectangle {
            width: 8px;
            background: sd-ta.has-hover ? Theme.hover : transparent;
            sd-ta := TipArea {
                tip: "Pokaż pulpit";
                clicked => {
                    root.peek(false);
                    root.show-desktop();
                }
            }
            // Po chwili pod kursorem okna przezroczyste – widać pulpit (jak w Windows).
            property <bool> hov: sd-ta.has-hover;
            changed hov => {
                if (self.hov) {
                    peek-timer.running = true;
                } else {
                    peek-timer.running = false;
                    root.peek(false);
                }
            }
            peek-timer := Timer {
                interval: 500ms;
                running: false;
                triggered => {
                    self.running = false;
                    root.peek(true);
                }
            }
        }
    }
}

/// Karta okna w widoku zadań (Win+Tab w trybie powłoki): miejsce liczy taskview.rs,
/// podgląd okna rysuje DWM pod paskiem tytułu karty.
export struct TaskCard {
    title: string,
    img: image,
    has-img: bool,
    active: bool,
    x: length,
    y: length,
    w: length,
    h: length,
}

/// Widok zadań na cały monitor: przyciemnione tło i karty okien. Klik – przełącza, środkowy
/// przycisk albo krzyżyk – zamyka okno, Esc i klik w tło – powrót.
export component TaskViewWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    title: "PowerDesk – widok zadań";
    background: #000000b0;
    in property <[TaskCard]> cards;
    callback pick(int);
    callback close-win(int);
    callback dismiss();
    forward-focus: tv-fs;
    tv-fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.dismiss();
                return accept;
            }
            reject
        }
    }
    TouchArea {
        clicked => {
            root.dismiss();
        }
    }
    if root.cards.length == 0: Text {
        text: "Brak otwartych okien";
        font-size: 16px;
        color: #ffffffcc;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    for c[i] in root.cards: Rectangle {
        x: c.x;
        y: c.y;
        width: c.w;
        height: c.h;
        border-radius: Theme.r;
        background: tc-ta.has-hover ? Theme.hover.with-alpha(1) : Theme.popup-high.with-alpha(1);
        border-width: c.active ? 2px : 1px;
        border-color: c.active ? Theme.accent : Theme.line;
        tc-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.pick(i);
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.middle) {
                    root.close-win(i);
                }
            }
        }
        HorizontalLayout {
            y: 0;
            height: 30px;
            padding-left: 8px;
            padding-right: 4px;
            spacing: 6px;
            Rectangle {
                width: 16px;
                if c.has-img: Image {
                    y: (parent.height - 16px) / 2;
                    width: 16px;
                    height: 16px;
                    source: c.img;
                }
            }
            Text {
                horizontal-stretch: 1;
                vertical-alignment: center;
                text: c.title;
                overflow: elide;
                font-size: 12px;
                color: Theme.text;
            }
            Rectangle {
                width: 26px;
                y: 2px;
                height: 26px;
                border-radius: Theme.r;
                background: tx-ta.has-hover ? #e5484d : transparent;
                Icon {
                    commands: Icons.close;
                    size: 14px;
                    color: tx-ta.has-hover ? white : Theme.dim;
                }
                tx-ta := TipArea {
                    tip: "Zamknij okno";
                    clicked => {
                        root.close-win(i);
                    }
                }
            }
        }
    }
}


/// Powiadomienie w historii centrum powiadomień.
export struct NoticeRow {
    source: string,
    title: string,
    text: string,
    time: string,
}

/// Historia powiadomień pod ikoną przy zegarze (notices.rs).
export component NoticesWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: Theme.popup-high;
    in property <[NoticeRow]> rows;
    callback clear();
    width: 340px;
    height: 460px;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            Text {
                horizontal-stretch: 1;
                text: "Powiadomienia";
                font-size: 14px;
                font-weight: 600;
                color: Theme.text;
            }
            if root.rows.length > 0: Rectangle {
                width: cl.preferred-width + 16px;
                height: 26px;
                border-radius: Theme.r-s;
                background: cl-ta.has-hover ? Theme.hover : transparent;
                cl := Text {
                    text: "Wyczyść wszystko";
                    font-size: 12px;
                    color: Theme.accent;
                }
                cl-ta := TipArea {
                    tip: "Usuń wszystkie powiadomienia z listy";
                    clicked => {
                        root.clear();
                    }
                }
            }
        }
        if root.rows.length == 0: Text {
            vertical-stretch: 1;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: "Brak nowych powiadomień";
            font-size: 12.5px;
            color: Theme.faint;
        }
        if root.rows.length > 0: Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 6px;
                for n in root.rows: Rectangle {
                    border-radius: Theme.r;
                    background: Theme.card;
                    height: nv.preferred-height;
                    nv := VerticalLayout {
                        padding: 10px;
                        spacing: 2px;
                        HorizontalLayout {
                            Text {
                                horizontal-stretch: 1;
                                text: n.source;
                                font-size: 10.5px;
                                color: Theme.dim;
                            }
                            Text {
                                text: n.time;
                                font-size: 10.5px;
                                color: Theme.faint;
                            }
                        }
                        if n.title != "": Text {
                            text: n.title;
                            font-size: 12.5px;
                            font-weight: 600;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                        Text {
                            text: n.text;
                            font-size: 12px;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}

/// Dymek nowego powiadomienia nad paskiem (6 s): klik w treść – historia, krzyżyk – zamknij.
export component NoticeToastWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: Theme.popup-high;
    in property <string> source;
    in property <string> title-text;
    in property <string> text;
    callback dismiss();
    callback open-list();
    width: 340px;
    height: 96px;
    TouchArea {
        clicked => {
            root.open-list();
        }
    }
    VerticalLayout {
        padding: 12px;
        padding-right: 34px;
        spacing: 2px;
        Text {
            text: root.source;
            font-size: 10.5px;
            color: Theme.dim;
        }
        if root.title-text != "": Text {
            text: root.title-text;
            font-size: 13px;
            font-weight: 600;
            color: Theme.text;
            overflow: elide;
        }
        Text {
            text: root.text;
            font-size: 12px;
            color: Theme.text;
            wrap: word-wrap;
            overflow: elide;
            vertical-stretch: 1;
        }
    }
    Rectangle {
        x: parent.width - 30px;
        y: 6px;
        width: 24px;
        height: 24px;
        border-radius: Theme.r-s;
        background: nx-ta.has-hover ? Theme.hover : transparent;
        Icon {
            commands: Icons.close;
            size: 12px;
            color: Theme.dim;
        }
        nx-ta := TipArea {
            tip: "Zamknij";
            clicked => {
                root.dismiss();
            }
        }
    }
}
