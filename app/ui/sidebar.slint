import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, Label, TipArea, Drag } from "components.slint";

export struct SideItem {
    section: string,
    name: string,
    icon: string,
    path: string,
    detail: string,
    usage: float,
    active: bool,
    img: image,
    has-img: bool,
    tip: string,
    /// Sekcja zwinięta (ustawione na pozycji z nagłówkiem).
    shut: bool,
    /// Sam nagłówek zwiniętej sekcji – bez wiersza pozycji.
    header-only: bool,
}

/// Przycisk w stopce panelu: ikona z podpowiedzią.
component FootButton inherits Rectangle {
    in property <string> icon;
    in property <string> tip;
    callback clicked;
    width: 30px;
    height: 30px;
    border-radius: Theme.r-s;
    background: fb-ta.has-hover ? Theme.hover : transparent;
    Icon {
        commands: root.icon;
        size: 16px;
        color: fb-ta.has-hover ? Theme.text : Theme.dim;
    }
    fb-ta := TipArea {
        tip: root.tip;
        clicked => {
            root.clicked();
        }
    }
}

/// Panel boczny (Sidebar.svelte): sekcje z nagłówkami (klik zwija), pozycje 34 px, dyski z paskiem zajętości.
/// `mini` – pasek samych ikon; nazwy w dymkach.
export component Sidebar inherits Rectangle {
    in property <[SideItem]> items;
    in property <bool> mini;
    in property <length> panel-width: 248px;
    callback open(string);
    callback context(string, length, length);
    callback toggle-section(string);
    callback toggle-mini;
    /// Przycisk ustawień w stopce panelu.
    callback open-settings;
    /// F6 / Esc – fokus wraca dalej (`true` – Shift+F6, wstecz).
    callback leave(bool);
    /// Pozycja wskazana z klawiatury (strzałki, Enter) – liczona w Rust, -1 – brak.
    in property <int> cursor: -1;
    /// Klawisz w panelu z fokusem: strzałki, Home/End, Enter (resztę obsługuje Rust).
    callback key(string);
    /// Panel dostał fokus z klawiatury – Rust ustawia kursor na bieżącym folderze.
    callback focused;
    out property <bool> has-keys: fs.has-focus;

    public function focus-in() {
        fs.focus();
        root.focused();
    }

    fs := FocusScope {
        width: 0;
        height: 0;
        key-pressed(e) => {
            if (e.text == Key.F6) {
                root.leave(e.modifiers.shift);
                return accept;
            }
            if (e.text == Key.Escape) {
                root.leave(false);
                return accept;
            }
            if (e.text == Key.UpArrow || e.text == Key.DownArrow || e.text == Key.Home || e.text == Key.End || e.text == Key.Return || e.text == " ") {
                root.key(e.text);
                return accept;
            }
            reject
        }
    }

    width: mini ? 52px : panel-width;
    animate width { duration: 160ms; easing: ease-out; }
    background: Theme.panel;
    border-radius: Theme.r-l;
    clip: true;

    /// Stopka: ustawienia i zwijanie panelu w prawym dolnym rogu (zwinięty – jeden nad drugim).
    property <length> foot-h: root.mini ? 76px : 44px;
    foot := Rectangle {
        y: root.height - root.foot-h;
        height: root.foot-h;
        Rectangle {
            y: 0;
            height: 1px;
            x: 8px;
            width: parent.width - 16px;
            background: Theme.line;
        }
        if root.mini: VerticalLayout {
            alignment: center;
            spacing: 4px;
            padding-top: 4px;
            HorizontalLayout {
                alignment: center;
                FootButton {
                    icon: Icons.settings;
                    tip: "Ustawienia PowerDesk (Ctrl+,)";
                    clicked => {
                        root.open-settings();
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                FootButton {
                    icon: Icons.sidebar;
                    tip: "Rozwiń panel boczny (Ctrl+B)";
                    clicked => {
                        root.toggle-mini();
                    }
                }
            }
        }
        if !root.mini: HorizontalLayout {
            alignment: end;
            spacing: 4px;
            padding-right: 8px;
            padding-top: 1px;
            FootButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.settings;
                tip: "Ustawienia PowerDesk (Ctrl+,)";
                clicked => {
                    root.open-settings();
                }
            }
            FootButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.sidebar;
                tip: "Zwiń panel boczny (Ctrl+B)";
                clicked => {
                    root.toggle-mini();
                }
            }
        }
    }

    Flickable {
        height: root.height - root.foot-h;
        y: 0;
        VerticalLayout {
            padding: root.mini ? 6px : 8px;
            padding-top: 8px;
            padding-bottom: 12px;
            alignment: start;
            // Miejsce do przypinania – widoczne tylko w trakcie przeciągania.
            if Drag.active: Rectangle {
                height: root.mini ? 40px : 44px;
                border-radius: Theme.r;
                border-width: Drag.target == "ofp:pin" ? 2px : 1px;
                border-color: Drag.target == "ofp:pin" ? Theme.accent : Theme.line;
                background: Drag.target == "ofp:pin" ? Theme.sel-strong : transparent;
                HorizontalLayout {
                    padding-left: root.mini ? 0 : 10px;
                    spacing: 11px;
                    alignment: root.mini ? center : start;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        commands: Icons.pin;
                        color: Drag.target == "ofp:pin" ? Theme.text : Theme.dim;
                    }
                    if !root.mini: Label {
                        text: "Upuść folder, aby przypiąć";
                        color: Drag.target == "ofp:pin" ? Theme.text : Theme.dim;
                    }
                }
                TipArea {
                    tip: "Przypnij w panelu bocznym";
                    drop: "ofp:pin";
                }
            }
            for it[i] in root.items: VerticalLayout {
                if it.section != "" && root.mini && i > 0: Rectangle {
                    height: 13px;
                    Rectangle {
                        y: 6px;
                        height: 1px;
                        x: 8px;
                        width: parent.width - 16px;
                        background: Theme.line;
                    }
                }
                if it.section != "" && !root.mini: Rectangle {
                    height: 32px;
                    border-radius: Theme.r-s;
                    background: sec-ta.has-hover ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        Label {
                            text: it.section;
                            font-size: 11px;
                            font-weight: 600;
                            letter-spacing: 0.66px;
                            color: sec-ta.has-hover ? Theme.text : Theme.faint;
                        }
                        Icon {
                            y: (parent.height - self.height) / 2;
                            commands: it.shut ? Icons.chevron : Icons.chevron-down;
                            size: 12px;
                            color: sec-ta.has-hover ? Theme.text : Theme.faint;
                            opacity: sec-ta.has-hover || it.shut ? 1 : 0;
                        }
                    }
                    sec-ta := TipArea {
                        tip: it.shut ? "Rozwiń sekcję" : "Zwiń sekcję";
                        drop: it.section == "Przypięte" ? "ofp:pin" : "";
                        clicked => {
                            root.toggle-section(it.section);
                        }
                    }
                }
                if it.section != "" && !root.mini && !it.header-only: Rectangle {
                    height: 2px;
                }
                if !it.header-only: Rectangle {
                    height: it.detail != "" && !root.mini ? 52px : 34px;
                    border-radius: Theme.r;
                    background: Drag.active && Drag.target == it.path ? Theme.sel-strong : it.active ? Theme.sel : ta.has-hover ? Theme.hover : transparent;
                    border-width: (Drag.active && Drag.target == it.path) || (root.has-keys && i == root.cursor) ? 2px : 0;
                    border-color: Theme.accent;
                    animate background { duration: 100ms; }
                    ta := TipArea {
                        tip: root.mini ? (it.detail != "" ? it.name + "\n" + it.detail : it.name) : it.tip;
                        drop: it.path;
                        clicked => {
                            root.open(it.path);
                        }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                                root.context(it.path, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: root.mini ? 0 : 10px;
                        padding-right: root.mini ? 0 : 10px;
                        spacing: 11px;
                        alignment: root.mini ? center : stretch;
                        // Ikona systemowa (jak w Eksploratorze); liniowa tylko do czasu jej wczytania.
                        // Stała kolumna 20 px i środek na wysokości nazwy – tekst wszystkich pozycji
                        // zaczyna się w tej samej linii, także w wierszach dysków z paskiem.
                        Rectangle {
                            width: 20px;
                            property <length> top: it.detail != "" && !root.mini ? 8px : (parent.height - 18px) / 2;
                            if it.has-img: Image {
                                x: 1px;
                                y: parent.top;
                                width: 18px;
                                height: 18px;
                                source: it.img;
                            }
                            if !it.has-img: Icon {
                                x: 1px;
                                y: parent.top;
                                commands: it.icon;
                                color: it.active || ta.has-hover ? Theme.text : Theme.dim;
                            }
                        }
                        if !root.mini: VerticalLayout {
                            alignment: it.detail != "" ? start : center;
                            padding-top: it.detail != "" ? 8px : 0;
                            spacing: 3px;
                            Label {
                                text: it.name;
                                color: it.active || ta.has-hover ? Theme.text : Theme.dim;
                            }
                            if it.detail != "": Rectangle {
                                height: 3px;
                                border-radius: 2px;
                                background: Theme.line;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * it.usage;
                                    border-radius: 2px;
                                    background: it.usage > 0.9 ? Theme.rec : it.usage > 0.75 ? Theme.warn : Theme.ok;
                                }
                            }
                            if it.detail != "": Label {
                                text: it.detail;
                                font-size: 11px;
                                color: Theme.faint;
                            }
                        }
                    }
                }
            }
        }
    }
}
