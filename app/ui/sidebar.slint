import { Theme } from "theme.slint";
import { Icon, Label, TipArea, Drag } from "components.slint";

export struct SideItem {
    section: string,
    name: string,
    icon: string,
    path: string,
    detail: string,
    usage: float,
    active: bool,
    img: image,
    has-img: bool,
    tip: string,
}

/// Panel boczny (Sidebar.svelte): sekcje z nagłówkami, pozycje 34 px, dyski z paskiem zajętości.
export component Sidebar inherits Rectangle {
    in property <[SideItem]> items;
    in property <length> panel-width: 248px;
    callback open(string);
    callback context(string, length, length);

    width: panel-width;
    background: Theme.panel;
    border-radius: Theme.r-l;
    clip: true;

    Flickable {
        VerticalLayout {
            padding: 8px;
            padding-top: 10px;
            padding-bottom: 12px;
            alignment: start;
            for it[i] in root.items: VerticalLayout {
                if it.section != "": Label {
                    height: 36px;
                    vertical-alignment: bottom;
                    text: it.section;
                    font-size: 11px;
                    font-weight: 600;
                    letter-spacing: 0.66px;
                    color: Theme.faint;
                    x: 8px;
                }
                if it.section != "": Rectangle {
                    height: 6px;
                }
                Rectangle {
                    height: it.detail != "" ? 52px : 34px;
                    border-radius: Theme.r;
                    background: Drag.active && Drag.target == it.path ? Theme.sel-strong : it.active ? Theme.sel : ta.has-hover ? Theme.hover : transparent;
                    border-width: Drag.active && Drag.target == it.path ? 2px : 0;
                    border-color: Theme.accent;
                    animate background { duration: 100ms; }
                    ta := TipArea {
                        tip: it.tip;
                        drop: it.path;
                        clicked => {
                            root.open(it.path);
                        }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                                root.context(it.path, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 11px;
                        // Ikona systemowa (jak w Eksploratorze); liniowa tylko do czasu jej wczytania.
                        if it.has-img: Image {
                            y: (parent.height - 18px) / 2;
                            width: 18px;
                            height: 18px;
                            source: it.img;
                        }
                        if !it.has-img: Icon {
                            y: (parent.height - self.height) / 2;
                            commands: it.icon;
                            color: it.active || ta.has-hover ? Theme.text : Theme.dim;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            Label {
                                text: it.name;
                                color: it.active || ta.has-hover ? Theme.text : Theme.dim;
                            }
                            if it.detail != "": Rectangle {
                                height: 3px;
                                border-radius: 2px;
                                background: Theme.line;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * it.usage;
                                    border-radius: 2px;
                                    background: it.usage > 0.9 ? Theme.rec : it.usage > 0.75 ? Theme.warn : Theme.ok;
                                }
                            }
                            if it.detail != "": Label {
                                text: it.detail;
                                font-size: 11px;
                                color: Theme.faint;
                            }
                        }
                    }
                }
            }
        }
    }
}
