import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, Label, TipArea } from "components.slint";
import { ListView } from "std-widgets.slint";

/// Kafelek mapy – położenie w pikselach obszaru mapy (układ liczony w spaceview.rs).
export struct SpaceTile {
    index: int,
    x: float,
    y: float,
    w: float,
    h: float,
    name: string,
    size: string,
    tip: string,
    color: color,
    dir: bool,
}

/// Wiersz listy „Największe”.
export struct SpaceRow {
    index: int,
    name: string,
    size: string,
    color: color,
    frac: float,
}

/// Wiersz porządków: nagłówek grupy albo znaleziony element.
export struct SpaceJunk {
    header: bool,
    group: int,
    title: string,
    hint: string,
    path: string,
    reason: string,
    size: string,
    when: string,
    on: bool,
}

/// Zajętość i porządki (SpaceView.svelte) – dane w spaceview.rs, skanowanie w powerdesk_core::space.
export global SpaceState {
    in-out property <bool> open;
    /// 0 – zajętość (mapa), 1 – porządki.
    in-out property <int> mode;
    in-out property <string> root;
    in-out property <bool> busy;
    in-out property <string> progress;
    in-out property <string> current;
    in-out property <string> error;

    // Mapa.
    in-out property <bool> ready;
    in-out property <[string]> crumbs;
    in-out property <string> summary;
    in-out property <[SpaceTile]> tiles;
    in-out property <[SpaceRow]> rows;
    in-out property <int> hover: -1;

    // Porządki.
    in-out property <bool> scanned;
    in-out property <bool> with-temp;
    in-out property <[SpaceJunk]> junk;
    in-out property <int> picked-count;
    in-out property <string> picked-text;

    callback set-mode(int);
    callback rescan;
    callback cancel;
    callback resized(float, float);
    callback open-tile(int);
    callback tile-menu(int, length, length);
    callback crumb(int);
    callback toggle-temp;
    callback toggle-pick(string);
    callback toggle-group(int);
    callback clean;
}

component Btn inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> main;
    in property <bool> enabled: true;
    callback clicked;
    height: 28px;
    width: row.preferred-width + 20px;
    border-radius: Theme.r-s;
    opacity: root.enabled ? 1 : 0.45;
    background: root.main ? (b-ta.has-hover ? Theme.accent.darker(0.1) : Theme.accent) : b-ta.has-hover ? Theme.press : Theme.card;
    row := HorizontalLayout {
        x: 10px;
        spacing: 6px;
        alignment: center;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            commands: root.icon;
            size: 14px;
            color: root.main ? Theme.on-accent : Theme.text;
        }
        Label {
            text: root.text;
            font-size: 12px;
            color: root.main ? Theme.on-accent : Theme.text;
        }
    }
    b-ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

/// Przycisk przełącznika Zajętość / Porządki.
component Seg inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> on;
    callback clicked;
    height: 28px;
    width: sr.preferred-width + 24px;
    border-radius: Theme.r-s;
    background: root.on ? Theme.accent : s-ta.has-hover ? Theme.hover : transparent;
    sr := HorizontalLayout {
        x: 12px;
        spacing: 6px;
        alignment: center;
        Icon {
            y: (parent.height - self.height) / 2;
            commands: root.icon;
            size: 15px;
            color: root.on ? Theme.on-accent : Theme.dim;
        }
        Label {
            text: root.text;
            font-size: 12.5px;
            color: root.on ? Theme.on-accent : Theme.dim;
        }
    }
    s-ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component Box inherits Rectangle {
    in property <bool> on;
    width: 16px;
    height: 16px;
    border-radius: Theme.r-xs;
    border-width: root.on ? 0 : 1.5px;
    border-color: Theme.line-strong;
    background: root.on ? Theme.accent : transparent;
    if root.on: Icon {
        commands: Icons.check;
        size: 11px;
        color: Theme.on-accent;
    }
}

component Map inherits Rectangle {
    border-radius: Theme.r;
    background: Theme.panel;
    clip: true;
    init => {
        SpaceState.resized(self.width / 1px, self.height / 1px);
    }
    changed width => {
        SpaceState.resized(self.width / 1px, self.height / 1px);
    }
    changed height => {
        SpaceState.resized(self.width / 1px, self.height / 1px);
    }
    for t in SpaceState.tiles: Rectangle {
        property <bool> hov: ta.has-hover;
        changed hov => {
            if (self.hov) {
                SpaceState.hover = t.index;
            } else if (SpaceState.hover == t.index) {
                SpaceState.hover = -1;
            }
        }
        x: t.x * 1px;
        y: t.y * 1px;
        width: t.w * 1px;
        height: t.h * 1px;
        background: SpaceState.hover == t.index ? t.color.brighter(0.18) : t.color;
        border-width: 1px;
        border-color: #00000059;
        if t.w > 70 && t.h > 34: VerticalLayout {
            padding-left: 6px;
            padding-right: 6px;
            padding-bottom: 4px;
            alignment: end;
            Label {
                text: t.name;
                font-size: 12px;
                font-weight: 600;
                color: #ffffff;
            }
            Label {
                text: t.size;
                font-size: 11px;
                color: #ffffffd9;
            }
        }
        ta := TipArea {
            tip: t.tip;
            clicked => {
                SpaceState.open-tile(t.index);
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                    SpaceState.tile-menu(t.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
    }
}

component Waiting inherits VerticalLayout {
    in property <string> text;
    in property <string> icon;
    alignment: center;
    spacing: 8px;
    if root.icon != "": Icon {
        commands: root.icon;
        size: 26px;
        color: Theme.faint;
    }
    Text {
        text: root.text;
        horizontal-alignment: center;
        wrap: word-wrap;
        font-family: Theme.font;
        font-size: 13px;
        color: Theme.faint;
    }
}

export component SpaceView inherits Rectangle {
    background: Theme.bg;

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 12px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 10px;
            height: 32px;
            Rectangle {
                width: seg.preferred-width + 4px;
                border-radius: Theme.r;
                background: Theme.high;
                seg := HorizontalLayout {
                    padding: 2px;
                    Seg {
                        icon: Icons.grid;
                        text: "Zajętość";
                        on: SpaceState.mode == 0;
                        clicked => {
                            SpaceState.set-mode(0);
                        }
                    }
                    Seg {
                        icon: Icons.trash;
                        text: "Porządki";
                        on: SpaceState.mode == 1;
                        clicked => {
                            SpaceState.set-mode(1);
                        }
                    }
                }
            }
            Label {
                horizontal-stretch: 1;
                text: SpaceState.root;
                font-size: 12.5px;
                color: Theme.dim;
            }
            if SpaceState.busy: Label {
                text: SpaceState.progress;
                font-size: 12px;
                color: Theme.faint;
            }
            if SpaceState.busy: Btn {
                y: 2px;
                text: "Przerwij";
                clicked => {
                    SpaceState.cancel();
                }
            }
            if !SpaceState.busy: Btn {
                y: 2px;
                icon: Icons.refresh;
                text: "Skanuj ponownie";
                clicked => {
                    SpaceState.rescan();
                }
            }
        }

        if SpaceState.error != "": Label {
            text: SpaceState.error;
            font-size: 12.5px;
            color: Theme.rec;
        }

        // ---------- Zajętość ----------
        if SpaceState.mode == 0 && SpaceState.ready: HorizontalLayout {
            height: 24px;
            spacing: 2px;
            for c[i] in SpaceState.crumbs: HorizontalLayout {
                spacing: 2px;
                if i > 0: Icon {
                    y: (parent.height - self.height) / 2;
                    commands: Icons.chevron;
                    size: 12px;
                    color: Theme.faint;
                }
                Rectangle {
                    width: cl.preferred-width + 12px;
                    border-radius: Theme.r-xs;
                    background: c-ta.has-hover ? Theme.hover : transparent;
                    cl := Label {
                        text: c;
                        font-size: 12.5px;
                        color: c-ta.has-hover ? Theme.text : Theme.dim;
                    }
                    c-ta := TouchArea {
                        clicked => {
                            SpaceState.crumb(i);
                        }
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Label {
                text: SpaceState.summary;
                font-size: 12px;
                color: Theme.faint;
            }
        }
        if SpaceState.mode == 0 && SpaceState.ready: HorizontalLayout {
            vertical-stretch: 1;
            spacing: 12px;
            Map {
                horizontal-stretch: 1;
            }
            VerticalLayout {
                width: 300px;
                spacing: 4px;
                Label {
                    text: "Największe";
                    font-size: 13px;
                    font-weight: 600;
                }
                ListView {
                    vertical-stretch: 1;
                    for r in SpaceState.rows: Rectangle {
                        height: 28px;
                        border-radius: Theme.r-s;
                        background: r-ta.has-hover || SpaceState.hover == r.index ? Theme.hover : transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 10px;
                                height: 10px;
                                border-radius: Theme.r-xs;
                                background: r.color;
                            }
                            Label {
                                horizontal-stretch: 1;
                                text: r.name;
                                font-size: 12.5px;
                                color: r-ta.has-hover || SpaceState.hover == r.index ? Theme.text : Theme.dim;
                            }
                            Label {
                                text: r.size;
                                font-size: 12px;
                                color: Theme.faint;
                            }
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: max(2px, r.frac * 60px);
                                height: 4px;
                                border-radius: 2px;
                                background: Theme.accent;
                                opacity: 0.6;
                            }
                        }
                        r-ta := TouchArea {
                            clicked => {
                                SpaceState.open-tile(r.index);
                            }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                                    SpaceState.tile-menu(r.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                    }
                }
            }
        }
        if SpaceState.mode == 0 && !SpaceState.ready && SpaceState.busy: Waiting {
            vertical-stretch: 1;
            text: "Liczę rozmiary…\n" + SpaceState.current;
        }

        // ---------- Porządki ----------
        if SpaceState.mode == 1: HorizontalLayout {
            spacing: 10px;
            height: 28px;
            Rectangle {
                width: tl.preferred-width;
                tl := HorizontalLayout {
                    spacing: 8px;
                    Box {
                        y: (parent.height - self.height) / 2;
                        on: SpaceState.with-temp;
                    }
                    Label {
                        text: "Uwzględnij folder TEMP systemu";
                        font-size: 12.5px;
                    }
                }
                TouchArea {
                    enabled: !SpaceState.busy;
                    clicked => {
                        SpaceState.toggle-temp();
                    }
                }
            }
            Label {
                horizontal-stretch: 1;
                horizontal-alignment: right;
                text: "Wszystko trafia do Kosza – można przywrócić. Foldery programów, systemowe, ukryte i repozytoria są pomijane.";
                font-size: 12px;
                color: Theme.faint;
            }
        }
        if SpaceState.mode == 1 && SpaceState.busy: Waiting {
            vertical-stretch: 1;
            text: "Szukam…";
        }
        if SpaceState.mode == 1 && !SpaceState.busy && SpaceState.scanned && SpaceState.junk.length == 0: Waiting {
            vertical-stretch: 1;
            icon: Icons.check;
            text: "Czysto – nie znaleziono nic do usunięcia.";
        }
        if SpaceState.mode == 1 && !SpaceState.busy && SpaceState.junk.length > 0: ListView {
            vertical-stretch: 1;
            for j in SpaceState.junk: Rectangle {
                height: j.header ? 54px : 28px;
                border-radius: Theme.r-s;
                background: !j.header && j-ta.has-hover ? Theme.hover : transparent;
                if j.header: VerticalLayout {
                    padding-top: 10px;
                    padding-bottom: 6px;
                    spacing: 2px;
                    HorizontalLayout {
                        padding-left: 6px;
                        spacing: 8px;
                        Box {
                            y: (parent.height - self.height) / 2;
                            on: j.on;
                        }
                        Label {
                            text: j.title;
                            font-size: 13px;
                            font-weight: 600;
                        }
                        Label {
                            horizontal-stretch: 1;
                            text: j.reason;
                            font-size: 12.5px;
                            color: Theme.faint;
                        }
                    }
                    Label {
                        x: 30px;
                        text: j.hint;
                        font-size: 12px;
                        color: Theme.faint;
                    }
                }
                if !j.header: HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 10px;
                    Box {
                        y: (parent.height - self.height) / 2;
                        on: j.on;
                    }
                    Label {
                        horizontal-stretch: 1;
                        text: j.path;
                        font-size: 12.5px;
                    }
                    Label {
                        text: j.reason;
                        font-size: 12px;
                        color: Theme.faint;
                    }
                    Label {
                        width: 90px;
                        horizontal-alignment: right;
                        text: j.size;
                        font-size: 12px;
                        color: Theme.faint;
                    }
                    Label {
                        width: 90px;
                        horizontal-alignment: right;
                        text: j.when;
                        font-size: 12px;
                        color: Theme.faint;
                    }
                }
                j-ta := TipArea {
                    tip: j.header ? "" : j.path;
                    clicked => {
                        if (j.header) {
                            SpaceState.toggle-group(j.group);
                        } else {
                            SpaceState.toggle-pick(j.path);
                        }
                    }
                }
            }
        }
        if SpaceState.mode == 1 && !SpaceState.busy && SpaceState.junk.length > 0: Rectangle {
            height: 1px;
            background: Theme.line;
        }
        if SpaceState.mode == 1 && !SpaceState.busy && SpaceState.junk.length > 0: HorizontalLayout {
            height: 34px;
            spacing: 10px;
            Label {
                horizontal-stretch: 1;
                text: SpaceState.picked-text;
                font-size: 12.5px;
            }
            Btn {
                y: 3px;
                main: true;
                icon: Icons.trash;
                text: "Przenieś do Kosza";
                enabled: SpaceState.picked-count > 0;
                clicked => {
                    SpaceState.clean();
                }
            }
        }
        if SpaceState.mode == 1 && !SpaceState.busy && !SpaceState.scanned: Rectangle {
            vertical-stretch: 1;
        }
    }
}
