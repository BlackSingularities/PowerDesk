import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, Label, TipArea } from "components.slint";
import { ScrollView, LineEdit, Slider } from "std-widgets.slint";

/// Sekcja panelu bocznego i czy jest widoczna.
export struct SideSection {
    name: string,
    on: bool,
}

/// Element zastępowania Eksploratora w sekcji System.
export struct SysItem {
    name: string,
    detail: string,
    ok: bool,
}

/// Panel folderu przy krawędzi pulpitu (edgepanels.rs): folder, monitor, krawędź, szerokość.
export struct EdgeRow {
    name: string,
    path: string,
    monitor: int,
    edge: int,
    width: float,
}

/// Ekran ustawień (SettingsView.svelte) – dane i zapis w settings.rs.
export global SettingsState {
    in-out property <bool> open;
    /// Wybrana sekcja z listy po lewej.
    in-out property <int> section;
    /// Szukanie w ustawieniach: tekst i sekcje, które mają pasujące opcje (settings.rs).
    in-out property <string> query;
    in-out property <[bool]> matches;
    callback search(string);
    /// 0 – jak w systemie, 1 – ciemny, 2 – jasny.
    in-out property <int> theme;
    /// „mono”, „system” albo #rrggbb.
    in-out property <string> accent;
    in-out property <color> system-accent;
    /// 0 – folder domowy, 1 – Komputer, 2 – wybrany folder.
    in-out property <int> start;
    in-out property <string> start-folder;
    /// 0 – lista, 1 – siatka, 2 – galeria.
    in-out property <int> default-view;
    in-out property <bool> show-hidden;
    in-out property <bool> folders-first;
    in-out property <bool> auto-gallery;
    in-out property <bool> folder-sizes;
    in-out property <bool> preview-open;
    in-out property <bool> viewer-info;
    in-out property <bool> confirm-trash;
    /// Jedno kliknięcie otwiera (czyta też widok plików).
    in-out property <bool> single-click;
    in-out property <[SideSection]> side-sections;
    /// Sekcje ekranu „Komputer” (nagłówek, czy widoczna) i przełączenie po nagłówku.
    in-out property <[SideSection]> home-sections;
    callback toggle-home(string);
    callback toggle-side(string);
    /// Krycie tła okna przy Mica/Acrylic w procentach (0 – domyślne).
    in-out property <float> window-opacity;
    callback set-window-opacity(float);
    in-out property <bool> close-to-tray;
    in-out property <bool> autostart-window;
    /// Start razem z Windows.
    in-out property <bool> autostart: true;
    /// Okna „Otwórz”/„Zapisz jako” PowerDesk w innych programach.
    in-out property <bool> file-dialogs: true;
    /// Zamknięte okno pamięta karty.
    in-out property <bool> remember-tabs;
    /// Potrząśnięcie oknem (ustawienie Windows, czytane z rejestru).
    in-out property <bool> shake;
    /// Aktualizacje: sprawdzanie w tle, instalacja bez pytania, stan i czy jest wersja do instalacji.
    in-out property <bool> update-check: true;
    in-out property <bool> update-auto;
    in-out property <string> update-status;
    in-out property <bool> update-ready;
    callback update-check-now;
    callback update-install;
    /// Zastąpienie Eksploratora – stan poszczególnych elementów (z rejestru).
    in-out property <[SysItem]> system;
    callback repair-integration;
    /// Instalacja: czy zainstalowany, gdzie, i czy to ta kopia.
    in-out property <bool> installed;
    in-out property <string> install-place;
    callback install(bool);
    // Nakładka z wydajnością.
    in-out property <bool> overlay-on;
    in-out property <int> overlay-corner;
    in-out property <bool> overlay-full;
    /// Stan pomiaru FPS (uprawnienia) – opis dla użytkownika i czy pokazać przycisk zgody.
    in-out property <string> fps-status;
    in-out property <bool> fps-need-access;
    callback set-overlay-corner(int);
    callback grant-fps();
    in-out property <bool> game-power;
    in-out property <int> fps-limit;
    callback set-fps-limit(int);
    /// Raport (wersja, system, dziennik) do schowka i folder z dziennikiem.
    callback report-problem();
    // Tapety: tryb (0 – Windows, 1 – pokaz slajdów, 2 – Bing), folder, co ile minut.
    in-out property <bool> vd-button;
    in-out property <bool> taskbar-all;
    /// Przyciski wszystkich okien na każdym pasku.
    in-out property <bool> taskbar-buttons-all;
    in-out property <bool> zones-on;
    in-out property <int> zones-layout;
    callback set-zones-layout(int);
    in-out property <int> wall-mode;
    in-out property <string> wall-folder;
    in-out property <int> wall-minutes;
    callback set-wall-mode(int);
    callback pick-wall-folder();
    callback set-wall-minutes(int);
    callback uninstall();
    in-out property <int> remembered;
    in-out property <string> version;
    in-out property <string> prefs-path;
    /// Tło okna: 0 – pełne, 1 – Mica, 2 – Acrylic.
    in-out property <int> effect;
    /// Krycie okienek w procentach (60–100).
    in-out property <float> popup-opacity: 100;
    /// Rozmycie tła pod okienkami (Acrylic z Windows 11).
    in-out property <bool> popup-blur: true;
    /// Krycie paska zadań w procentach (0–100) i przezroczystość na pulpicie.
    in-out property <float> taskbar-opacity: 100;
    in-out property <bool> taskbar-clear-desktop;
    callback set-taskbar-opacity(float);
    /// Pasek: nazwy okien, środek, sekundy, data, rozmycie, wszystkie ikony zasobnika, wysokość.
    in-out property <bool> taskbar-labels: true;
    in-out property <bool> taskbar-center;
    /// Autoukrywanie paska (to samo ustawienie co w Windows).
    in-out property <bool> taskbar-autohide;
    in-out property <bool> taskbar-seconds;
    in-out property <bool> taskbar-date: true;
    in-out property <bool> taskbar-blur: true;
    in-out property <bool> tray-all;
    in-out property <int> taskbar-height: 48;
    callback set-taskbar-height(int);
    /// Grupowanie okien: 0 – zawsze, 1 – gdy pasek pełny, 2 – nigdy.
    in-out property <int> taskbar-group;
    callback set-taskbar-group(int);
    /// Wielkość ikon programów na pasku (px).
    in-out property <int> taskbar-icon: 28;
    callback set-taskbar-icon(int);
    /// Motyw Startu: 0 – Windows 10, 1 – Windows 11, 2 – klasyczny.
    in-out property <int> start-style;
    callback set-start-style(int);
    /// Własny przycisk Start: plik obrazu i liczba klatek (0 – wykryj).
    in-out property <string> start-image;
    in-out property <int> start-frames;
    callback pick-start-image();
    callback clear-start-image();
    callback set-start-frames(int);
    /// Pulpit: rozmiar ikon (0–2), ułożenie dowolne, „Ten komputer”.
    in-out property <int> desktop-icon-size: 1;
    in-out property <bool> desktop-free;
    in-out property <bool> desktop-computer: true;
    in-out property <bool> desktop-recycle: true;
    callback set-desktop-icon-size(int);
    /// Foldery przy krawędziach pulpitu i liczba monitorów (okien pulpitu).
    in-out property <[EdgeRow]> edge-rows;
    in-out property <int> edge-monitors: 1;
    callback edge-add(int);
    callback edge-remove(int);
    callback edge-set-edge(int, int);
    callback edge-set-monitor(int, int);
    callback edge-set-width(int, float);
    /// PowerDesk jest powłoką systemu (zamiast explorer.exe).
    in-out property <bool> shell-mode;
    /// Zakończenie: 0 – uruchom ponownie, 1 – zakończ, 2 – przełącz na Eksplorator (tryb powłoki).
    callback app-quit(int);
    callback set-theme(int);
    /// Języki: „Jak w Windows” i wbudowane (nazwy); wybrany – numer na tej liście.
    in-out property <[string]> languages;
    in-out property <int> language;
    callback set-language(int);
    callback set-effect(int);
    callback set-popup-opacity(float);
    callback set-accent(string);
    callback set-start(int);
    callback pick-start-folder;
    callback set-default-view(int);
    /// Przełącznik po kluczu: show-hidden, folders-first, auto-gallery, folder-sizes, preview, viewer-info, confirm-trash.
    callback toggle(string);
    callback forget-views;
    callback open-prefs-folder;
}

/// Przełącznik w stylu Windows.
component Switch inherits Rectangle {
    in property <bool> on;
    width: 38px;
    height: 20px;
    border-radius: 10px;
    background: root.on ? Theme.accent : Theme.line-strong;
    animate background { duration: 120ms; }
    Rectangle {
        x: root.on ? parent.width - self.width - 3px : 3px;
        y: 3px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: root.on ? Theme.on-accent : Theme.text;
        animate x { duration: 120ms; }
    }
}

/// Wiersz z ikoną, opisem i przełącznikiem; klik w cały wiersz przełącza.
component ToggleRow inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <string> hint;
    in property <string> kbd;
    in property <bool> on;
    callback toggled;
    height: max(48px, row.preferred-height);
    border-radius: Theme.r;
    background: tr-ta.has-hover ? Theme.hover : Theme.card;
    row := HorizontalLayout {
        padding: 10px;
        padding-left: 14px;
        spacing: 12px;
        Icon {
            y: (parent.height - self.height) / 2;
            commands: root.icon;
            size: 17px;
            color: Theme.dim;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Label {
                text: root.text;
                font-size: 13px;
            }
            if root.hint != "": Text {
                text: root.hint;
                wrap: word-wrap;
                font-family: Theme.font;
                font-size: 11.5px;
                color: Theme.faint;
            }
        }
        if root.kbd != "": Label {
            text: root.kbd;
            font-size: 11px;
            color: Theme.faint;
        }
        Switch {
            y: (parent.height - self.height) / 2;
            on: root.on;
        }
    }
    tr-ta := TouchArea {
        clicked => {
            root.toggled();
        }
    }
}

/// Karta wyboru jednej z kilku opcji (motyw, start, widok).
component Choice inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <string> hint;
    in property <bool> on;
    callback clicked;
    height: 64px;
    horizontal-stretch: 1;
    border-radius: Theme.r;
    border-width: root.on ? 2px : 1px;
    border-color: root.on ? Theme.accent : Theme.line;
    background: ch-ta.has-hover ? Theme.hover : Theme.card;
    HorizontalLayout {
        padding: 12px;
        spacing: 10px;
        Icon {
            y: (parent.height - self.height) / 2;
            commands: root.icon;
            size: 18px;
            color: root.on ? Theme.text : Theme.dim;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Label {
                text: root.text;
                font-size: 13px;
                font-weight: root.on ? 600 : 400;
            }
            Label {
                text: root.hint;
                font-size: 11px;
                color: Theme.faint;
            }
        }
    }
    ch-ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component SetButton inherits Rectangle {
    in property <string> text;
    in property <string> tip;
    in property <bool> on;
    in property <bool> danger;
    callback clicked;
    width: sb.preferred-width + 24px;
    height: 30px;
    border-radius: Theme.r-s;
    background: root.on ? Theme.sel : sb-ta.has-hover ? Theme.press : Theme.card;
    sb := Label {
        horizontal-alignment: center;
        text: root.text;
        font-size: 12.5px;
        font-weight: root.on ? 600 : 400;
        color: root.danger ? Theme.rec : Theme.text;
    }
    sb-ta := TipArea {
        tip: root.tip;
        clicked => {
            root.clicked();
        }
    }
}

component Heading inherits VerticalLayout {
    in property <string> title;
    in property <string> lead;
    spacing: 3px;
    padding-bottom: 6px;
    Label {
        text: root.title;
        font-size: 20px;
        font-weight: 600;
    }
    Label {
        text: root.lead;
        font-size: 12.5px;
        color: Theme.faint;
    }
}

component Key inherits HorizontalLayout {
    in property <string> keys;
    in property <string> what;
    height: 30px;
    spacing: 12px;
    Rectangle {
        width: 170px;
        Rectangle {
            x: 0;
            y: (parent.height - self.height) / 2;
            width: k.preferred-width + 14px;
            height: 22px;
            border-radius: Theme.r-xs;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.line;
            k := Label {
                horizontal-alignment: center;
                text: root.keys;
                font-size: 11.5px;
            }
        }
    }
    Label {
        horizontal-stretch: 1;
        text: root.what;
        font-size: 12.5px;
        color: Theme.dim;
    }
}

export component SettingsView inherits Rectangle {
    background: Theme.bg;
    /// Którakolwiek sekcja pasuje do szukania.
    property <bool> any-match: SettingsState.matches.length > 0 && (SettingsState.matches[0] || SettingsState.matches[1] || SettingsState.matches[2] || SettingsState.matches[3] || SettingsState.matches[4] || SettingsState.matches[5] || SettingsState.matches[6] || SettingsState.matches[7] || SettingsState.matches[8] || SettingsState.matches[9] || SettingsState.matches[10]);
    property <[{title: string, icon: string}]> nav: [
        { title: @tr("Wygląd"), icon: Icons.eye },
        { title: @tr("Nowe okno"), icon: Icons.bolt },
        { title: @tr("Widok folderów"), icon: Icons.grid },
        { title: @tr("Przeglądanie"), icon: Icons.folder },
        { title: @tr("Podgląd"), icon: Icons.panel },
        { title: @tr("Pulpit"), icon: Icons.desktop },
        { title: @tr("Pasek zadań"), icon: Icons.sidebar },
        { title: @tr("System"), icon: Icons.shield },
        { title: @tr("Skróty klawiszowe"), icon: Icons.hash },
        { title: @tr("O aplikacji"), icon: Icons.info },
        { title: @tr("Nakładka"), icon: Icons.bolt },
    ];
    property <[string]> accents: ["#4f8cff", "#8b5cf6", "#ec4899", "#ef4444", "#f97316", "#eab308", "#22c55e", "#14b8a6"];
    property <[{keys: string, what: string}]> shortcuts: [
        { keys: "Ctrl+T / Ctrl+W", what: "Nowa / zamknij kartę" },
        { keys: "Ctrl+Shift+T", what: @tr("Przywróć zamkniętą kartę") },
        { keys: "Ctrl+Tab", what: @tr("Następna karta") },
        { keys: "Ctrl+\\", what: @tr("Podział na dwa panele") },
        { keys: "F6", what: @tr("Kolejno: adres, panel boczny, lista, podgląd") },
        { keys: "Ctrl+K", what: @tr("Szybkie przejście do folderu") },
        { keys: "Ctrl+Shift+P", what: @tr("Paleta poleceń") },
        { keys: "Ctrl+,", what: @tr("Ustawienia") },
        { keys: "Ctrl+L / Alt+D", what: @tr("Edytuj ścieżkę") },
        { keys: "Alt+← / → / ↑", what: "Wstecz / dalej / w górę" },
        { keys: "Alt+P", what: @tr("Panel podglądu") },
        { keys: "F2", what: @tr("Zmień nazwę") },
        { keys: "Del / Shift+Del", what: "Kosz / usuń trwale" },
        { keys: "Ctrl+C / X / V", what: "Kopiuj / wytnij / wklej" },
        { keys: "Ctrl+Z / Ctrl+Y", what: "Cofnij / ponów" },
        { keys: "Ctrl+Shift+N", what: @tr("Nowy folder") },
        { keys: "Ctrl+Shift+S", what: @tr("Dodaj na półkę") },
        { keys: "Ctrl+1 / 2 / 3", what: "Lista / siatka / galeria" },
        { keys: @tr("Ctrl+kółko"), what: @tr("Wielkość miniatur") },
        { keys: "Ctrl+H", what: @tr("Ukryte pliki") },
        { keys: "Ctrl+B", what: @tr("Zwiń panel boczny") },
        { keys: "Alt+Enter", what: @tr("Właściwości") },
        { keys: "F11", what: @tr("Pełny ekran w przeglądarce zdjęć") },
    ];

    HorizontalLayout {
        // Lista sekcji.
        Rectangle {
            width: 230px;
            VerticalLayout {
                padding: 16px;
                padding-top: 22px;
                spacing: 2px;
                alignment: start;
                Label {
                    text: @tr("Ustawienia");
                    font-size: 15px;
                    font-weight: 600;
                }
                Rectangle {
                    height: 6px;
                }
                // Szukanie: zostają sekcje z pasującymi opcjami, pierwsza otwiera się sama.
                Rectangle {
                    height: 32px;
                    border-radius: Theme.r-s;
                    background: Theme.card;
                    border-width: 1px;
                    border-color: sq.has-focus ? Theme.accent : Theme.line;
                    Icon {
                        x: 9px;
                        commands: Icons.search;
                        size: 14px;
                        color: Theme.dim;
                    }
                    if SettingsState.query == "": Text {
                        x: 30px;
                        text: @tr("Szukaj w ustawieniach");
                        font-size: 12px;
                        color: Theme.faint;
                        vertical-alignment: center;
                    }
                    sq := TextInput {
                        x: 30px;
                        width: parent.width - 38px;
                        text <=> SettingsState.query;
                        single-line: true;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Theme.text;
                        edited => {
                            SettingsState.search(self.text);
                        }
                        key-pressed(e) => {
                            if (e.text == Key.Escape) {
                                self.text = "";
                                SettingsState.search("");
                                return accept;
                            }
                            reject
                        }
                    }
                }
                Rectangle {
                    height: 6px;
                }
                if SettingsState.query != "" && !root.any-match: Text {
                    text: @tr("Nic nie pasuje");
                    font-size: 12px;
                    color: Theme.faint;
                }
                for n[i] in root.nav: Rectangle {
                    property <bool> shown: SettingsState.query == "" || (SettingsState.matches[i]);
                    visible: self.shown;
                    height: self.shown ? 34px : 0px;
                    border-radius: Theme.r-s;
                    background: SettingsState.section == i ? Theme.sel : nv-ta.has-hover ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 10px;
                        Icon {
                            y: (parent.height - self.height) / 2;
                            commands: n.icon;
                            size: 15px;
                            color: SettingsState.section == i ? Theme.text : Theme.dim;
                        }
                        Label {
                            horizontal-stretch: 1;
                            text: n.title;
                            font-size: 12.5px;
                            font-weight: SettingsState.section == i ? 600 : 400;
                        }
                    }
                    nv-ta := TouchArea {
                        clicked => {
                            SettingsState.section = i;
                        }
                    }
                }
            }
        }
        ScrollView {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 28px;
                padding-right: 40px;
                spacing: 10px;
                alignment: start;

                if SettingsState.section == 0: VerticalLayout {
                    spacing: 10px;
                    Heading {
                        title: @tr("Wygląd");
                        lead: @tr("Motyw i kolor akcentu całej aplikacji");
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Choice {
                            icon: Icons.app;
                            text: @tr("Jak w systemie");
                            hint: @tr("Podąża za ustawieniem Windows");
                            on: SettingsState.theme == 0;
                            clicked => {
                                SettingsState.set-theme(0);
                            }
                        }
                        Choice {
                            icon: Icons.eye;
                            text: @tr("Ciemny");
                            hint: @tr("Czarne tło");
                            on: SettingsState.theme == 1;
                            clicked => {
                                SettingsState.set-theme(1);
                            }
                        }
                        Choice {
                            icon: Icons.eye;
                            text: @tr("Jasny");
                            hint: @tr("Jasne tło");
                            on: SettingsState.theme == 2;
                            clicked => {
                                SettingsState.set-theme(2);
                            }
                        }
                    }
                    Label {
                        text: @tr("Język");
                        font-size: 13px;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        for name[k] in SettingsState.languages: Choice {
                            icon: Icons.app;
                            text: name;
                            hint: k == 0 ? @tr("Język Windows, gdy jest tłumaczenie") : "";
                            on: SettingsState.language == k;
                            clicked => {
                                SettingsState.set-language(k);
                            }
                        }
                    }
                    Label {
                        text: @tr("Kolor akcentu");
                        font-size: 13px;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        // Biały / czarny.
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 15px;
                            border-width: SettingsState.accent == "mono" ? 3px : 1px;
                            border-color: SettingsState.accent == "mono" ? Theme.text : Theme.line-strong;
                            background: Theme.light ? #111111 : #ffffff;
                            TipArea {
                                tip: @tr("Biały lub czarny");
                                clicked => {
                                    SettingsState.set-accent("mono");
                                }
                            }
                        }
                        // Z Windows.
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 15px;
                            border-width: SettingsState.accent == "system" ? 3px : 1px;
                            border-color: SettingsState.accent == "system" ? Theme.text : Theme.line-strong;
                            background: SettingsState.system-accent;
                            Label {
                                horizontal-alignment: center;
                                text: "W";
                                font-size: 12px;
                                font-weight: 700;
                                color: #ffffff;
                            }
                            TipArea {
                                tip: @tr("Kolor akcentu z Windows");
                                clicked => {
                                    SettingsState.set-accent("system");
                                }
                            }
                        }
                        for c in root.accents: Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 15px;
                            border-width: SettingsState.accent == c ? 3px : 0px;
                            border-color: Theme.text;
                            background: c == "#4f8cff" ? #4f8cff : c == "#8b5cf6" ? #8b5cf6 : c == "#ec4899" ? #ec4899 : c == "#ef4444" ? #ef4444 : c == "#f97316" ? #f97316 : c == "#eab308" ? #eab308 : c == "#22c55e" ? #22c55e : #14b8a6;
                            TouchArea {
                                clicked => {
                                    SettingsState.set-accent(c);
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Label {
                            y: (parent.height - self.height) / 2;
                            text: @tr("Własny kolor");
                            font-size: 12.5px;
                            color: Theme.dim;
                        }
                        LineEdit {
                            width: 130px;
                            placeholder-text: "#rrggbb";
                            text: SettingsState.accent.character-count == 7 ? SettingsState.accent : "";
                            accepted(t) => {
                                SettingsState.set-accent(t);
                            }
                        }
                        Label {
                            y: (parent.height - self.height) / 2;
                            text: @tr("Enter zatwierdza");
                            font-size: 11px;
                            color: Theme.faint;
                        }
                    }
                    Label {
                        text: @tr("Tło okna");
                        font-size: 13px;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Choice {
                            icon: Icons.panel;
                            text: @tr("Pełne");
                            hint: @tr("Jednolity kolor motywu");
                            on: SettingsState.effect == 0;
                            clicked => {
                                SettingsState.set-effect(0);
                            }
                        }
                        Choice {
                            icon: Icons.gallery;
                            text: @tr("Mica");
                            hint: @tr("Delikatnie przepuszcza kolor tapety (Windows 11)");
                            on: SettingsState.effect == 1;
                            clicked => {
                                SettingsState.set-effect(1);
                            }
                        }
                        Choice {
                            icon: Icons.gallery;
                            text: @tr("Acrylic");
                            hint: @tr("Rozmyte tło spod okna (Windows 11)");
                            on: SettingsState.effect == 2;
                            clicked => {
                                SettingsState.set-effect(2);
                            }
                        }
                    }
                    if SettingsState.effect != 0: Label {
                        text: @tr("Krycie tła okna");
                        font-size: 13px;
                        font-weight: 600;
                    }
                    if SettingsState.effect != 0: HorizontalLayout {
                        spacing: 12px;
                        Slider {
                            horizontal-stretch: 1;
                            minimum: 20;
                            maximum: 100;
                            step: 5;
                            value: SettingsState.window-opacity == 0 ? (SettingsState.effect == 1 ? 45 : 75) : SettingsState.window-opacity;
                            changed(v) => {
                                SettingsState.set-window-opacity(round(v / 5) * 5);
                            }
                        }
                        Label {
                            y: (parent.height - self.height) / 2;
                            width: 44px;
                            text: (SettingsState.window-opacity == 0 ? (SettingsState.effect == 1 ? 45 : 75) : round(SettingsState.window-opacity)) + "%";
                            font-size: 12.5px;
                        }
                    }
                    Label {
                        text: @tr("Krycie okienek");
                        font-size: 13px;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Slider {
                            horizontal-stretch: 1;
                            minimum: 30;
                            maximum: 100;
                            step: 5;
                            value: SettingsState.popup-opacity;
                            changed(v) => {
                                SettingsState.set-popup-opacity(round(v / 5) * 5);
                            }
                        }
                        Label {
                            y: (parent.height - self.height) / 2;
                            width: 44px;
                            text: round(SettingsState.popup-opacity) + "%";
                            font-size: 12.5px;
                        }
                    }
                    Label {
                        text: @tr("Wszystkie okienka: menu podręczne, Start, okienka paska i zasobnika, podpowiedzi, historia schowka i powiadomienia");
                        font-size: 11.5px;
                        color: Theme.faint;
                        wrap: word-wrap;
                    }
                    ToggleRow {
                        icon: Icons.eye;
                        text: @tr("Rozmycie tła okienek");
                        hint: @tr("To, co pod okienkiem, jest rozmyte (Windows 11); bez rozmycia – tylko przezroczyste");
                        on: SettingsState.popup-blur;
                        toggled => {
                            SettingsState.toggle("popup-blur");
                        }
                    }
                }

                if SettingsState.section == 1: VerticalLayout {
                    spacing: 10px;
                    Heading {
                        title: @tr("Nowe okno");
                        lead: @tr("Co pokazuje nowa karta i okno (Win+E, menu ikony w zasobniku) · przypięte karty wracają zawsze");
                    }
                    Choice {
                        icon: Icons.home;
                        text: @tr("Folder domowy");
                        hint: @tr("Jedna karta z Twoim folderem użytkownika");
                        on: SettingsState.start == 0;
                        clicked => {
                            SettingsState.set-start(0);
                        }
                    }
                    Choice {
                        icon: Icons.pc;
                        text: @tr("Komputer");
                        hint: @tr("Dyski, foldery i ostatnie pliki");
                        on: SettingsState.start == 1;
                        clicked => {
                            SettingsState.set-start(1);
                        }
                    }
                    Choice {
                        icon: Icons.folder;
                        text: @tr("Wybrany folder");
                        hint: SettingsState.start-folder != "" ? SettingsState.start-folder : @tr("Kliknij, aby wybrać folder");
                        on: SettingsState.start == 2;
                        clicked => {
                            if (SettingsState.start-folder == "") {
                                SettingsState.pick-start-folder();
                            } else {
                                SettingsState.set-start(2);
                            }
                        }
                    }
                    if SettingsState.start == 2: HorizontalLayout {
                        alignment: start;
                        Rectangle {
                            width: pf.preferred-width + 24px;
                            height: 30px;
                            border-radius: Theme.r-s;
                            background: pf-ta.has-hover ? Theme.press : Theme.card;
                            pf := Label {
                                horizontal-alignment: center;
                                text: @tr("Zmień folder…");
                                font-size: 12.5px;
                            }
                            pf-ta := TouchArea {
                                clicked => {
                                    SettingsState.pick-start-folder();
                                }
                            }
                        }
                    }
                    Label {
                        text: @tr("Ekran „Komputer”");
                        font-size: 13px;
                        font-weight: 600;
                    }
                    Label {
                        text: @tr("Sekcje pod dyskami i folderami – wyłączone znikają z ekranu (kolejność zmienisz strzałkami przy nagłówkach)");
                        wrap: word-wrap;
                        font-size: 12px;
                        color: Theme.faint;
                    }
                    for sec in SettingsState.home-sections: ToggleRow {
                        icon: Icons.pc;
                        text: sec.name;
                        on: sec.on;
                        toggled => {
                            SettingsState.toggle-home(sec.name);
                        }
                    }
                }

                if SettingsState.section == 2: VerticalLayout {
                    spacing: 10px;
                    Heading {
                        title: @tr("Widok folderów");
                        lead: @tr("Jak otwiera się folder, dla którego nic nie zapamiętano");
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Choice {
                            icon: Icons.list;
                            text: @tr("Lista");
                            hint: "Ctrl+1";
                            on: SettingsState.default-view == 0;
                            clicked => {
                                SettingsState.set-default-view(0);
                            }
                        }
                        Choice {
                            icon: Icons.grid;
                            text: @tr("Siatka");
                            hint: "Ctrl+2";
                            on: SettingsState.default-view == 1;
                            clicked => {
                                SettingsState.set-default-view(1);
                            }
                        }
                        Choice {
                            icon: Icons.gallery;
                            text: @tr("Galeria");
                            hint: "Ctrl+3";
                            on: SettingsState.default-view == 2;
                            clicked => {
                                SettingsState.set-default-view(2);
                            }
                        }
                    }
                    ToggleRow {
                        icon: Icons.gallery;
                        text: @tr("Zdjęcia i filmy w galerii");
                        hint: @tr("Foldery z samymi mediami otwierają się w galerii");
                        on: SettingsState.auto-gallery;
                        toggled => {
                            SettingsState.toggle("auto-gallery");
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Label {
                            horizontal-stretch: 1;
                            text: SettingsState.remembered > 0 ? @tr("Zapamiętane widoki folderów: ") + SettingsState.remembered : @tr("Żaden folder nie ma zapamiętanego widoku");
                            font-size: 12px;
                            color: Theme.faint;
                        }
                        if SettingsState.remembered > 0: Rectangle {
                            width: fv.preferred-width + 24px;
                            height: 30px;
                            border-radius: Theme.r-s;
                            background: fv-ta.has-hover ? Theme.press : Theme.card;
                            fv := Label {
                                horizontal-alignment: center;
                                text: @tr("Zapomnij wszystkie");
                                font-size: 12.5px;
                            }
                            fv-ta := TouchArea {
                                clicked => {
                                    SettingsState.forget-views();
                                }
                            }
                        }
                    }
                }

                if SettingsState.section == 3: VerticalLayout {
                    spacing: 8px;
                    Heading {
                        title: @tr("Przeglądanie");
                        lead: @tr("Jak wyglądają i otwierają się foldery");
                    }
                    ToggleRow {
                        icon: Icons.eye;
                        text: @tr("Ukryte i systemowe pliki");
                        kbd: "Ctrl+H";
                        on: SettingsState.show-hidden;
                        toggled => {
                            SettingsState.toggle("show-hidden");
                        }
                    }
                    ToggleRow {
                        icon: Icons.sort;
                        text: @tr("Foldery przed plikami");
                        on: SettingsState.folders-first;
                        toggled => {
                            SettingsState.toggle("folders-first");
                        }
                    }
                    ToggleRow {
                        icon: Icons.hash;
                        text: @tr("Rozmiary folderów");
                        hint: @tr("Liczone w tle w kolumnie Rozmiar · bez dysków sieciowych");
                        on: SettingsState.folder-sizes;
                        toggled => {
                            SettingsState.toggle("folder-sizes");
                        }
                    }
                    ToggleRow {
                        icon: Icons.trash;
                        text: @tr("Pytaj przed przeniesieniem do Kosza");
                        hint: @tr("Usuwanie trwałe (Shift+Del) zawsze wymaga potwierdzenia");
                        on: SettingsState.confirm-trash;
                        toggled => {
                            SettingsState.toggle("confirm-trash");
                        }
                    }
                    ToggleRow {
                        icon: Icons.open;
                        text: @tr("Jedno kliknięcie otwiera");
                        hint: @tr("Zaznaczanie: Ctrl, Shift albo ramka · jak „Kliknij raz, aby otworzyć” w Eksploratorze");
                        on: SettingsState.single-click;
                        toggled => {
                            SettingsState.toggle("single-click");
                        }
                    }
                    Label {
                        text: @tr("Sekcje panelu bocznego");
                        font-size: 13px;
                        font-weight: 600;
                    }
                    for sec in SettingsState.side-sections: ToggleRow {
                        icon: Icons.sidebar;
                        text: sec.name;
                        on: sec.on;
                        toggled => {
                            SettingsState.toggle-side(sec.name);
                        }
                    }
                }

                if SettingsState.section == 4: VerticalLayout {
                    spacing: 8px;
                    Heading {
                        title: @tr("Podgląd");
                        lead: @tr("Panel z prawej i przeglądarka zdjęć");
                    }
                    ToggleRow {
                        icon: Icons.panel;
                        text: @tr("Panel podglądu");
                        hint: @tr("Zdjęcia, filmy, PDF, tekst i kod obok listy");
                        kbd: "Alt+P";
                        on: SettingsState.preview-open;
                        toggled => {
                            SettingsState.toggle("preview");
                        }
                    }
                    ToggleRow {
                        icon: Icons.info;
                        text: @tr("Informacje i EXIF w przeglądarce");
                        hint: @tr("Panel z metadanymi po prawej stronie zdjęcia");
                        kbd: "I";
                        on: SettingsState.viewer-info;
                        toggled => {
                            SettingsState.toggle("viewer-info");
                        }
                    }
                }

                if SettingsState.section == 5: VerticalLayout {
                    spacing: 10px;
                    Heading {
                        title: @tr("Pulpit");
                        lead: @tr("PowerDesk zastępuje pulpit Windows na każdym monitorze");
                    }
                    ToggleRow {
                        icon: Icons.desktop;
                        text: @tr("Potrząśnięcie oknem minimalizuje pozostałe");
                        hint: @tr("Złap okno za pasek tytułu i potrząśnij – reszta okien się chowa, drugie potrząśnięcie je przywraca");
                        on: SettingsState.shake;
                        toggled => {
                            SettingsState.toggle("shake");
                        }
                    }
                    ToggleRow {
                        icon: Icons.grid;
                        text: @tr("Strefy okien");
                        kbd: @tr("Shift + przeciąganie");
                        hint: @tr("Przeciągnij okno za pasek tytułu z wciśniętym Shiftem – puść nad strefą, a okno ją wypełni");
                        on: SettingsState.zones-on;
                        toggled => {
                            SettingsState.toggle("zones");
                        }
                    }
                    if SettingsState.zones-on: HorizontalLayout {
                        spacing: 6px;
                        for name[k] in [@tr("2 kolumny"), @tr("3 kolumny"), "2 × 2", @tr("Główna + 2"), @tr("Szeroki środek")]: Rectangle {
                            height: 30px;
                            horizontal-stretch: 1;
                            border-radius: Theme.r-s;
                            background: SettingsState.zones-layout == k ? Theme.sel : zl-ta.has-hover ? Theme.hover : Theme.card;
                            Label {
                                horizontal-alignment: center;
                                text: name;
                                font-size: 12px;
                            }
                            zl-ta := TipArea {
                                tip: @tr("Układ stref: ") + name;
                                clicked => {
                                    SettingsState.set-zones-layout(k);
                                }
                            }
                        }
                    }
                    Label {
                        text: @tr("Ikony");
                        font-size: 13px;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        for name[k] in [@tr("Małe"), @tr("Średnie"), @tr("Duże")]: Choice {
                            icon: Icons.grid;
                            text: name;
                            hint: k == 0 ? @tr("32 px, gęsta siatka") : k == 1 ? @tr("48 px – jak w Windows") : @tr("64 px, wyraźne");
                            on: SettingsState.desktop-icon-size == k;
                            clicked => {
                                SettingsState.set-desktop-icon-size(k);
                            }
                        }
                    }
                    ToggleRow {
                        icon: Icons.grid;
                        text: @tr("Wyrównuj ikony do siatki");
                        hint: @tr("Wyłączone – ikona zostaje dokładnie tam, gdzie ją puścisz; miejsca są zapamiętywane");
                        on: !SettingsState.desktop-free;
                        toggled => {
                            SettingsState.toggle("desktop-free");
                        }
                    }
                    ToggleRow {
                        icon: Icons.trash;
                        text: @tr("Kosz na pulpicie");
                        hint: @tr("Ikona z Windows (pusty albo pełny); prawy przycisk – Opróżnij Kosz");
                        on: SettingsState.desktop-recycle;
                        toggled => {
                            SettingsState.toggle("desktop-recycle");
                        }
                    }
                    ToggleRow {
                        icon: Icons.pc;
                        text: @tr("Ikona „Komputer”");
                        hint: @tr("Na pulpicie, z ikoną komputera z Windows – otwiera widok Komputer z dyskami i folderami");
                        on: SettingsState.desktop-computer;
                        toggled => {
                            SettingsState.toggle("desktop-computer");
                        }
                    }
                    Label {
                        text: @tr("Foldery przy krawędziach");
                        font-size: 13px;
                        font-weight: 600;
                    }
                    Label {
                        text: @tr("Wąski pasek przy brzegu ekranu – po najechaniu wysuwa się z zawartością folderu. Kilka paneli na jednej krawędzi dzieli ją po równo.");
                        font-size: 11.5px;
                        color: Theme.faint;
                        wrap: word-wrap;
                    }
                    for r[k] in SettingsState.edge-rows: Rectangle {
                        border-radius: Theme.r;
                        background: Theme.card;
                        height: er-lay.preferred-height;
                        er-lay := VerticalLayout {
                            padding: 10px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 8px;
                                Icon {
                                    y: (parent.height - self.height) / 2;
                                    commands: Icons.folder;
                                    size: 16px;
                                    color: Theme.dim;
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    Label {
                                        width: parent.width;
                                        text: r.name;
                                        font-size: 13px;
                                        font-weight: 600;
                                    }
                                    TipArea {
                                        tip: r.path;
                                    }
                                }
                                SetButton {
                                    text: @tr("Usuń");
                                    tip: @tr("Usuń panel z pulpitu (folder zostaje na dysku)");
                                    danger: true;
                                    clicked => {
                                        SettingsState.edge-remove(k);
                                    }
                                }
                            }
                            HorizontalLayout {
                                alignment: start;
                                spacing: 6px;
                                for name[e] in [@tr("Lewa"), @tr("Prawa"), @tr("Górna")]: SetButton {
                                    text: name;
                                    tip: name + @tr(" krawędź ekranu");
                                    on: r.edge == e;
                                    clicked => {
                                        SettingsState.edge-set-edge(k, e);
                                    }
                                }
                                if SettingsState.edge-monitors > 1: Rectangle {
                                    width: 10px;
                                }
                                for m in SettingsState.edge-monitors > 1 ? SettingsState.edge-monitors : 0: SetButton {
                                    text: @tr("Monitor ") + (m + 1);
                                    tip: @tr("Panel na monitorze ") + (m + 1);
                                    on: r.monitor == m;
                                    clicked => {
                                        SettingsState.edge-set-monitor(k, m);
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Label {
                                    text: @tr("Szerokość");
                                    font-size: 12.5px;
                                    color: Theme.dim;
                                }
                                // Suwak w obszarze podpowiedzi – najechanie na niego też ją pokazuje.
                                TipArea {
                                    horizontal-stretch: 1;
                                    tip: @tr("Szerokość wysuniętego panelu – można ją też zmienić, przeciągając jego wewnętrzną krawędź");
                                    Slider {
                                        width: parent.width;
                                        minimum: 160;
                                        maximum: 900;
                                        step: 10;
                                        value: r.width;
                                        changed(v) => {
                                            SettingsState.edge-set-width(k, round(v / 10) * 10);
                                        }
                                    }
                                }
                                Label {
                                    width: 52px;
                                    text: round(r.width) + " px";
                                    font-size: 12.5px;
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 6px;
                        for name[e] in [@tr("Dodaj z lewej…"), @tr("Dodaj z prawej…"), @tr("Dodaj u góry…")]: SetButton {
                            text: name;
                            tip: @tr("Wybierz folder i przypnij go do ") + (e == 0 ? "lewej" : e == 1 ? "prawej" : @tr("górnej")) + @tr(" krawędzi głównego monitora");
                            clicked => {
                                SettingsState.edge-add(e);
                            }
                        }
                    }
                    Label {
                        text: @tr("Tapeta");
                        font-size: 13px;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Choice {
                            icon: Icons.image;
                            text: @tr("Z Windows");
                            hint: @tr("Jak w Personalizacji");
                            on: SettingsState.wall-mode == 0;
                            clicked => {
                                SettingsState.set-wall-mode(0);
                            }
                        }
                        Choice {
                            icon: Icons.gallery;
                            text: @tr("Pokaz slajdów");
                            hint: @tr("Zdjęcia z folderu, każdy monitor inne");
                            on: SettingsState.wall-mode == 1;
                            clicked => {
                                SettingsState.set-wall-mode(1);
                            }
                        }
                        Choice {
                            icon: Icons.cloud;
                            text: @tr("Zdjęcie dnia");
                            hint: @tr("Bing – nowe codziennie");
                            on: SettingsState.wall-mode == 2;
                            clicked => {
                                SettingsState.set-wall-mode(2);
                            }
                        }
                    }
                    if SettingsState.wall-mode == 1: HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            width: wf.preferred-width + 24px;
                            height: 30px;
                            border-radius: Theme.r-s;
                            background: wf-ta.has-hover ? Theme.press : Theme.card;
                            wf := Label {
                                horizontal-alignment: center;
                                text: SettingsState.wall-folder == "" ? @tr("Wybierz folder…") : SettingsState.wall-folder;
                                font-size: 12.5px;
                            }
                            wf-ta := TipArea {
                                tip: @tr("Folder ze zdjęciami (z podfolderami)");
                                clicked => {
                                    SettingsState.pick-wall-folder();
                                }
                            }
                        }
                        for m in [5, 15, 30, 60]: Rectangle {
                            width: 60px;
                            height: 30px;
                            border-radius: Theme.r-s;
                            background: SettingsState.wall-minutes == m ? Theme.sel : wm-ta.has-hover ? Theme.hover : Theme.card;
                            Label {
                                horizontal-alignment: center;
                                text: m + " min";
                                font-size: 12px;
                            }
                            wm-ta := TipArea {
                                tip: @tr("Zmiana co ") + m + " minut";
                                clicked => {
                                    SettingsState.set-wall-minutes(m);
                                }
                            }
                        }
                    }
                    Label {
                        text: @tr("Własny obraz dla jednego monitora: prawy przycisk na pulpicie → Tapeta. Tapeta Windows i ekran blokady zostają bez zmian.");
                        wrap: word-wrap;
                        font-size: 12px;
                        color: Theme.faint;
                    }
                    Label {
                        text: @tr("Na każdym monitorze tapeta z ustawień Windows, na głównym ikony z Pulpitu użytkownika i publicznego – w siatce albo dowolnie, z przesuwaniem, zaznaczaniem i menu PowerDesk. Miejsca ikon zostają po aktualizacji i ponownym uruchomieniu. Ikony Windows są ukryte. Po zamknięciu PowerDesk, jego awarii albo odinstalowaniu pulpit Windows wraca.");
                        wrap: word-wrap;
                        font-size: 12.5px;
                        color: Theme.dim;
                    }
                }

                if SettingsState.section == 6: VerticalLayout {
                    spacing: 10px;
                    Heading {
                        title: @tr("Pasek zadań");
                        lead: @tr("PowerDesk zastępuje pasek zadań Windows na każdym monitorze");
                    }
                    Label {
                        text: @tr("Start, okna z danego monitora pogrupowane po programach (z podglądami), przypięte programy, sieć i Wi-Fi, głośność z mikserem, bateria, zegar z kalendarzem i „Pokaż pulpit” na końcu. Prawy przycisk na Start – menu z narzędziami systemu. Pasek Windows jest ukryty; wraca po zamknięciu PowerDesk, jego awarii albo odinstalowaniu. Alt+Tab, Win+Tab i Win+D zostają systemowe.");
                        wrap: word-wrap;
                        font-size: 12.5px;
                        color: Theme.dim;
                    }
                    Label {
                        text: @tr("Przyciski");
                        font-size: 13px;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Choice {
                            icon: Icons.sidebar;
                            text: @tr("Ikony z nazwami");
                            hint: @tr("Tytuł okna obok ikony");
                            on: SettingsState.taskbar-labels;
                            clicked => {
                                if (!SettingsState.taskbar-labels) {
                                    SettingsState.toggle("taskbar-labels");
                                }
                            }
                        }
                        Choice {
                            icon: Icons.grid;
                            text: @tr("Same ikony");
                            hint: @tr("Wąskie przyciski, jak w Windows 11");
                            on: !SettingsState.taskbar-labels;
                            clicked => {
                                if (SettingsState.taskbar-labels) {
                                    SettingsState.toggle("taskbar-labels");
                                }
                            }
                        }
                    }
                    ToggleRow {
                        icon: Icons.grid;
                        text: @tr("Automatycznie ukrywaj pasek");
                        hint: @tr("Pasek chowa się pod krawędź ekranu i wysuwa, gdy dotkniesz jej kursorem");
                        on: SettingsState.taskbar-autohide;
                        toggled => {
                            SettingsState.toggle("taskbar-autohide");
                        }
                    }
                    ToggleRow {
                        icon: Icons.grid;
                        text: @tr("Przyciski na środku paska");
                        hint: @tr("Start zostaje po lewej, programy w środku");
                        on: SettingsState.taskbar-center;
                        toggled => {
                            SettingsState.toggle("taskbar-center");
                        }
                    }
                    Label {
                        text: @tr("Grupowanie okien");
                        font-size: 13px;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        for g[k] in [@tr("Zawsze"), @tr("Gdy pasek jest pełny"), @tr("Nigdy")]: Choice {
                            icon: Icons.grid;
                            text: g;
                            hint: k == 0 ? @tr("Okna programu pod jednym przyciskiem") : k == 1 ? @tr("Osobno, dopóki się mieszczą") : @tr("Każde okno ma swój przycisk");
                            on: SettingsState.taskbar-group == k;
                            clicked => {
                                SettingsState.set-taskbar-group(k);
                            }
                        }
                    }
                    Label {
                        text: @tr("Wielkość ikon programów");
                        font-size: 13px;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 6px;
                        for px in [20, 24, 28, 32, 40, 48]: SetButton {
                            text: px + " px";
                            tip: @tr("Ikony programów ") + px + " px" + (px >= 40 ? @tr(" – wymaga wyższego paska (56–72 px)") : "");
                            on: SettingsState.taskbar-icon == px;
                            clicked => {
                                SettingsState.set-taskbar-icon(px);
                            }
                        }
                    }
                    Label {
                        text: @tr("Wysokość paska");
                        font-size: 13px;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 6px;
                        for hh in [36, 40, 44, 48, 56, 64, 72]: SetButton {
                            text: hh + " px";
                            tip: @tr("Pasek o wysokości ") + hh + " pikseli" + (hh == 48 ? @tr(" (domyślna)") : "");
                            on: SettingsState.taskbar-height == hh;
                            clicked => {
                                SettingsState.set-taskbar-height(hh);
                            }
                        }
                    }
                    Label {
                        text: @tr("Menu Start");
                        font-size: 13px;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        for st[k] in [@tr("Windows 10"), @tr("Windows 11"), @tr("Klasyczne")]: Choice {
                            icon: Icons.grid;
                            text: st;
                            hint: k == 0 ? @tr("Lista aplikacji i kafelki") : k == 1 ? @tr("Na środku, siatka aplikacji") : @tr("Wąska lista jak w Windows 7");
                            on: SettingsState.start-style == k;
                            clicked => {
                                SettingsState.set-start-style(k);
                            }
                        }
                    }
                    Label {
                        text: @tr("Przycisk Start");
                        font-size: 13px;
                        font-weight: 600;
                    }
                    Label {
                        text: SettingsState.start-image == "" ? @tr("Ikona PowerDesk. Możesz wybrać własny obraz (PNG, BMP) – pasek z klatkami jedna pod drugą: zwykły, pod kursorem, wciśnięty i opcjonalnie otwarty Start, jak przyciski Start z innych programów.") : SettingsState.start-image;
                        wrap: word-wrap;
                        font-size: 12px;
                        color: Theme.dim;
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 6px;
                        SetButton {
                            text: @tr("Wybierz obraz…");
                            tip: @tr("Plik z klatkami przycisku Start (PNG z przezroczystością najlepiej)");
                            clicked => {
                                SettingsState.pick-start-image();
                            }
                        }
                        if SettingsState.start-image != "": SetButton {
                            text: @tr("Przywróć ikonę PowerDesk");
                            tip: @tr("Usuń własny obraz przycisku Start");
                            clicked => {
                                SettingsState.clear-start-image();
                            }
                        }
                    }
                    if SettingsState.start-image != "": HorizontalLayout {
                        alignment: start;
                        spacing: 6px;
                        for f[k] in [@tr("Wykryj"), @tr("1 klatka"), @tr("2 klatki"), @tr("3 klatki"), @tr("4 klatki")]: SetButton {
                            text: f;
                            tip: k == 0 ? @tr("Liczba klatek z proporcji obrazu (kwadratowe klatki jedna pod drugą)") : k == 1 ? @tr("Jeden obraz – pod kursorem lekko przygasa") : k == 2 ? @tr("Zwykły i pod kursorem") : k == 3 ? @tr("Zwykły, pod kursorem, wciśnięty (najczęstszy format)") : @tr("Zwykły, pod kursorem, wciśnięty, otwarty Start");
                            on: SettingsState.start-frames == k;
                            clicked => {
                                SettingsState.set-start-frames(k);
                            }
                        }
                    }
                    Label {
                        text: @tr("Zegar i zasobnik");
                        font-size: 13px;
                        font-weight: 600;
                    }
                    ToggleRow {
                        icon: Icons.history;
                        text: @tr("Sekundy w zegarze");
                        on: SettingsState.taskbar-seconds;
                        toggled => {
                            SettingsState.toggle("taskbar-seconds");
                        }
                    }
                    ToggleRow {
                        icon: Icons.history;
                        text: @tr("Data pod godziną");
                        on: SettingsState.taskbar-date;
                        toggled => {
                            SettingsState.toggle("taskbar-date");
                        }
                    }
                    ToggleRow {
                        icon: Icons.grid;
                        text: @tr("Wszystkie ikony zasobnika na pasku");
                        hint: @tr("Wyłączone – wybrane ikony na pasku, reszta pod strzałką; ikonę przeciągniesz na strzałkę albo z okienka na pasek");
                        on: SettingsState.tray-all;
                        toggled => {
                            SettingsState.toggle("tray-all");
                        }
                    }
                    Label {
                        text: @tr("Krycie paska");
                        font-size: 13px;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Slider {
                            horizontal-stretch: 1;
                            minimum: 0;
                            maximum: 100;
                            step: 5;
                            value: SettingsState.taskbar-opacity;
                            changed(v) => {
                                SettingsState.set-taskbar-opacity(round(v / 5) * 5);
                            }
                        }
                        Label {
                            y: (parent.height - self.height) / 2;
                            width: 44px;
                            text: round(SettingsState.taskbar-opacity) + "%";
                            font-size: 12.5px;
                        }
                    }
                    Label {
                        text: "0% – przezroczysty (3% tła, żeby pasek dalej łapał kliknięcia), widać tapetę; ikony i zegar zostają";
                        font-size: 11.5px;
                        color: Theme.faint;
                    }
                    ToggleRow {
                        icon: Icons.desktop;
                        text: @tr("Przezroczysty, gdy widać pulpit");
                        hint: @tr("Osobno na każdym monitorze: bez otwartych okien pasek jest przezroczysty");
                        on: SettingsState.taskbar-clear-desktop;
                        toggled => {
                            SettingsState.toggle("taskbar-clear-desktop");
                        }
                    }
                    ToggleRow {
                        icon: Icons.eye;
                        text: @tr("Rozmycie pod paskiem");
                        hint: @tr("Półprzezroczysty pasek rozmywa tapetę i okna pod sobą (jak w Windows 11)");
                        on: SettingsState.taskbar-blur;
                        toggled => {
                            SettingsState.toggle("taskbar-blur");
                        }
                    }
                    ToggleRow {
                        icon: Icons.desktop;
                        text: @tr("Pasek zadań na każdym monitorze");
                        hint: @tr("Wyłączone – jeden pasek, tylko na monitorze głównym");
                        on: SettingsState.taskbar-all;
                        toggled => {
                            SettingsState.toggle("taskbar-all");
                        }
                    }
                    if SettingsState.taskbar-all: ToggleRow {
                        icon: Icons.desktop;
                        text: @tr("Przyciski wszystkich okien na każdym pasku");
                        hint: @tr("Wyłączone – przycisk okna jest na pasku monitora, na którym leży okno (przenosi się razem z oknem)");
                        on: SettingsState.taskbar-buttons-all;
                        toggled => {
                            SettingsState.toggle("taskbar-buttons-all");
                        }
                    }
                    ToggleRow {
                        icon: Icons.grid;
                        text: @tr("Przycisk pulpitów wirtualnych");
                        hint: @tr("Numer pulpitu na pasku, lista i nowy pulpit; kółko – sąsiedni pulpit (tylko z Eksploratorem)");
                        on: SettingsState.vd-button;
                        toggled => {
                            SettingsState.toggle("vd-button");
                        }
                    }
                }

                if SettingsState.section == 7: VerticalLayout {
                    spacing: 8px;
                    Heading {
                        title: @tr("System");
                        lead: @tr("PowerDesk zastępuje Eksplorator Windows · wpisy odnawiają się przy każdym starcie");
                    }
                    ToggleRow {
                        icon: Icons.min;
                        text: @tr("Krzyżyk chowa okno do zasobnika");
                        hint: @tr("Wyłączone – krzyżyk kończy PowerDesk (pulpit i pasek Windows wracają)");
                        on: SettingsState.close-to-tray;
                        toggled => {
                            SettingsState.toggle("close-to-tray");
                        }
                    }
                    ToggleRow {
                        icon: Icons.folder;
                        text: @tr("Pamiętaj karty po zamknięciu okna");
                        hint: @tr("Wyłączone – po zamknięciu okna folderów następne otwarcie (Ustawienia, folder z innego programu) pokazuje tylko to, co otwierasz; przypięte karty zostają");
                        on: SettingsState.remember-tabs;
                        toggled => {
                            SettingsState.toggle("remember-tabs");
                        }
                    }
                    ToggleRow {
                        icon: Icons.power;
                        text: @tr("Uruchamiaj razem z Windows");
                        hint: @tr("Po zalogowaniu PowerDesk od razu zastępuje pulpit, pasek zadań i menu Start (tylko zainstalowana kopia)");
                        on: SettingsState.autostart;
                        toggled => {
                            SettingsState.toggle("autostart");
                        }
                    }
                    if SettingsState.autostart: ToggleRow {
                        icon: Icons.power;
                        text: @tr("Okno folderów przy starcie z Windows");
                        hint: @tr("Wyłączone – po zalogowaniu tylko pulpit, pasek i ikona w zasobniku");
                        on: SettingsState.autostart-window;
                        toggled => {
                            SettingsState.toggle("autostart-window");
                        }
                    }
                    ToggleRow {
                        icon: Icons.folder;
                        text: @tr("Okna „Otwórz” i „Zapisz jako” PowerDesk");
                        hint: @tr("W innych programach zamiast okien Windows – z przypiętymi folderami. Wyłączone – zwykłe okna Windows");
                        on: SettingsState.file-dialogs;
                        toggled => {
                            SettingsState.toggle("file-dialogs");
                        }
                    }
                    for it in SettingsState.system: Rectangle {
                        height: 56px;
                        border-radius: Theme.r;
                        background: Theme.card;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 12px;
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: it.ok ? Theme.ok : Theme.rec;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                Label {
                                    text: it.name;
                                    font-size: 13px;
                                }
                                Label {
                                    text: it.detail;
                                    font-size: 11.5px;
                                    color: Theme.faint;
                                }
                            }
                            Label {
                                text: it.ok ? @tr("działa") : @tr("nie działa");
                                font-size: 12px;
                                color: it.ok ? Theme.dim : Theme.rec;
                            }
                        }
                    }
                    if SettingsState.system.length == 0: Label {
                        text: "Sprawdzam…";
                        font-size: 12px;
                        color: Theme.faint;
                    }
                    HorizontalLayout {
                        alignment: start;
                        Rectangle {
                            width: rp.preferred-width + 24px;
                            height: 30px;
                            border-radius: Theme.r-s;
                            background: rp-ta.has-hover ? Theme.press : Theme.card;
                            rp := Label {
                                horizontal-alignment: center;
                                text: @tr("Napraw");
                                font-size: 12.5px;
                            }
                            rp-ta := TipArea {
                                tip: @tr("Ustaw od nowa wpisy, które nie wskazują tego programu");
                                clicked => {
                                    SettingsState.repair-integration();
                                }
                            }
                        }
                    }
                    Label {
                        text: @tr("Instalacja");
                        font-size: 13px;
                        font-weight: 600;
                    }
                    Label {
                        text: SettingsState.installed ? SettingsState.install-place : @tr("PowerDesk nie jest zainstalowany (kopia z budowania). Instalacja: Program Files, skrót w menu Start, wpis w „Aplikacje i funkcje” i aktualizacje w tym samym miejscu.");
                        wrap: word-wrap;
                        font-size: 12px;
                        color: Theme.dim;
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        for b[k] in SettingsState.installed ? [@tr("Odinstaluj PowerDesk…")] : [@tr("Zainstaluj PowerDesk…")]: Rectangle {
                            width: ib.preferred-width + 24px;
                            height: 30px;
                            border-radius: Theme.r-s;
                            background: ib-ta.has-hover ? Theme.press : Theme.card;
                            ib := Label {
                                horizontal-alignment: center;
                                text: b;
                                font-size: 12.5px;
                                color: SettingsState.installed ? Theme.rec : Theme.text;
                            }
                            ib-ta := TipArea {
                                tip: SettingsState.installed ? @tr("Przywraca pulpit, pasek i Eksplorator Windows, usuwa program (ustawienia – na życzenie)") : @tr("Do Program Files – Windows zapyta o uprawnienia administratora");
                                clicked => {
                                    if (SettingsState.installed) {
                                        SettingsState.uninstall();
                                    } else {
                                        SettingsState.install(true);
                                    }
                                }
                            }
                        }
                    }
                    Label {
                        text: @tr("Aktualizacje");
                        font-size: 13px;
                        font-weight: 600;
                    }
                    ToggleRow {
                        icon: Icons.refresh;
                        text: @tr("Sprawdzaj aktualizacje automatycznie");
                        hint: @tr("Minutę po starcie i co 6 godzin – wydania PowerDesk z GitHuba");
                        on: SettingsState.update-check;
                        toggled => {
                            SettingsState.toggle("update-check");
                        }
                    }
                    if SettingsState.update-check: ToggleRow {
                        icon: Icons.refresh;
                        text: @tr("Pobieraj i instaluj bez pytania");
                        hint: @tr("Znaleziona wersja pobiera się w tle (z kontrolą sumy SHA-256) i PowerDesk uruchamia się ponownie. Wyłączone – powiadomienie z przyciskiem „Zaktualizuj”");
                        on: SettingsState.update-auto;
                        toggled => {
                            SettingsState.toggle("update-auto");
                        }
                    }
                    Label {
                        text: SettingsState.update-status;
                        wrap: word-wrap;
                        font-size: 12px;
                        color: Theme.dim;
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        SetButton {
                            text: @tr("Sprawdź teraz");
                            tip: @tr("Szuka nowej wersji PowerDesk");
                            clicked => {
                                SettingsState.update-check-now();
                            }
                        }
                        if SettingsState.update-ready: SetButton {
                            text: @tr("Pobierz i zainstaluj");
                            tip: @tr("Pobiera nową wersję, sprawdza sumę kontrolną i uruchamia PowerDesk ponownie");
                            clicked => {
                                SettingsState.update-install();
                            }
                        }
                    }
                    Label {
                        text: @tr("Działanie PowerDesk");
                        font-size: 13px;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        SetButton {
                            text: @tr("Uruchom ponownie PowerDesk");
                            tip: @tr("Zamyka i od razu uruchamia PowerDesk – pulpit i pasek wracają po chwili");
                            clicked => {
                                SettingsState.app-quit(0);
                            }
                        }
                        SetButton {
                            text: @tr("Zakończ PowerDesk");
                            danger: true;
                            tip: SettingsState.shell-mode ? @tr("PowerDesk jest powłoką – po zakończeniu strażnik uruchomi go ponownie") : @tr("Kończy PowerDesk – wracają pulpit, pasek i Eksplorator Windows");
                            clicked => {
                                SettingsState.app-quit(1);
                            }
                        }
                        if SettingsState.shell-mode: SetButton {
                            text: @tr("Przełącz na Eksplorator Windows");
                            danger: true;
                            tip: "Zdejmuje PowerDesk z powłoki systemu – po zakończeniu wraca explorer.exe";
                            clicked => {
                                SettingsState.app-quit(2);
                            }
                        }
                    }
                    Label {
                        text: "Okno zamyka się do zasobnika – PowerDesk działa dalej w tle. Zakończyć go można tylko tutaj. Przywrócenie Eksploratora: powerdesk.exe --remove-integration (robi to też deinstalator).";
                        wrap: word-wrap;
                        font-size: 12px;
                        color: Theme.faint;
                    }
                }

                if SettingsState.section == 8: VerticalLayout {
                    spacing: 2px;
                    Heading {
                        title: @tr("Skróty klawiszowe");
                        lead: @tr("Zgodne z Eksploratorem Windows tam, gdzie to możliwe");
                    }
                    for k in root.shortcuts: Key {
                        keys: k.keys;
                        what: k.what;
                    }
                }

                if SettingsState.section == 10: VerticalLayout {
                    spacing: 8px;
                    Heading {
                        title: @tr("Nakładka");
                        lead: @tr("FPS, czas klatki, procesor, karta graficzna i pamięć nad dowolnym programem");
                    }
                    ToggleRow {
                        icon: Icons.bolt;
                        text: @tr("Pokaż nakładkę");
                        kbd: "Alt+R";
                        hint: @tr("Działa w każdym programie i grze w oknie albo w oknie bez ramki");
                        on: SettingsState.overlay-on;
                        toggled => {
                            SettingsState.toggle("overlay");
                        }
                    }
                    ToggleRow {
                        icon: Icons.panel;
                        text: @tr("Pełna nakładka");
                        hint: @tr("Z wykresem czasu klatek, RAM i VRAM; wyłączone – tylko FPS, procesor i karta");
                        on: SettingsState.overlay-full;
                        toggled => {
                            SettingsState.toggle("overlay-full");
                        }
                    }
                    Label {
                        text: @tr("Miejsce na ekranie");
                        font-size: 13px;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        for c[k] in [@tr("Lewy górny róg"), @tr("Prawy górny róg"), @tr("Lewy dolny róg"), @tr("Prawy dolny róg")]: Choice {
                            icon: Icons.grid;
                            text: c;
                            on: SettingsState.overlay-corner == k;
                            clicked => {
                                SettingsState.set-overlay-corner(k);
                            }
                        }
                    }
                    ToggleRow {
                        icon: Icons.power;
                        text: @tr("Plan „Najwyższa wydajność” w grach");
                        hint: @tr("Gdy program zajmuje cały monitor; po wyjściu wraca poprzedni plan zasilania");
                        on: SettingsState.game-power;
                        toggled => {
                            SettingsState.toggle("game-power");
                        }
                    }
                    Label {
                        text: @tr("Limit klatek (karty NVIDIA)");
                        font-size: 13px;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        for f in [0, 30, 60, 90, 120, 144, 165, 240]: Rectangle {
                            height: 30px;
                            horizontal-stretch: 1;
                            border-radius: Theme.r-s;
                            background: SettingsState.fps-limit == f ? Theme.sel : fl-ta.has-hover ? Theme.hover : Theme.card;
                            Label {
                                horizontal-alignment: center;
                                text: f == 0 ? @tr("Bez") : f;
                                font-size: 12px;
                            }
                            fl-ta := TipArea {
                                tip: f == 0 ? @tr("Bez limitu klatek") : @tr("Najwyżej ") + f + @tr(" klatek na sekundę we wszystkich grach");
                                clicked => {
                                    SettingsState.set-fps-limit(f);
                                }
                            }
                        }
                    }
                    Label {
                        text: @tr("Ustawienie sterownika NVIDIA (jak „Maksymalna liczba klatek” w jego panelu) – działa we wszystkich grach, bez dodatków w samej grze. Zapis może wymagać uruchomienia PowerDesk jako administrator.");
                        wrap: word-wrap;
                        font-size: 12px;
                        color: Theme.faint;
                    }
                    Label {
                        text: @tr("Pomiar FPS");
                        font-size: 13px;
                        font-weight: 600;
                    }
                    Label {
                        text: SettingsState.fps-status;
                        wrap: word-wrap;
                        font-size: 12px;
                        color: SettingsState.fps-need-access ? Theme.rec : Theme.dim;
                    }
                    if SettingsState.fps-need-access: HorizontalLayout {
                        alignment: start;
                        Rectangle {
                            width: ga.preferred-width + 24px;
                            height: 30px;
                            border-radius: Theme.r-s;
                            background: ga-ta.has-hover ? Theme.press : Theme.card;
                            ga := Label {
                                horizontal-alignment: center;
                                text: @tr("Zezwól na pomiar FPS…");
                                font-size: 12.5px;
                            }
                            ga-ta := TipArea {
                                tip: @tr("Dopisuje Twoje konto do grupy „Użytkownicy dzienników wydajności” (raz, Windows zapyta o uprawnienia); działa po ponownym zalogowaniu");
                                clicked => {
                                    SettingsState.grant-fps();
                                }
                            }
                        }
                    }
                    Label {
                        text: @tr("FPS liczone ze zdarzeń systemowych Windows (jak PresentMon) – nic nie trafia do gry. DirectX 9–12, Vulkan i OpenGL. W grach w trybie „pełny ekran wyłączny” nakładka może być niewidoczna – wtedy tryb okna bez ramki. Temperatura karty – tylko NVIDIA.");
                        wrap: word-wrap;
                        font-size: 12px;
                        color: Theme.faint;
                    }
                }

                if SettingsState.section == 9: VerticalLayout {
                    spacing: 10px;
                    Heading {
                        title: @tr("O aplikacji");
                        lead: @tr("PowerDesk – menedżer plików, pulpit i pasek zadań dla Windows");
                    }
                    HorizontalLayout {
                        alignment: start;
                        Rectangle {
                            width: zp.preferred-width + 24px;
                            height: 30px;
                            border-radius: Theme.r-s;
                            background: zp-ta.has-hover ? Theme.press : Theme.card;
                            zp := Label {
                                horizontal-alignment: center;
                                text: @tr("Zgłoś problem…");
                                font-size: 12.5px;
                            }
                            zp-ta := TipArea {
                                tip: @tr("Kopiuje raport (wersja, system, dziennik) do schowka i otwiera folder z dziennikiem");
                                clicked => {
                                    SettingsState.report-problem();
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Label {
                            width: 120px;
                            text: @tr("Wersja");
                            font-size: 12.5px;
                            color: Theme.dim;
                        }
                        Label {
                            text: SettingsState.version;
                            font-size: 12.5px;
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Label {
                            width: 120px;
                            text: @tr("Ustawienia");
                            font-size: 12.5px;
                            color: Theme.dim;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            height: pp.preferred-height + 10px;
                            border-radius: Theme.r-s;
                            background: pp-ta.has-hover ? Theme.hover : transparent;
                            pp := Label {
                                x: 4px;
                                text: SettingsState.prefs-path;
                                font-size: 12px;
                                color: Theme.faint;
                            }
                            pp-ta := TipArea {
                                tip: @tr("Otwórz folder z ustawieniami");
                                clicked => {
                                    SettingsState.open-prefs-folder();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
