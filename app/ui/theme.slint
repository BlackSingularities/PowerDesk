// Tokeny wyglądu – te same wartości co w src/app.css (wersja webowa), żeby wygląd był 1:1.

export global Theme {
    in-out property <bool> light: false;
    /// Akcent użytkownika; domyślnie „mono” – biel w ciemnym, czerń w jasnym motywie.
    in-out property <color> accent-override: transparent;

    out property <color> bg: light ? #f6f6f7 : #000000;
    out property <color> panel: light ? #ffffff : #0b0b0b;
    out property <color> high: light ? #ececee : #161616;
    out property <color> higher: light ? #e2e2e5 : #1f1f1f;
    out property <color> card: light ? #0000000d : #ffffff0f;
    out property <color> hover: light ? #0000000d : #ffffff12;
    out property <color> press: light ? #0000001a : #ffffff1f;
    out property <color> sel: light ? #00000014 : #ffffff21;
    out property <color> sel-strong: light ? #00000024 : #ffffff33;
    out property <color> line: light ? #00000014 : #ffffff17;
    out property <color> line-strong: light ? #0000002e : #ffffff2e;
    out property <color> text: light ? #111111 : #ffffff;
    // Kryjące kolory zamiast przezroczystości – półprzezroczysty tekst wygładza się blado i nierówno.
    out property <color> dim: light ? #2e2e33 : #dcdce0;
    out property <color> faint: light ? #5c5c63 : #a8a8ae;
    out property <color> ghost: light ? #0000003d : #ffffff38;
    out property <color> accent: accent-override.alpha > 0 ? accent-override : (light ? #111111 : #ffffff);
    out property <color> on-accent: light ? #ffffff : #000000;
    out property <color> scroll: light ? #00000029 : #ffffff1f;
    out property <color> shadow: light ? #0000002e : #000000b3;
    out property <color> rec: #ff3b47;
    out property <color> ok: light ? #18a558 : #34d17a;
    out property <color> warn: light ? #c77d00 : #ffb547;
    out property <color> info: light ? #1f7ae0 : #5aa9ff;

    // Podświetlanie składni w panelu podglądu (kolejność jak `Tok` w syntax.rs).
    out property <color> syn-comment: light ? #6a737d : #7f8c98;
    out property <color> syn-string: light ? #0a7d4c : #7ec699;
    out property <color> syn-num: light ? #b45309 : #e5a663;
    out property <color> syn-key: light ? #9a1b8f : #d08fd6;
    out property <color> syn-type: light ? #1f6feb : #6cb6ff;
    out property <color> syn-punct: light ? #5c5c63 : #a8a8ae;
    out property <color> syn-tag: light ? #c0341d : #f08c7a;
    out property <color> syn-attr: light ? #946800 : #e6c07b;

    // Skala zaokrągleń: element wewnątrz ma promień = promień rodzica − odstęp.
    out property <length> r-xs: 4px;
    out property <length> r-s: 6px;
    out property <length> r: 8px;
    out property <length> r-l: 12px;
    out property <length> r-xl: 16px;

    out property <string> font: "Segoe UI Variable Text";
    out property <string> mono: "Cascadia Mono";
    out property <length> font-size: 13px;
}
