import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, IconButton, Label, TipArea, Drag } from "components.slint";

export struct TabData {
    title: string,
    icon: string,
    active: bool,
    pinned: bool,
    loading: bool,
    tip: string,
    path: string,
}

/// Pasek tytułu z kartami i przyciskami okna (TitleBar.svelte). Wysokość 42 px.
export component TitleBar inherits Rectangle {
    in property <[TabData]> tabs;
    in property <bool> maximized;
    callback activate(int);
    callback close-tab(int);
    /// Przeciągnięcie karty: numer karty i wskaźnik w poziomie (piksele paska).
    callback move-tab(int, length);
    callback tab-menu(int, length, length);
    callback new-tab;
    callback minimize;
    callback toggle-maximize;
    callback close-window;
    callback drag;
    /// Polecenia plików (bez ekranów specjalnych); widoczne tylko te, które mają sens.
    in property <bool> commands;
    in property <bool> has-selection;
    in property <bool> can-paste;
    callback new-menu(length, length);
    callback command(string);

    height: 42px;
    background: Theme.bg;

    // Puste miejsce paska przeciąga okno; podwójne kliknięcie maksymalizuje.
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.drag();
            }
        }
        double-clicked => {
            root.toggle-maximize();
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        spacing: 6px;

        strip := HorizontalLayout {
            spacing: 4px;
            alignment: start;
            for t[i] in root.tabs: Rectangle {
                y: (parent.height - 32px) / 2;
                height: 32px;
                width: t.pinned ? 40px : 210px;
                border-radius: Theme.r;
                background: Drag.active && Drag.target == t.path ? Theme.sel-strong : t.active ? Theme.higher : tab-ta.has-hover ? Theme.hover : transparent;
                animate background { duration: 120ms; }
                tab-ta := TipArea {
                    tip: t.pinned ? t.title + @tr(" – karta przypięta") : t.tip;
                    drop: t.path;
                    clicked => {
                        root.activate(i);
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.up && e.button == PointerEventButton.middle) {
                            root.close-tab(i);
                        }
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                            root.tab-menu(i, self.absolute-position.x + self.mouse-x, 38px);
                        }
                        // Puszczenie po przeciągnięciu w bok – karta ląduje w nowym miejscu.
                        if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left && abs((self.mouse-x - self.pressed-x) / 1px) > 12) {
                            root.move-tab(i, self.absolute-position.x + self.mouse-x - strip.absolute-position.x);
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 6px;
                    spacing: 8px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        commands: t.icon;
                        size: 15px;
                        color: t.active ? Theme.text : tab-ta.has-hover ? Theme.dim : Theme.faint;
                        opacity: 0.85;
                    }
                    if !t.pinned: Label {
                        horizontal-stretch: 1;
                        text: t.title;
                        color: t.active ? Theme.text : tab-ta.has-hover ? Theme.dim : Theme.faint;
                    }
                    if !t.pinned: Rectangle {
                        y: (parent.height - 22px) / 2;
                        width: 22px;
                        height: 22px;
                        border-radius: Theme.r-xs;
                        opacity: t.active || tab-ta.has-hover ? 1 : 0;
                        background: x-ta.has-hover ? Theme.press : transparent;
                        Icon {
                            commands: Icons.close;
                            size: 13px;
                            color: x-ta.has-hover ? Theme.text : Theme.dim;
                        }
                        x-ta := TipArea {
                            tip: @tr("Zamknij kartę (Ctrl+W)");
                            clicked => {
                                root.close-tab(i);
                            }
                        }
                    }
                }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.plus;
                tooltip: @tr("Nowa karta (Ctrl+T)");
                clicked => {
                    root.new-tab();
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        // Polecenia rosną w lewo od „Nowy” – pojawienie się ich nie przesuwa kart ani przycisków okna.
        if root.commands: HorizontalLayout {
            spacing: 2px;
            alignment: end;
            if root.has-selection: HorizontalLayout {
                spacing: 2px;
                for c in [
                    { id: "cut", icon: Icons.cut, tip: @tr("Wytnij (Ctrl+X)") },
                    { id: "copy", icon: Icons.copy, tip: @tr("Kopiuj (Ctrl+C)") },
                    { id: "rename", icon: Icons.edit, tip: @tr("Zmień nazwę (F2)") },
                    { id: "trash", icon: Icons.trash, tip: @tr("Do Kosza (Del)") },
                ]: IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: c.icon;
                    icon-size: 17px;
                    tooltip: c.tip;
                    clicked => {
                        root.command(c.id);
                    }
                }
            }
            if root.can-paste: IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.paste;
                icon-size: 17px;
                tooltip: @tr("Wklej (Ctrl+V)");
                clicked => {
                    root.command("paste");
                }
            }
            // Bez zaznaczenia – właściwości otwartego folderu.
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.info;
                icon-size: 17px;
                tooltip: root.has-selection ? @tr("Właściwości zaznaczenia (Alt+Enter)") : @tr("Właściwości tego folderu (Alt+Enter)");
                clicked => {
                    root.command("props");
                }
            }
            Rectangle {
                width: 11px;
                Rectangle {
                    width: 1px;
                    height: 18px;
                    background: Theme.line;
                }
            }
            // Przycisk „Nowy” (btn primary sm).
            Rectangle {
                y: (parent.height - 28px) / 2;
                height: 28px;
                width: new-row.preferred-width + 22px;
                border-radius: Theme.r-s;
                background: new-ta.has-hover ? Theme.accent.darker(0.1) : Theme.accent;
                new-row := HorizontalLayout {
                    x: 10px;
                    spacing: 6px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        commands: Icons.plus;
                        size: 15px;
                        color: Theme.on-accent;
                    }
                    Label {
                        text: @tr("Nowy");
                        color: Theme.on-accent;
                        font-weight: 600;
                    }
                }
                new-ta := TipArea {
                    tip: @tr("Nowy folder, plik lub dokument");
                    clicked => {
                        root.new-menu(self.absolute-position.x, self.absolute-position.y + 32px);
                    }
                }
            }
            Rectangle {
                width: 8px;
            }
        }

        HorizontalLayout {
            for b[i] in [
                { icon: Icons.min, size: 15px },
                { icon: root.maximized ? Icons.restore : Icons.max, size: 13px },
                { icon: Icons.close, size: 15px },
            ]: Rectangle {
                width: 46px;
                background: wb.has-hover ? (i == 2 ? #e81123 : Theme.hover) : transparent;
                Icon {
                    commands: b.icon;
                    size: b.size;
                    color: wb.has-hover ? (i == 2 ? #ffffff : Theme.text) : Theme.dim;
                }
                wb := TipArea {
                    tip: i == 0 ? @tr("Minimalizuj") : i == 1 ? (root.maximized ? @tr("Przywróć") : @tr("Maksymalizuj")) : @tr("Zamknij");
                    clicked => {
                        if (i == 0) {
                            root.minimize();
                        } else if (i == 1) {
                            root.toggle-maximize();
                        } else {
                            root.close-window();
                        }
                    }
                }
            }
        }
    }
}
