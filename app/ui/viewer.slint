import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, IconButton, Label, TipArea } from "components.slint";
import { ScrollView } from "std-widgets.slint";
import { PropSection } from "props.slint";
import { PlayerState, PlayerBar } from "player.slint";

export struct ViewerThumb {
    index: int,
    current: bool,
    img: image,
    has-img: bool,
}

/// Stan przeglądarki – dane podaje viewer.rs; zoom i przesuwanie żyją w samym komponencie.
export global ViewerState {
    in-out property <bool> open;
    in-out property <bool> fullscreen;
    in-out property <string> name;
    in-out property <string> path;
    in-out property <string> counter;
    in-out property <string> details;
    in-out property <image> img;
    in-out property <bool> has-img;
    in-out property <bool> loading;
    in-out property <bool> is-video;
    /// Obrót w krokach po 90° (0–3).
    in-out property <int> rotation;
    in-out property <[ViewerThumb]> thumbs;
    in-out property <[PropSection]> sections;
    in-out property <bool> info-open;
    in-out property <bool> slideshow;
    callback close;
    callback escape;
    callback step(int);
    callback go(int);
    callback first-last(bool);
    callback toggle-fullscreen;
    callback toggle-info;
    callback open-external;
}

/// Przycisk górnego paska przeglądarki (jasny na ciemnym tle).
component VButton inherits Rectangle {
    in property <string> icon;
    in property <string> tip;
    in property <bool> on;
    callback clicked;
    width: 34px;
    height: 34px;
    border-radius: Theme.r-s;
    background: root.on ? #ffffff2e : vb-ta.has-hover ? #ffffff1f : transparent;
    Icon {
        commands: root.icon;
        size: 17px;
        color: #ffffffe6;
    }
    vb-ta := TipArea {
        tip: root.tip;
        clicked => {
            root.clicked();
        }
    }
}

/// Przeglądarka zdjęć (Viewer.svelte) – zajmuje okno pod paskiem tytułu, w pełnym ekranie całe okno.
export component ViewerView inherits Rectangle {
    background: #0b0b0c;

    /// Skala: piksele logiczne na piksel obrazu; `fit` – dopasowanie do sceny.
    property <bool> fit: true;
    property <float> scale: 1;
    property <length> ox;
    property <length> oy;
    /// Film gra w przeglądarce – zamiast zdjęcia pokazujemy jego klatki.
    property <bool> playing-here: PlayerState.target == 2 && PlayerState.path == ViewerState.path;
    property <image> src: root.playing-here && PlayerState.has-frame ? PlayerState.frame : ViewerState.img;
    property <int> iw: root.src.width;
    property <int> ih: root.src.height;
    property <bool> turned: mod(ViewerState.rotation, 2) == 1;
    // Wymiary po obrocie – do dopasowania.
    property <float> rw: root.turned ? root.ih : root.iw;
    property <float> rh: root.turned ? root.iw : root.ih;
    property <float> fit-scale: root.rw > 0 && root.rh > 0 ? min(stage.width / 1px / root.rw, stage.height / 1px / root.rh, 1) : 1;
    property <float> eff: root.fit ? root.fit-scale : root.scale;

    public function reset() {
        root.fit = true;
        root.ox = 0;
        root.oy = 0;
    }
    /// Zoom wokół punktu (mx, my) sceny; `f` – mnożnik.
    function zoom-at(f: float, mx: length, my: length) {
        let old = root.eff;
        let new = clamp(old * f, min(root.fit-scale, 0.05), 16);
        // Punkt pod kursorem zostaje w miejscu.
        let cx = stage.width / 2 + root.ox;
        let cy = stage.height / 2 + root.oy;
        root.ox = mx - (mx - cx) * new / old - stage.width / 2;
        root.oy = my - (my - cy) * new / old - stage.height / 2;
        root.scale = new;
        root.fit = false;
    }
    function zoom-center(f: float) {
        root.zoom-at(f, stage.width / 2, stage.height / 2);
    }

    changed iw => {
        root.reset();
    }

    // Pokaz slajdów – co 4 s następne zdjęcie.
    Timer {
        interval: 4s;
        running: ViewerState.slideshow && !(root.playing-here && PlayerState.playing);
        triggered => {
            ViewerState.step(1);
        }
    }

    fs := FocusScope {
        init => {
            self.focus();
        }
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                ViewerState.escape();
            } else if (e.text == Key.F11) {
                ViewerState.toggle-fullscreen();
            } else if (e.text == " " && ViewerState.is-video) {
                if (root.playing-here) {
                    PlayerState.toggle();
                } else {
                    PlayerState.start(2, ViewerState.path);
                }
            } else if ((e.text == "m" || e.text == "M") && root.playing-here) {
                PlayerState.toggle-mute();
            } else if (e.text == Key.RightArrow || e.text == Key.PageDown || e.text == " ") {
                ViewerState.step(1);
            } else if (e.text == Key.LeftArrow || e.text == Key.PageUp || e.text == Key.Backspace) {
                ViewerState.step(-1);
            } else if (e.text == Key.Home) {
                ViewerState.first-last(false);
            } else if (e.text == Key.End) {
                ViewerState.first-last(true);
            } else if (e.text == "+" || e.text == "=") {
                root.zoom-center(1.25);
            } else if (e.text == "-") {
                root.zoom-center(0.8);
            } else if (e.text == "0") {
                root.reset();
            } else if (e.text == "1") {
                root.zoom-center(1 / root.eff);
            } else if (e.text == "r" || e.text == "R") {
                ViewerState.rotation = mod(ViewerState.rotation + (e.modifiers.shift ? 3 : 1), 4);
                root.reset();
            } else if (e.text == "i" || e.text == "I") {
                ViewerState.toggle-info();
            } else if (e.text == "s" || e.text == "S") {
                ViewerState.slideshow = !ViewerState.slideshow;
            } else if (e.text == Key.Return) {
                ViewerState.open-external();
            } else {
                return reject;
            }
            accept
        }

        VerticalLayout {
            // Górny pasek: powrót, nazwa, licznik; po prawej zoom, obrót, pokaz, informacje, pełny ekran.
            if !ViewerState.fullscreen || top-hover.has-hover: Rectangle {
                height: 50px;
                background: #00000066;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 4px;
                    VButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.back;
                        tip: "Wróć do listy (Esc)";
                        clicked => {
                            ViewerState.close();
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        padding-left: 6px;
                        Label {
                            text: ViewerState.name;
                            font-weight: 600;
                            color: #ffffff;
                        }
                        Label {
                            text: ViewerState.counter + "  ·  " + ViewerState.details;
                            font-size: 11.5px;
                            color: #ffffffa6;
                        }
                    }
                    VButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.minus;
                        tip: "Pomniejsz (−)";
                        clicked => {
                            root.zoom-center(0.8);
                        }
                    }
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 58px;
                        height: 34px;
                        border-radius: Theme.r-s;
                        background: pct-ta.has-hover ? #ffffff1f : transparent;
                        Label {
                            horizontal-alignment: center;
                            text: round(root.eff * 100) + "%";
                            font-size: 12px;
                            color: #ffffffe6;
                        }
                        pct-ta := TipArea {
                            tip: root.fit ? "Rzeczywisty rozmiar (1)" : "Dopasuj do okna (0)";
                            clicked => {
                                if (root.fit) {
                                    root.zoom-center(1 / root.eff);
                                } else {
                                    root.reset();
                                }
                            }
                        }
                    }
                    VButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.plus;
                        tip: "Powiększ (+)";
                        clicked => {
                            root.zoom-center(1.25);
                        }
                    }
                    VButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.refresh;
                        tip: "Obróć w prawo (R, Shift+R – w lewo)";
                        clicked => {
                            ViewerState.rotation = mod(ViewerState.rotation + 1, 4);
                            root.reset();
                        }
                    }
                    VButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.play;
                        tip: ViewerState.slideshow ? "Zatrzymaj pokaz slajdów (S)" : "Pokaz slajdów (S)";
                        on: ViewerState.slideshow;
                        clicked => {
                            ViewerState.slideshow = !ViewerState.slideshow;
                        }
                    }
                    VButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.info;
                        tip: "Informacje i EXIF (I)";
                        on: ViewerState.info-open;
                        clicked => {
                            ViewerState.toggle-info();
                        }
                    }
                    VButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.open;
                        tip: "Otwórz w domyślnym programie (Enter)";
                        clicked => {
                            ViewerState.open-external();
                        }
                    }
                    VButton {
                        y: (parent.height - self.height) / 2;
                        icon: ViewerState.fullscreen ? Icons.restore : Icons.max;
                        tip: ViewerState.fullscreen ? "Wyjdź z pełnego ekranu (F11)" : "Pełny ekran (F11)";
                        clicked => {
                            ViewerState.toggle-fullscreen();
                        }
                    }
                    VButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.close;
                        tip: "Zamknij przeglądarkę (Esc)";
                        clicked => {
                            ViewerState.close();
                        }
                    }
                }
            }
            HorizontalLayout {
                vertical-stretch: 1;
                // Scena ze zdjęciem.
                stage := Rectangle {
                    horizontal-stretch: 1;
                    clip: true;
                    if ViewerState.has-img || (root.playing-here && PlayerState.has-frame): Image {
                        width: root.iw * 1px * root.eff;
                        height: root.ih * 1px * root.eff;
                        x: (parent.width - self.width) / 2 + root.ox;
                        y: (parent.height - self.height) / 2 + root.oy;
                        source: root.src;
                        image-rendering: root.eff > 2 ? pixelated : smooth;
                        transform-rotation: ViewerState.rotation * 90deg;
                    }
                    if ViewerState.loading && !ViewerState.has-img: Label {
                        horizontal-alignment: center;
                        text: "Wczytuję…";
                        color: #ffffffa6;
                    }
                    pan := TouchArea {
                        mouse-cursor: root.fit ? default : (self.pressed ? grabbing : grab);
                        property <length> ox0;
                        property <length> oy0;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                self.ox0 = root.ox;
                                self.oy0 = root.oy;
                                fs.focus();
                            }
                            // Przesunięcie palcem (albo myszą) na dopasowanym zdjęciu:
                            // w poziomie – następne i poprzednie, w dół – zamknięcie.
                            if (e.kind == PointerEventKind.up && root.fit) {
                                self.swipe(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                            }
                        }
                        function swipe(dx: length, dy: length) {
                            if (abs(dy / 1px) > 140 && abs(dy / 1px) > 2 * abs(dx / 1px)) {
                                if (dy > 0px) {
                                    ViewerState.close();
                                }
                                return;
                            }
                            if (abs(dx / 1px) > 60) {
                                ViewerState.step(dx < 0px ? 1 : -1);
                            }
                        }
                        moved => {
                            if (self.pressed && !root.fit) {
                                root.ox = self.ox0 + self.mouse-x - self.pressed-x;
                                root.oy = self.oy0 + self.mouse-y - self.pressed-y;
                            }
                        }
                        double-clicked => {
                            if (root.fit) {
                                root.zoom-at(1 / root.eff, self.mouse-x, self.mouse-y);
                            } else {
                                root.reset();
                            }
                        }
                        scroll-event(e) => {
                            // Kółko – zoom do kursora; z Ctrl albo poziomo – następne / poprzednie.
                            if (e.modifiers.control || e.delta-x != 0) {
                                ViewerState.step(e.delta-y + e.delta-x > 0 ? -1 : 1);
                            } else if (e.delta-y != 0) {
                                root.zoom-at(e.delta-y > 0 ? 1.2 : 1 / 1.2, self.mouse-x, self.mouse-y);
                            }
                            accept
                        }
                    }
                    // Strzałki po bokach.
                    for side[i] in [-1, 1]: Rectangle {
                        x: i == 0 ? 12px : parent.width - self.width - 12px;
                        y: (parent.height - self.height) / 2;
                        width: 44px;
                        height: 44px;
                        border-radius: 22px;
                        background: arrow-ta.has-hover ? #ffffff33 : #0000004d;
                        opacity: arrow-ta.has-hover || pan.has-hover ? 1 : 0;
                        animate opacity { duration: 150ms; }
                        Icon {
                            commands: side < 0 ? Icons.back : Icons.fwd;
                            size: 20px;
                            color: #ffffff;
                        }
                        arrow-ta := TipArea {
                            tip: side < 0 ? "Poprzednie (←)" : "Następne (→)";
                            clicked => {
                                ViewerState.step(side);
                            }
                        }
                    }
                    if ViewerState.is-video && !root.playing-here: Rectangle {
                        width: 72px;
                        height: 72px;
                        border-radius: 36px;
                        background: play-ta.has-hover ? #ffffff4d : #00000080;
                        Icon {
                            commands: Icons.play;
                            size: 30px;
                            color: #ffffff;
                        }
                        play-ta := TipArea {
                            tip: "Odtwórz (spacja); Enter – w domyślnym odtwarzaczu";
                            clicked => {
                                PlayerState.start(2, ViewerState.path);
                            }
                        }
                    }
                    if root.playing-here: PlayerBar {
                        dark: true;
                        x: 16px;
                        y: parent.height - self.height - 16px;
                        width: parent.width - 32px;
                    }
                    if root.playing-here && PlayerState.error: Label {
                        text: "Nie udało się odtworzyć tego pliku – Enter otworzy go w domyślnym odtwarzaczu";
                        color: #ffffffd9;
                    }
                }
                // Informacje i EXIF.
                if ViewerState.info-open && !ViewerState.fullscreen: Rectangle {
                    width: 300px;
                    background: #000000;
                    ScrollView {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 6px;
                            alignment: start;
                            for sec in ViewerState.sections: VerticalLayout {
                                spacing: 5px;
                                padding-bottom: 8px;
                                HorizontalLayout {
                                    spacing: 7px;
                                    Icon {
                                        y: (parent.height - self.height) / 2;
                                        commands: sec.icon;
                                        size: 14px;
                                        color: #ffffffa6;
                                    }
                                    Label {
                                        text: sec.title;
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: #ffffff;
                                    }
                                }
                                for r in sec.rows: HorizontalLayout {
                                    spacing: 10px;
                                    Text {
                                        width: 110px;
                                        text: r.label;
                                        wrap: word-wrap;
                                        font-family: Theme.font;
                                        font-size: 11.5px;
                                        color: #ffffffa6;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: r.value;
                                        wrap: word-wrap;
                                        font-family: Theme.font;
                                        font-size: 11.5px;
                                        color: #ffffff;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // Pasek miniatur.
            if !ViewerState.fullscreen && ViewerState.thumbs.length > 1: Rectangle {
                height: 78px;
                background: #00000066;
                Flickable {
                    content-width: max(self.width, strip.preferred-width);
                    strip := HorizontalLayout {
                        x: max(0, (parent.width - self.preferred-width) / 2);
                        padding: 7px;
                        spacing: 6px;
                        for t in ViewerState.thumbs: Rectangle {
                            width: 64px;
                            height: 64px;
                            border-radius: Theme.r-s;
                            border-width: t.current ? 2px : 0;
                            border-color: #ffffff;
                            background: #ffffff14;
                            clip: true;
                            opacity: t.current || th-ta.has-hover ? 1 : 0.6;
                            if t.has-img: Image {
                                width: parent.width;
                                height: parent.height;
                                source: t.img;
                                image-fit: cover;
                            }
                            th-ta := TouchArea {
                                clicked => {
                                    ViewerState.go(t.index);
                                }
                            }
                        }
                    }
                }
            }
        }
        // W pełnym ekranie pasek pojawia się po najechaniu na górną krawędź.
        top-hover := TouchArea {
            y: 0;
            height: ViewerState.fullscreen ? 50px : 0;
            enabled: ViewerState.fullscreen;
        }
    }
}
