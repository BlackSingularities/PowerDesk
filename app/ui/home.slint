import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, Label, TipArea } from "components.slint";
import { ScrollView, LineEdit } from "std-widgets.slint";

export struct HomeDrive {
    name: string,
    path: string,
    detail: string,
    usage: float,
    icon: string,
}

export struct HomeFolder {
    name: string,
    path: string,
    icon: string,
    size: string,
    /// Rozmiar względem największego folderu (0–1); ujemny – jeszcze liczę.
    ratio: float,
}

export struct HomeFile {
    name: string,
    path: string,
    when: string,
    img: image,
    has-img: bool,
    media: bool,
}

/// Pomiar na karcie „Komputer”: procesor, pamięć, karta graficzna, sieć, bateria.
export struct HomeMetric {
    icon: string,
    label: string,
    value: string,
    detail: string,
    /// Pasek zajętości 0–1; ujemny – bez paska.
    bar: float,
    /// Ostatnia minuta (0–100, najstarsze pierwsze); pusta – bez wykresu.
    spark: [float],
}

/// Narzędzie systemu (Ustawienia, Menedżer urządzeń…) – `key` rozpoznaje home.rs.
export struct HomeTool {
    name: string,
    hint: string,
    icon: string,
    key: string,
}

/// Sekcja ekranu w kolejności z ustawień.
export struct HomeSection {
    key: string,
    title: string,
    shut: bool,
    first: bool,
    last: bool,
}

/// Transfer w toku, synchronizacja albo półka.
export struct HomeActivity {
    icon: string,
    title: string,
    detail: string,
    /// 0–1; ujemny – bez paska.
    progress: float,
    /// Dokąd prowadzi kliknięcie (puste – nigdzie).
    path: string,
}

/// Słupek wykresu zmian.
export struct HomeDay {
    label: string,
    count: int,
    ratio: float,
    today: bool,
}

/// Ekran „Komputer” (Home.svelte) – dane podaje home.rs.
export global HomeState {
    in-out property <bool> open;
    in-out property <[HomeDrive]> drives;
    in-out property <string> storage;
    in-out property <float> storage-usage;
    in-out property <[HomeFolder]> folders;
    in-out property <[HomeFile]> files;
    /// Filtr ostatnich plików: 0 – wszystkie, 1 – zdjęcia, 2 – dokumenty, 3 – wideo.
    in-out property <int> kind;
    in-out property <bool> files-loading: true;
    in-out property <string> host;
    in-out property <string> os;
    in-out property <string> cpu;
    in-out property <float> cpu-usage;
    in-out property <[float]> cpu-hist;
    in-out property <string> mem;
    in-out property <float> mem-usage;
    in-out property <string> uptime;
    in-out property <[HomeSection]> sections;
    in-out property <[HomeFolder]> favorites;
    in-out property <[HomeActivity]> activities;
    in-out property <[HomeDay]> days;
    in-out property <string> changes-note;
    in-out property <[HomeTool]> tools;
    in-out property <[HomeMetric]> metrics;
    /// Wiersz pod pomiarami: system i czas pracy.
    in-out property <string> sys-note;
    callback tool(string);
    callback drive-menu(string, length, length);
    callback move-section(string, int);
    callback toggle-section(string);
    callback go(string);
    callback go-new-tab(string);
    callback open-file(string);
    callback file-menu(string, length, length);
    callback set-kind(int);
    callback refresh-files;
}

component Card inherits Rectangle {
    in property <string> title;
    in property <string> note;
    border-radius: Theme.r-l;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.line;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        // Karta wyższa od treści (sąsiednia w rzędzie jest wyższa) – treść zostaje u góry.
        alignment: start;
        if root.title != "" || root.note != "": HorizontalLayout {
            Label {
                horizontal-stretch: 1;
                text: root.title;
                font-size: 13.5px;
                font-weight: 600;
            }
            Label {
                text: root.note;
                font-size: 11.5px;
                color: Theme.faint;
            }
        }
        @children
    }
}

component Bar inherits Rectangle {
    in property <float> value;
    /// Porównanie (rozmiary folderów) – zawsze kolor akcentu, bez ostrzeżeń.
    in property <bool> plain;
    height: 6px;
    border-radius: 3px;
    background: Theme.line;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.value, 0, 1);
        border-radius: 3px;
        background: root.plain ? Theme.accent : root.value > 0.92 ? Theme.rec : root.value > 0.8 ? Theme.warn : Theme.accent;
    }
}

/// Wykres ostatniej minuty: słupki na całą szerokość, stała liczba miejsc, najnowsze z prawej.
component Spark inherits Rectangle {
    in property <[float]> values;
    in property <int> slots: 20;
    height: 30px;
    for v[i] in root.values: Rectangle {
        property <length> step: root.width / root.slots;
        x: (root.slots - root.values.length + i) * self.step;
        y: root.height - self.height;
        width: max(1px, self.step - 2px);
        height: max(2px, root.height * clamp(v / 100, 0, 1));
        border-radius: 1px;
        background: Theme.accent.with-alpha(i == root.values.length - 1 ? 0.9 : 0.5);
    }
}

/// Kafelek pomiaru: ikona, nazwa i wartość, wykres albo pasek, szczegóły.
component Metric inherits Rectangle {
    in property <HomeMetric> m;
    height: 98px;
    border-radius: Theme.r;
    background: Theme.panel;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        alignment: start;
        HorizontalLayout {
            spacing: 8px;
            Icon {
                y: (parent.height - self.height) / 2;
                commands: root.m.icon;
                size: 15px;
                color: Theme.dim;
            }
            Label {
                horizontal-stretch: 1;
                text: root.m.label;
                font-size: 12px;
                color: Theme.dim;
            }
            Label {
                text: root.m.value;
                font-size: 13px;
                font-weight: 600;
            }
        }
        if root.m.spark.length > 0: Spark {
            values: root.m.spark;
        }
        if root.m.spark.length == 0 && root.m.bar >= 0: VerticalLayout {
            height: 30px;
            alignment: center;
            Bar {
                value: root.m.bar;
            }
        }
        Label {
            text: root.m.detail;
            font-size: 11px;
            color: Theme.faint;
        }
    }
}

/// Wiersz z ikoną, klikany (dysk, folder).
component LinkRow inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <string> value;
    in property <string> tip;
    in property <float> bar: -1;
    in property <bool> plain;
    callback clicked;
    callback middle;
    /// Prawy przycisk – punkt w oknie.
    callback menu(length, length);
    height: root.bar >= 0 ? 42px : 32px;
    border-radius: Theme.r-s;
    background: lr-ta.has-hover ? Theme.hover : transparent;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 10px;
        Icon {
            y: (parent.height - self.height) / 2;
            commands: root.icon;
            size: 17px;
            color: Theme.dim;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 5px;
            HorizontalLayout {
                spacing: 8px;
                Label {
                    horizontal-stretch: 1;
                    text: root.text;
                    font-size: 12.5px;
                }
                Label {
                    text: root.value;
                    font-size: 11.5px;
                    color: Theme.dim;
                }
            }
            if root.bar >= 0: Bar {
                value: root.bar;
                plain: root.plain;
            }
        }
    }
    lr-ta := TipArea {
        tip: root.tip;
        clicked => {
            root.clicked();
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.middle) {
                root.middle();
            }
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

/// Kafelek narzędzia systemu: ikona, nazwa i krótki opis.
component ToolTile inherits Rectangle {
    in property <HomeTool> tool;
    height: 52px;
    border-radius: Theme.r;
    background: tt-ta.has-hover ? Theme.hover : Theme.panel;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 10px;
        Icon {
            y: (parent.height - self.height) / 2;
            commands: root.tool.icon;
            size: 18px;
            color: tt-ta.has-hover ? Theme.accent : Theme.dim;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Label {
                text: root.tool.name;
                font-size: 12.5px;
            }
            Label {
                text: root.tool.hint;
                font-size: 10.5px;
                color: Theme.faint;
            }
        }
    }
    tt-ta := TipArea {
        tip: root.tool.name + " – " + root.tool.hint;
        clicked => {
            HomeState.tool(root.tool.key);
        }
    }
}

/// Mały przycisk z ikoną w nagłówku sekcji.
component HeadButton inherits Rectangle {
    in property <string> icon;
    in property <string> tip;
    in property <bool> enabled: true;
    callback clicked;
    width: 24px;
    height: 24px;
    border-radius: Theme.r-s;
    background: hb-ta.has-hover && root.enabled ? Theme.hover : transparent;
    Icon {
        commands: root.icon;
        size: 13px;
        color: !root.enabled ? Theme.line : hb-ta.has-hover ? Theme.text : Theme.faint;
    }
    hb-ta := TipArea {
        enabled: root.enabled;
        tip: root.tip;
        clicked => {
            root.clicked();
        }
    }
}

/// Nagłówek sekcji: klik zwija, strzałki zmieniają kolejność (widoczne po najechaniu).
component SectionHead inherits Rectangle {
    in property <HomeSection> sec;
    in property <string> note;
    height: 30px;
    border-radius: Theme.r-s;
    background: sh-ta.has-hover ? Theme.hover : transparent;
    sh-ta := TipArea {
        tip: root.sec.shut ? "Rozwiń sekcję" : "Zwiń sekcję";
        clicked => {
            HomeState.toggle-section(root.sec.key);
        }
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 4px;
        spacing: 6px;
        Icon {
            y: (parent.height - self.height) / 2;
            commands: root.sec.shut ? Icons.chevron : Icons.chevron-down;
            size: 12px;
            color: Theme.faint;
        }
        Label {
            text: root.sec.title;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.4px;
            color: sh-ta.has-hover ? Theme.text : Theme.dim;
        }
        Label {
            horizontal-stretch: 1;
            text: root.note;
            font-size: 11.5px;
            color: Theme.faint;
        }
        HeadButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.arrow-up;
            tip: "Przesuń sekcję wyżej";
            enabled: !root.sec.first;
            clicked => {
                HomeState.move-section(root.sec.key, -1);
            }
        }
        HeadButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.arrow-down;
            tip: "Przesuń sekcję niżej";
            enabled: !root.sec.last;
            clicked => {
                HomeState.move-section(root.sec.key, 1);
            }
        }
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked;
    height: 26px;
    width: ch.preferred-width + 22px;
    border-radius: 13px;
    background: root.on ? Theme.accent : ch-ta.has-hover ? Theme.hover : Theme.panel;
    ch := Label {
        horizontal-alignment: center;
        text: root.text;
        font-size: 12px;
        color: root.on ? Theme.on-accent : Theme.text;
    }
    ch-ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component HomeView inherits Rectangle {
    background: Theme.bg;
    /// Szerokość treści – widoczna część przewijanego obszaru (bez paska przewijania) bez marginesów.
    property <length> cols-w: sv.visible-width - 48px;
    /// Szeroko – karty obok siebie, wąsko – jedna pod drugą.
    property <bool> wide: sv.visible-width > 980px;
    property <int> per-row: max(1, floor((root.cols-w - 22px) / 130px));
    /// Kafelki narzędzi: co najmniej 190 px szerokości, rozciągnięte na cały wiersz.
    property <int> tools-per-row: max(1, floor((root.cols-w - 22px) / 200px));
    property <length> tool-w: (root.cols-w - 32px - (root.tools-per-row - 1) * 10px) / root.tools-per-row;
    /// Szeroko: Komputer, Dyski i Twoje foldery w trzech równych kolumnach.
    property <length> col-w: root.wide ? (root.cols-w - 32px) / 3 : root.cols-w;
    /// Kafelki pomiarów (co najmniej 220 px) rozciągnięte na szerokość karty Komputer.
    property <length> metric-area: root.col-w - 32px;
    property <int> metric-per-row: max(1, min(HomeState.metrics.length, floor((root.metric-area + 10px) / 230px)));
    property <length> metric-w: (root.metric-area - (root.metric-per-row - 1) * 10px) / root.metric-per-row;

    // Treść zawsze na szerokość okna (bez tego ScrollView brałby jej preferowaną szerokość
    // i ekran nie dopasowywał się przy zmianie rozmiaru); przewijanie tylko w pionie.
    sv := ScrollView {
        content-width: self.visible-width;
        content-height: max(body.preferred-height, self.visible-height);
        body := VerticalLayout {
            width: sv.visible-width;
            padding: 24px;
            spacing: 16px;
            alignment: start;

            // Sekcje w kolejności z ustawień; zwinięta zostawia sam nagłówek.
            for sec in HomeState.sections: VerticalLayout {
                spacing: 8px;
                SectionHead {
                    sec: sec;
                    note: sec.key == "changes" ? HomeState.changes-note : sec.key == "recent" ? "zmienione w ciągu 14 dni" : "";
                }
            // Pamięć, system i foldery – obok siebie na szerokim oknie.
            // Szeroko: Komputer, Dyski i Twoje foldery obok siebie, równe kolumny; wąsko – jedna pod drugą.
            if !sec.shut && sec.key == "overview": GridLayout {
                spacing: 16px;
                Card {
                    row: 0;
                    col: 0;
                    width: root.col-w;
                    title: "Komputer";
                    note: HomeState.host;
                    for row[r] in ceil(HomeState.metrics.length / root.metric-per-row): HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        for m[i] in HomeState.metrics: Metric {
                            visible: i >= r * root.metric-per-row && i < (r + 1) * root.metric-per-row;
                            width: self.visible ? root.metric-w : 0;
                            m: m;
                        }
                    }
                    Label {
                        text: HomeState.sys-note;
                        font-size: 11.5px;
                        color: Theme.faint;
                    }
                }
                    Card {
                        row: root.wide ? 0 : 1;
                        col: root.wide ? 1 : 0;
                        width: root.col-w;
                        title: "Dyski";
                        note: HomeState.storage;
                        for d in HomeState.drives: LinkRow {
                            icon: d.icon;
                            text: d.name;
                            value: d.detail;
                            bar: d.usage;
                            tip: d.path + " – kliknij, aby otworzyć";
                            clicked => {
                                HomeState.go(d.path);
                            }
                            middle => {
                                HomeState.go-new-tab(d.path);
                            }
                            menu(x, y) => {
                                HomeState.drive-menu(d.path, x, y);
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            if HomeState.drives.length > 0: Chip {
                                text: "Co zajmuje miejsce?";
                                clicked => {
                                    HomeState.go("ofp:space|" + HomeState.drives[0].path);
                                }
                            }
                            Chip {
                                text: "Mapuj dysk sieciowy…";
                                clicked => {
                                    HomeState.tool("map");
                                }
                            }
                        }
                    }
                    Card {
                        row: root.wide ? 0 : 2;
                        col: root.wide ? 2 : 0;
                        width: root.col-w;
                        title: "Twoje foldery";
                        for f in HomeState.folders: LinkRow {
                            icon: f.icon;
                            text: f.name;
                            value: f.ratio < 0 ? "liczę…" : f.size;
                            bar: max(f.ratio, 0);
                            plain: true;
                            tip: f.path;
                            clicked => {
                                HomeState.go(f.path);
                            }
                            middle => {
                                HomeState.go-new-tab(f.path);
                            }
                        }
                    }
            }

            // Przypięte foldery (te same co w panelu bocznym).
            if !sec.shut && sec.key == "favorites": Card {
                if HomeState.favorites.length == 0: Label {
                    text: "Przypnij folder z menu albo przeciągnij go na „Przypięte” w panelu bocznym";
                    font-size: 12px;
                    color: Theme.faint;
                    wrap: word-wrap;
                }
                for f in HomeState.favorites: LinkRow {
                    icon: f.icon;
                    text: f.name;
                    value: f.size;
                    tip: f.path;
                    clicked => {
                        HomeState.go(f.path);
                    }
                    middle => {
                        HomeState.go-new-tab(f.path);
                    }
                }
            }

            // Transfery w toku i synchronizacje.
            if !sec.shut && sec.key == "activity": Card {
                if HomeState.activities.length == 0: Label {
                    text: "Nic się teraz nie dzieje";
                    font-size: 12px;
                    color: Theme.faint;
                }
                for a in HomeState.activities: LinkRow {
                    icon: a.icon;
                    text: a.title;
                    value: a.detail;
                    bar: a.progress;
                    tip: a.path != "" ? a.title + " – kliknij, aby otworzyć" : a.title;
                    clicked => {
                        if (a.path != "") {
                            HomeState.go(a.path);
                        }
                    }
                }
            }

            // Wykres: ile plików zmieniło się w kolejnych dniach.
            if !sec.shut && sec.key == "changes": Card {
                if HomeState.days.length == 0: Label {
                    text: "Liczę…";
                    font-size: 12px;
                    color: Theme.faint;
                }
                if HomeState.days.length > 0: HorizontalLayout {
                    spacing: 6px;
                    height: 120px;
                    for d in HomeState.days: VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        Rectangle {
                            vertical-stretch: 1;
                            Rectangle {
                                y: parent.height - self.height;
                                height: d.count == 0 ? 2px : max(3px, parent.height * d.ratio);
                                border-radius: 3px;
                                background: d.today ? Theme.accent : Theme.accent.with-alpha(day-ta.has-hover ? 0.75 : 0.45);
                            }
                            day-ta := TipArea {
                                tip: d.label + ": " + d.count + (d.count == 1 ? " plik" : Math.mod(d.count, 10) >= 2 && Math.mod(d.count, 10) <= 4 && (Math.mod(d.count, 100) < 12 || Math.mod(d.count, 100) > 14) ? " pliki" : " plików");
                            }
                        }
                        Label {
                            horizontal-alignment: center;
                            text: d.label;
                            font-size: 10px;
                            color: d.today ? Theme.text : Theme.faint;
                        }
                    }
                }
            }

            // Narzędzia systemu – kafelki w rzędach.
            if !sec.shut && sec.key == "tools": Card {
                for row[r] in ceil(HomeState.tools.length / root.tools-per-row): HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    for t[i] in HomeState.tools: ToolTile {
                        visible: i >= r * root.tools-per-row && i < (r + 1) * root.tools-per-row;
                        width: self.visible ? root.tool-w : 0;
                        tool: t;
                    }
                }
            }

            // Ostatnie pliki z dwóch tygodni.
            if !sec.shut && sec.key == "recent": Card {
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    for k[i] in ["Wszystkie", "Zdjęcia", "Dokumenty", "Wideo"]: Chip {
                        text: k;
                        on: HomeState.kind == i;
                        clicked => {
                            HomeState.set-kind(i);
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: Theme.r-s;
                        background: rf-ta.has-hover ? Theme.hover : transparent;
                        Icon {
                            commands: Icons.refresh;
                            size: 14px;
                            color: Theme.dim;
                        }
                        rf-ta := TipArea {
                            tip: "Odśwież ostatnie pliki";
                            clicked => {
                                HomeState.refresh-files();
                            }
                        }
                    }
                }
                if HomeState.files.length == 0: Label {
                    text: HomeState.files-loading ? "Wczytywanie…" : "Brak plików zmienionych w ostatnich dwóch tygodniach";
                    font-size: 12px;
                    color: Theme.faint;
                }
                // Kafelki w rzędach – tyle, ile mieści się w szerokości.
                for row[r] in ceil(HomeState.files.length / root.per-row): HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    for f[i] in HomeState.files: Rectangle {
                        visible: i >= r * root.per-row && i < (r + 1) * root.per-row;
                        width: self.visible ? 120px : 0;
                        height: 150px;
                        border-radius: Theme.r;
                        background: tile-ta.has-hover ? Theme.hover : transparent;
                        VerticalLayout {
                            padding: 5px;
                            spacing: 4px;
                            Rectangle {
                                height: 100px;
                                border-radius: Theme.r-s;
                                background: Theme.panel;
                                clip: true;
                                if f.has-img: Image {
                                    width: parent.width;
                                    height: parent.height;
                                    source: f.img;
                                    image-fit: f.media ? cover : contain;
                                }
                                if !f.has-img: Icon {
                                    commands: Icons.file;
                                    size: 28px;
                                    color: Theme.faint;
                                }
                            }
                            Label {
                                text: f.name;
                                font-size: 11.5px;
                            }
                            Label {
                                text: f.when;
                                font-size: 10.5px;
                                color: Theme.faint;
                            }
                        }
                        tile-ta := TipArea {
                            tip: f.name + "\n" + f.path;
                            double-clicked => {
                                HomeState.open-file(f.path);
                            }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                                    HomeState.file-menu(f.path, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                    }
                }
            }
            }
        }
    }
}
