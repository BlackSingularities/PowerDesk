import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, Label } from "components.slint";
import { ScrollView } from "std-widgets.slint";

/// Widoczny element – Rust liczy układ i podaje tylko to, co mieści się w oknie (wirtualne przewijanie).
export struct VisItem {
    index: int,
    x: length,
    y: length,
    w: length,
    h: length,
    name: string,
    modified: string,
    kind: string,
    size: string,
    dir: bool,
    hidden: bool,
    media: bool,
    selected: bool,
    focused: bool,
    icon: image,
    has-icon: bool,
    thumb: image,
    has-thumb: bool,
}

/// Widok plików (FileView.svelte): lista, siatka, galeria.
export component FileView inherits Rectangle {
    in property <[VisItem]> items;
    in property <int> view;
    in property <length> total-height;
    in property <string> empty-text;
    in property <bool> sort-name;
    in property <bool> sort-modified;
    in property <bool> sort-type;
    in property <bool> sort-size;
    in property <bool> desc;
    in-out property <length> scroll-y;

    callback viewport-changed(length, length, length);
    callback select(int, bool, bool);
    callback open(int);
    callback context(int, length, length);
    callback background-click;
    callback header-sort(string);
    callback zoom(int);

    property <length> col-mod: 140px;
    property <length> col-type: 130px;
    property <length> col-size: 86px;

    VerticalLayout {
        // Nagłówek kolumn – tylko w widoku listy.
        if root.view == 0: Rectangle {
            height: 38px;
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                spacing: 12px;
                for h in [
                    { t: "Nazwa", id: "name", w: 0px, on: root.sort-name },
                    { t: "Zmodyfikowano", id: "modified", w: root.col-mod, on: root.sort-modified },
                    { t: "Typ", id: "type", w: root.col-type, on: root.sort-type },
                    { t: "Rozmiar", id: "size", w: root.col-size, on: root.sort-size },
                ]: Rectangle {
                    width: h.w > 0 ? h.w : self.preferred-width;
                    horizontal-stretch: h.w > 0 ? 0 : 1;
                    HorizontalLayout {
                        alignment: h.id == "size" ? end : start;
                        spacing: 4px;
                        Label {
                            text: h.t;
                            font-size: 12px;
                            color: h.on || head-ta.has-hover ? Theme.text : Theme.faint;
                        }
                        if h.on: Icon {
                            y: (parent.height - self.height) / 2;
                            commands: root.desc ? "M6 9l6 6 6-6" : "M18 15l-6-6-6 6";
                            size: 12px;
                            color: Theme.dim;
                        }
                    }
                    head-ta := TouchArea {
                        clicked => {
                            root.header-sort(h.id);
                        }
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line;
            }
        }

        sv := ScrollView {
            vertical-stretch: 1;
            content-height: max(self.visible-height, root.total-height);
            content-width: self.visible-width;
            content-y <=> root.scroll-y;
            changed viewport-y => {
                root.viewport-changed(-self.content-y, self.visible-width, self.visible-height);
            }
            changed visible-width => {
                root.viewport-changed(-self.content-y, self.visible-width, self.visible-height);
            }
            changed visible-height => {
                root.viewport-changed(-self.content-y, self.visible-width, self.visible-height);
            }

            TouchArea {
                width: sv.content-width;
                height: sv.content-height;
                clicked => {
                    root.background-click();
                }
                scroll-event(e) => {
                    if (e.modifiers.control) {
                        root.zoom(e.delta-y > 0 ? 1 : -1);
                        return accept;
                    }
                    reject
                }
            }

            for it in root.items: Rectangle {
                x: it.x;
                y: it.y;
                width: it.w;
                height: it.h;
                border-radius: root.view == 2 ? Theme.r-xs : Theme.r-s;
                clip: root.view == 2;
                background: it.selected ? Theme.sel : (ta.has-hover && root.view != 2) ? Theme.hover : transparent;
                border-width: it.focused ? (root.view == 2 ? 2px : 1px) : 0;
                border-color: Theme.line-strong;

                ta := TouchArea {
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                            root.select(it.index, e.modifiers.control, e.modifiers.shift);
                        }
                        if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                            root.context(it.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                    double-clicked => {
                        root.open(it.index);
                    }
                }

                // Lista.
                if root.view == 0: HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: 10px;
                        if it.has-icon: Image {
                            y: (parent.height - 18px) / 2;
                            width: 18px;
                            height: 18px;
                            source: it.icon;
                        }
                        if !it.has-icon: Icon {
                            y: (parent.height - self.height) / 2;
                            commands: it.dir ? Icons.folder : Icons.file;
                            color: Theme.dim;
                        }
                        Label {
                            text: it.name;
                            opacity: it.hidden ? 0.55 : 1;
                        }
                    }
                    Label {
                        width: root.col-mod;
                        text: it.modified;
                        color: Theme.dim;
                    }
                    Label {
                        width: root.col-type;
                        text: it.kind;
                        color: Theme.dim;
                    }
                    Label {
                        width: root.col-size;
                        text: it.size;
                        color: Theme.dim;
                        horizontal-alignment: right;
                    }
                }

                // Siatka: miniatura (contain) + podpis w dwóch liniach.
                if root.view == 1: VerticalLayout {
                    padding: 6px;
                    spacing: 6px;
                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: Theme.r-s;
                        clip: true;
                        background: it.media ? Theme.panel : transparent;
                        if it.has-thumb: Image {
                            width: 100%;
                            height: 100%;
                            source: it.thumb;
                            image-fit: contain;
                        }
                        if !it.has-thumb: Icon {
                            commands: it.dir ? Icons.folder : Icons.file;
                            size: min(parent.width, parent.height) * 0.45;
                            color: Theme.faint;
                        }
                    }
                    Text {
                        height: 30px;
                        text: it.name;
                        font-size: 12px;
                        color: Theme.text;
                        opacity: it.hidden ? 0.55 : 1;
                        horizontal-alignment: center;
                        vertical-alignment: top;
                        wrap: word-wrap;
                        overflow: elide;
                    }
                }

                // Galeria: miniatura (cover), zaznaczenie zmniejsza kafelek.
                if root.view == 2: Rectangle {
                    background: it.dir ? Theme.high : Theme.panel;
                    width: it.selected ? parent.width * 0.9 : parent.width;
                    height: it.selected ? parent.height * 0.9 : parent.height;
                    border-radius: it.selected ? Theme.r-s : 0;
                    clip: true;
                    animate width, height { duration: 200ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                    if it.has-thumb: Image {
                        width: 100%;
                        height: 100%;
                        source: it.thumb;
                        image-fit: it.media ? cover : contain;
                    }
                    if !it.has-thumb: Icon {
                        commands: it.dir ? Icons.folder : Icons.file;
                        size: min(parent.width, parent.height) * 0.4;
                        color: Theme.faint;
                    }
                    if ta.has-hover: Rectangle {
                        background: #ffffff1a;
                    }
                    if it.dir || !it.media: Rectangle {
                        y: parent.height - 34px;
                        height: 34px;
                        background: @linear-gradient(180deg, #00000000 0%, #000000b3 100%);
                        Label {
                            x: 10px;
                            width: parent.width - 20px;
                            y: 8px;
                            height: 20px;
                            text: it.name;
                            font-size: 12px;
                            color: #ffffff;
                        }
                    }
                }
                if root.view == 2 && it.selected: Rectangle {
                    x: 8px;
                    y: 8px;
                    width: 20px;
                    height: 20px;
                    border-radius: 10px;
                    background: Theme.accent;
                    Icon {
                        commands: Icons.check;
                        size: 13px;
                        color: Theme.on-accent;
                    }
                }
            }
        }
    }

    if root.items.length == 0 && root.empty-text != "": Label {
        horizontal-alignment: center;
        text: root.empty-text;
        color: Theme.faint;
    }
}
