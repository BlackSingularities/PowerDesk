import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, Label, TipArea, Drag } from "components.slint";
import { ScrollView } from "std-widgets.slint";
import { SettingsState } from "settings.slint";

/// Pole zmiany nazwy w miejscu: Enter zatwierdza, Esc anuluje, Tab / Shift+Tab przechodzi do sąsiada,
/// utrata fokusu zatwierdza. Na starcie zaznaczona jest nazwa bez rozszerzenia (`sel` – bajt końca).
component RenameBox inherits Rectangle {
    in property <string> text0;
    in property <int> sel;
    in property <length> font-size: Theme.font-size;
    callback commit(string);
    callback cancel;
    callback next(string, bool);
    property <bool> done;
    background: Theme.panel;
    border-radius: Theme.r-xs;
    border-width: 1px;
    border-color: Theme.line-strong;
    FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.done = true;
                root.cancel();
                return accept;
            }
            if (e.text == Key.Tab) {
                root.done = true;
                root.next(input.text, e.modifiers.shift);
                return accept;
            }
            reject
        }
        input := TextInput {
            x: 8px;
            width: parent.width - 16px;
            text: root.text0;
            single-line: true;
            vertical-alignment: center;
            font-family: Theme.font;
            font-size: root.font-size;
            color: Theme.text;
            selection-background-color: Theme.sel-strong;
            selection-foreground-color: Theme.text;
            init => {
                self.focus();
                self.set-selection-offsets(0, root.sel);
            }
            accepted => {
                root.done = true;
                root.commit(self.text);
            }
            changed has-focus => {
                if (!self.has-focus && !root.done) {
                    root.done = true;
                    root.commit(self.text);
                }
            }
        }
    }
}

/// Nagłówek grupy (ghead): strzałka zwija, etykieta zaznacza elementy grupy.
export struct GroupHead {
    index: int,
    x: length,
    y: length,
    w: length,
    label: string,
    count: int,
    shut: bool,
}

/// Kolumna listy: `id` to indeks w Col::ALL.
export struct Column {
    id: int,
    label: string,
    w: length,
    right: bool,
    sorted: bool,
}

/// Widoczny element – Rust liczy układ i podaje tylko to, co mieści się w oknie (wirtualne przewijanie).
export struct VisItem {
    index: int,
    x: length,
    y: length,
    w: length,
    h: length,
    name: string,
    path: string,
    /// Teksty kolumn w kolejności `columns`.
    cells: [string],
    dir: bool,
    hidden: bool,
    media: bool,
    selected: bool,
    focused: bool,
    renaming: bool,
    /// Podpowiedź jak w Eksploratorze: typ, rozmiar, daty, wymiary.
    tip: string,
    icon: image,
    has-icon: bool,
    thumb: image,
    has-thumb: bool,
}

/// Widok plików (FileView.svelte): lista, siatka, galeria.
export component FileView inherits Rectangle {
    in property <[VisItem]> items;
    in property <int> view;
    in property <length> total-height;
    in property <string> empty-text;
    in property <[Column]> columns;
    in property <[GroupHead]> heads;
    in property <bool> sort-name;
    in property <int> rename-sel;
    /// Bieżący folder – cel upuszczenia na tło listy.
    in property <string> folder;
    in property <bool> desc;
    in-out property <length> scroll-y;

    callback viewport-changed(length, length, length);
    callback select(int, bool, bool);
    callback open(int);
    callback context(int, length, length, bool);
    callback background-context(length, length, bool);
    callback marquee-begin(bool);
    callback marquee-update(length, length, length, length);
    callback marquee-end;
    callback header-sort(int);
    callback col-move(int, length);
    callback col-resize(int, length);
    callback col-resize-end;
    callback col-reset(int);
    callback col-menu(length, length);
    callback rename-commit(string);
    callback drag-start(int);
    callback toggle-group(int);
    callback select-group(int, bool);
    callback rename-cancel;
    callback rename-next(string, bool);
    callback zoom(int);

    // Przeciągany nagłówek kolumny i jego przesunięcie.
    property <int> drag-col: -1;
    property <length> drag-dx;

    // Zaznaczanie ramką (współrzędne w treści przewijanej).
    property <bool> mq-on;
    property <length> mq-x0;
    property <length> mq-y0;
    property <length> mq-x1;
    property <length> mq-y1;
    /// -1 / 1: wskaźnik przy górnej / dolnej krawędzi – widok przewija się sam.
    property <int> mq-edge;

    function mq-start(x: length, y: length, additive: bool) {
        mq-on = true;
        mq-x0 = x;
        mq-y0 = y;
        mq-x1 = x;
        mq-y1 = y;
        mq-edge = 0;
        root.marquee-begin(additive);
    }
    function mq-move(x: length, y: length) {
        if (!mq-on) {
            return;
        }
        mq-x1 = clamp(x, 0, sv.visible-width);
        mq-y1 = max(0, y);
        let vy = y + sv.content-y;
        mq-edge = vy > sv.visible-height - 24px ? 1 : vy < 24px ? -1 : 0;
        root.marquee-update(min(mq-x0, mq-x1), min(mq-y0, mq-y1), max(mq-x0, mq-x1), max(mq-y0, mq-y1));
    }
    function mq-stop() {
        if (mq-on) {
            mq-on = false;
            mq-edge = 0;
            root.marquee-end();
        }
    }

    // Płynne przewijanie kółkiem: cel przesuwa się o ruch kółka, a widok dochodzi do niego
    // w kilku klatkach (jak w przeglądarce) zamiast skakać o cały ząbek.
    property <bool> smooth-on;
    property <length> smooth-to;
    /// Ostatnio ustawione przez nas położenie – inna wartość znaczy, że ktoś przewinął inaczej
    /// (pasek przewijania, klawiatura), i wtedy animacja się kończy.
    property <length> smooth-at;
    function smooth-wheel(dy: length) {
        if (!root.smooth-on || abs(sv.content-y - root.smooth-at) > 1px) {
            root.smooth-to = sv.content-y;
        }
        root.smooth-to = clamp(root.smooth-to + dy * 1.25, min(0, sv.visible-height - sv.content-height), 0);
        root.smooth-at = sv.content-y;
        root.smooth-on = true;
    }
    Timer {
        interval: 8ms;
        running: root.smooth-on;
        triggered => {
            if (abs(sv.content-y - root.smooth-at) > 1px) {
                root.smooth-on = false;
                return;
            }
            let d = root.smooth-to - sv.content-y;
            if (abs(d) < 1px) {
                sv.content-y = root.smooth-to;
                root.smooth-on = false;
            } else {
                sv.content-y = sv.content-y + d * 0.22;
            }
            root.smooth-at = sv.content-y;
        }
    }

    Timer {
        interval: 30ms;
        running: root.mq-on && root.mq-edge != 0;
        triggered => {
            let old = sv.content-y;
            sv.content-y = clamp(sv.content-y - 18px * root.mq-edge, min(0, sv.visible-height - sv.content-height), 0);
            root.mq-y1 = max(0, root.mq-y1 + old - sv.content-y);
            root.marquee-update(min(root.mq-x0, root.mq-x1), min(root.mq-y0, root.mq-y1), max(root.mq-x0, root.mq-x1), max(root.mq-y0, root.mq-y1));
        }
    }

    VerticalLayout {
        // Nagłówek kolumn – tylko w widoku listy: klik sortuje, przeciągnięcie przenosi, krawędź zmienia szerokość.
        if root.view == 0: Rectangle {
            height: 38px;
            TouchArea {
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                        root.col-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
            }
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                spacing: 12px;
                Rectangle {
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        alignment: start;
                        spacing: 4px;
                        Label {
                            text: "Nazwa";
                            font-size: 12px;
                            color: root.sort-name || name-ta.has-hover ? Theme.text : Theme.faint;
                        }
                        if root.sort-name: Icon {
                            y: (parent.height - self.height) / 2;
                            commands: root.desc ? "M6 9l6 6 6-6" : "M18 15l-6-6-6 6";
                            size: 12px;
                            color: Theme.dim;
                        }
                    }
                    name-ta := TipArea {
                        tip: "Sortuj według nazwy";
                        clicked => {
                            root.header-sort(-1);
                        }
                    }
                }
                for c in root.columns: Rectangle {
                    width: c.w;
                    property <bool> dragging: root.drag-col == c.id && abs(root.drag-dx) > 5px;
                    Rectangle {
                        x: parent.dragging ? root.drag-dx : 0;
                        width: parent.width;
                        border-radius: Theme.r-xs;
                        background: parent.dragging ? Theme.high : transparent;
                        opacity: parent.dragging ? 0.9 : 1;
                        HorizontalLayout {
                            alignment: c.right ? end : start;
                            spacing: 4px;
                            Label {
                                text: c.label;
                                font-size: 12px;
                                color: c.sorted || head-ta.has-hover ? Theme.text : Theme.faint;
                            }
                            if c.sorted: Icon {
                                y: (parent.height - self.height) / 2;
                                commands: root.desc ? "M6 9l6 6 6-6" : "M18 15l-6-6-6 6";
                                size: 12px;
                                color: Theme.dim;
                            }
                        }
                    }
                    head-ta := TipArea {
                        tip: "Kliknij, aby sortować · przeciągnij, aby przenieść · prawy przycisk: kolumny";
                        pointer-event(e) => {
                            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                                root.drag-col = c.id;
                                root.drag-dx = 0;
                            }
                            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.drag-col == c.id) {
                                if (abs(root.drag-dx) > 5px) {
                                    root.col-move(c.id, root.drag-dx);
                                } else {
                                    root.header-sort(c.id);
                                }
                                root.drag-col = -1;
                                root.drag-dx = 0;
                            }
                            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                root.col-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                        moved => {
                            if (self.pressed && root.drag-col == c.id) {
                                root.drag-dx = self.mouse-x - self.pressed-x;
                            }
                        }
                    }
                    // Uchwyt szerokości na prawej krawędzi – cienka kreska rozdziela kolumny.
                    Rectangle {
                        x: parent.width + 3px;
                        y: 10px;
                        width: 6px;
                        height: parent.height - 20px;
                        Rectangle {
                            x: 2px;
                            width: 1px;
                            background: grip-ta.has-hover || grip-ta.pressed ? Theme.line-strong : Theme.line;
                        }
                        grip-ta := TipArea {
                            tip: "Przeciągnij, aby zmienić szerokość · dwuklik: domyślna";
                            mouse-cursor: MouseCursor.col-resize;
                            property <length> w0;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) {
                                    self.w0 = c.w;
                                }
                                if (e.kind == PointerEventKind.up) {
                                    root.col-resize-end();
                                }
                            }
                            moved => {
                                if (self.pressed) {
                                    root.col-resize(c.id, self.w0 + self.mouse-x - self.pressed-x);
                                }
                            }
                            double-clicked => {
                                root.col-reset(c.id);
                            }
                        }
                    }
                }
            }
            // Przycisk wyboru kolumn (colbtn).
            Rectangle {
                x: parent.width - 22px;
                y: (parent.height - 22px) / 2;
                width: 22px;
                height: 22px;
                border-radius: Theme.r-xs;
                background: colbtn-ta.has-hover ? Theme.hover : transparent;
                Icon {
                    commands: Icons.more;
                    size: 14px;
                    color: colbtn-ta.has-hover ? Theme.text : Theme.ghost;
                }
                colbtn-ta := TipArea {
                    tip: "Kolumny";
                    clicked => {
                        root.col-menu(self.absolute-position.x, self.absolute-position.y + 24px);
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line;
            }
        }

        sv := ScrollView {
            vertical-stretch: 1;
            content-height: max(self.visible-height, root.total-height);
            content-width: self.visible-width;
            content-y <=> root.scroll-y;
            changed viewport-y => {
                root.viewport-changed(-self.content-y, self.visible-width, self.visible-height);
            }
            changed visible-width => {
                root.viewport-changed(-self.content-y, self.visible-width, self.visible-height);
            }
            changed visible-height => {
                root.viewport-changed(-self.content-y, self.visible-width, self.visible-height);
            }

            TipArea {
                width: sv.content-width;
                height: sv.content-height;
                drop: root.folder;
                moved => {
                    root.mq-move(self.mouse-x, self.mouse-y);
                }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                        root.mq-start(self.mouse-x, self.mouse-y, e.modifiers.control || e.modifiers.shift);
                    }
                    if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                        root.mq-stop();
                    }
                    if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                        root.background-context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, e.modifiers.shift);
                    }
                }
                scroll-event(e) => {
                    if (e.modifiers.control) {
                        root.zoom(e.delta-y > 0 ? 1 : -1);
                        return accept;
                    }
                    if (e.delta-y != 0 && e.delta-x == 0) {
                        root.smooth-wheel(e.delta-y);
                        return accept;
                    }
                    reject
                }
            }

            for g in root.heads: Rectangle {
                x: g.x;
                y: g.y;
                width: g.w;
                height: 38px;
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    Rectangle {
                        y: 7px;
                        width: 24px;
                        height: 24px;
                        border-radius: Theme.r-xs;
                        background: chev-ta.has-hover ? Theme.hover : transparent;
                        Icon {
                            commands: g.shut ? Icons.chevron : Icons.chevron-down;
                            size: 14px;
                            color: chev-ta.has-hover ? Theme.text : Theme.faint;
                        }
                        chev-ta := TipArea {
                            tip: g.shut ? "Rozwiń grupę" : "Zwiń grupę";
                            clicked => {
                                root.toggle-group(g.index);
                            }
                        }
                    }
                    Rectangle {
                        y: 6px;
                        height: 26px;
                        width: glabel.preferred-width + 16px;
                        border-radius: Theme.r-xs;
                        background: glabel-ta.has-hover ? Theme.hover : transparent;
                        glabel := HorizontalLayout {
                            x: 8px;
                            spacing: 8px;
                            Label {
                                text: g.label;
                                font-weight: 600;
                            }
                            Label {
                                text: g.count;
                                font-size: 11px;
                                font-weight: 500;
                                color: Theme.ghost;
                            }
                        }
                        glabel-ta := TipArea {
                            tip: "Zaznacz elementy grupy (Ctrl – dodaj)";
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                    root.select-group(g.index, e.modifiers.control);
                                }
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        Rectangle {
                            x: 6px;
                            width: parent.width - 6px;
                            height: 1px;
                            background: Theme.line;
                        }
                    }
                }
            }

            // Puste sloty (szerokość 0) nie są rysowane.
            for it in root.items: Rectangle {
                visible: it.w > 0;
                x: it.x;
                y: it.y;
                width: it.w;
                height: it.h;
                border-radius: root.view == 2 ? Theme.r-xs : Theme.r-s;
                clip: root.view == 2;
                background: self.drop-here ? Theme.sel-strong : it.selected ? Theme.sel : (ta.has-hover && root.view != 2) ? Theme.hover : transparent;
                border-width: self.drop-here ? 2px : it.focused ? (root.view == 2 ? 2px : 1px) : 0;
                border-color: self.drop-here ? Theme.accent : Theme.line-strong;

                // Szerokość ikony z nazwą na liście – poza nią przeciąganie zaczyna ramkę (jak w Eksploratorze).
                probe := Label {
                    visible: false;
                    text: root.view == 0 ? it.name : "";
                }
                property <length> name-end: 12px + 18px + 10px + probe.preferred-width + 8px;

                property <bool> drop-here: Drag.active && it.dir && Drag.target == it.path;
                ta := TipArea {
                    tip: it.tip;
                    drop: it.dir ? it.path : root.folder;
                    // Przeciąganie zaczyna się po 6 px ruchu z wciśniętym przyciskiem (nie przy ramce i zmianie nazwy).
                    property <bool> dragged;
                    // Kółko nad plikiem – to samo płynne przewijanie co nad tłem (i Ctrl – wielkość).
                    scroll-event(e) => {
                        if (e.modifiers.control) {
                            root.zoom(e.delta-y > 0 ? 1 : -1);
                            return accept;
                        }
                        if (e.delta-y != 0 && e.delta-x == 0) {
                            root.smooth-wheel(e.delta-y);
                            return accept;
                        }
                        reject
                    }
                    moved => {
                        root.mq-move(it.x + self.mouse-x, it.y + self.mouse-y);
                        if (self.pressed && !root.mq-on && !self.dragged && !it.renaming && abs(self.mouse-x - self.pressed-x) + abs(self.mouse-y - self.pressed-y) > 6px) {
                            self.dragged = true;
                            root.drag-start(it.index);
                        }
                    }
                    changed pressed => {
                        if (self.pressed) {
                            self.dragged = false;
                        }
                    }
                    // Jedno kliknięcie bez Ctrl/Shift/Alt otwiera (ustawienie); zapamiętane przy wciśnięciu.
                    property <bool> plain;
                    clicked => {
                        if (SettingsState.single-click && self.plain && !self.dragged && !it.renaming) {
                            root.open(it.index);
                        }
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                            self.plain = !e.modifiers.control && !e.modifiers.shift && !e.modifiers.alt && !(root.view == 0 && self.mouse-x > parent.name-end);
                            if ((root.view == 0 && self.mouse-x > parent.name-end) || e.modifiers.alt) {
                                root.mq-start(it.x + self.mouse-x, it.y + self.mouse-y, e.modifiers.control || e.modifiers.shift);
                            } else {
                                root.select(it.index, e.modifiers.control, e.modifiers.shift);
                            }
                        }
                        if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                            root.mq-stop();
                        }
                        if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                            root.context(it.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, e.modifiers.shift);
                        }
                    }
                    double-clicked => {
                        if (!SettingsState.single-click) {
                            root.open(it.index);
                        }
                    }
                }

                // Lista.
                if root.view == 0: HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: 10px;
                        if it.has-icon: Image {
                            y: (parent.height - 18px) / 2;
                            width: 18px;
                            height: 18px;
                            source: it.icon;
                        }
                        if !it.has-icon: Icon {
                            y: (parent.height - self.height) / 2;
                            commands: it.dir ? Icons.folder : Icons.file;
                            color: Theme.dim;
                        }
                        if !it.renaming: Label {
                            text: it.name;
                            opacity: it.hidden ? 0.55 : 1;
                        }
                        if it.renaming: RenameBox {
                            y: 3px;
                            height: parent.height - 6px;
                            horizontal-stretch: 1;
                            text0: it.name;
                            sel: root.rename-sel;
                            commit(t) => {
                                root.rename-commit(t);
                            }
                            cancel => {
                                root.rename-cancel();
                            }
                            next(t, back) => {
                                root.rename-next(t, back);
                            }
                        }
                    }
                    for cell[ci] in it.cells: Label {
                        width: ci < root.columns.length ? root.columns[ci].w : 0;
                        text: cell;
                        color: Theme.dim;
                        horizontal-alignment: ci < root.columns.length && root.columns[ci].right ? right : left;
                    }
                }

                // Siatka: miniatura (contain) + podpis w dwóch liniach.
                if root.view == 1: VerticalLayout {
                    padding: 6px;
                    spacing: 6px;
                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: Theme.r-s;
                        clip: true;
                        background: it.media ? Theme.panel : transparent;
                        if it.has-thumb: Image {
                            width: 100%;
                            height: 100%;
                            source: it.thumb;
                            image-fit: contain;
                        }
                        if !it.has-thumb: Icon {
                            commands: it.dir ? Icons.folder : Icons.file;
                            size: min(parent.width, parent.height) * 0.45;
                            color: Theme.faint;
                        }
                    }
                    Text {
                        height: 30px;
                        text: it.name;
                        font-size: 12px;
                        color: Theme.text;
                        opacity: it.hidden ? 0.55 : 1;
                        horizontal-alignment: center;
                        vertical-alignment: top;
                        wrap: word-wrap;
                        overflow: elide;
                    }
                }

                // Galeria: miniatura (cover), zaznaczenie zmniejsza kafelek.
                if root.view == 2: Rectangle {
                    background: it.dir ? Theme.high : Theme.panel;
                    width: it.selected ? parent.width * 0.9 : parent.width;
                    height: it.selected ? parent.height * 0.9 : parent.height;
                    border-radius: it.selected ? Theme.r-s : 0;
                    clip: true;
                    animate width, height { duration: 200ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                    if it.has-thumb: Image {
                        width: 100%;
                        height: 100%;
                        source: it.thumb;
                        image-fit: it.media ? cover : contain;
                    }
                    if !it.has-thumb: Icon {
                        commands: it.dir ? Icons.folder : Icons.file;
                        size: min(parent.width, parent.height) * 0.4;
                        color: Theme.faint;
                    }
                    if ta.has-hover: Rectangle {
                        background: #ffffff1a;
                    }
                    if it.dir || !it.media: Rectangle {
                        y: parent.height - 34px;
                        height: 34px;
                        background: @linear-gradient(180deg, #00000000 0%, #000000b3 100%);
                        Label {
                            x: 10px;
                            width: parent.width - 20px;
                            y: 8px;
                            height: 20px;
                            text: it.name;
                            font-size: 12px;
                            color: #ffffff;
                        }
                    }
                }
                // Siatka i galeria: pole nazwy na dole kafelka.
                if it.renaming && root.view != 0: RenameBox {
                    x: 4px;
                    y: parent.height - 32px;
                    width: parent.width - 8px;
                    height: 28px;
                    font-size: 12px;
                    text0: it.name;
                    sel: root.rename-sel;
                    commit(t) => {
                        root.rename-commit(t);
                    }
                    cancel => {
                        root.rename-cancel();
                    }
                    next(t, back) => {
                        root.rename-next(t, back);
                    }
                }
                if root.view == 2 && it.selected: Rectangle {
                    x: 8px;
                    y: 8px;
                    width: 20px;
                    height: 20px;
                    border-radius: 10px;
                    background: Theme.accent;
                    Icon {
                        commands: Icons.check;
                        size: 13px;
                        color: Theme.on-accent;
                    }
                }
            }

            if root.mq-on: Rectangle {
                x: min(root.mq-x0, root.mq-x1);
                y: min(root.mq-y0, root.mq-y1);
                width: abs(root.mq-x1 - root.mq-x0);
                height: abs(root.mq-y1 - root.mq-y0);
                background: Theme.hover;
                border-width: 1px;
                border-color: Theme.ghost;
                border-radius: 4px;
            }
        }
    }

    // Upuszczenie do bieżącego folderu – obwódka dookoła widoku.
    if Drag.active && Drag.target == root.folder && root.folder != "": Rectangle {
        border-radius: Theme.r;
        border-width: 2px;
        border-color: Theme.accent;
    }

    if root.items.length == 0 && root.empty-text != "": Label {
        horizontal-alignment: center;
        text: root.empty-text;
        color: Theme.faint;
    }
}
