import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, Label, Tip, TipArea, Drag } from "components.slint";
import { TitleBar, TabData } from "titlebar.slint";
import { Sidebar, SideItem } from "sidebar.slint";
import { Toolbar, Crumb, FacetChip, FacetRow, FacetPanel, AddrSugg } from "toolbar.slint";
import { FileView, VisItem, Column, GroupHead } from "fileview.slint";
import { MenuPopup, MenuEntry } from "menu.slint";
import { TransferStack, OpItem, ToastItem, ConflictDialog, ConflictRow, ConfirmDialog, PromptDialog, Prompt } from "overlays.slint";
import { BulkDialog, Bulk, BulkRow } from "bulk.slint";
import { PropsDialog, Props, PropRow, PropSection, Gauge } from "props.slint";
import { ShelfPanel, ShelfState, ShelfItem } from "shelf.slint";
import { PreviewPane, PreviewState, CodeTok, CodeLine } from "preview.slint";
import { ViewerView, ViewerState, ViewerThumb } from "viewer.slint";
import { PaletteDialog, Palette, PaletteRow } from "palette.slint";
import { PlayerState } from "player.slint";
import { HomeView, HomeState, HomeDrive, HomeFolder, HomeFile, HomeSection, HomeActivity, HomeDay } from "home.slint";
import { SettingsView, SettingsState, SysItem, SideSection } from "settings.slint";
import { SyncView, SyncState, SyncCard, SyncHist } from "sync.slint";
import { SpaceView, SpaceState, SpaceTile, SpaceRow, SpaceJunk } from "space.slint";
import { TermPanel, TermState, TermLine, TermRun } from "term.slint";
// Pulpit to osobne okna (po jednym na monitor) – eksport, żeby slint-build je wygenerował.
export { DesktopWindow, DeskIcon } from "desktop.slint";
export { TaskbarWindow, TaskButton, BarMenuWindow, VolumeWindow, CalendarWindow, CalDay, NetworkWindow, NetRow, AppVol, ThumbWindow, ThumbCard, OutDev, TrayApp, TaskViewWindow, TaskCard } from "taskbar.slint";
export { StartWindow, StartRow, StartTile, StartHead } from "start.slint";
export { ClipWindow, ClipItem } from "clip.slint";

export { Drag, Theme, Icons, TabData, SideItem, Crumb, FacetChip, FacetRow, VisItem, Column, GroupHead, MenuEntry, OpItem, ToastItem, ConflictRow, Bulk, BulkRow, Props, PropRow, PropSection, Gauge, ShelfState, ShelfItem, Prompt, PreviewState, CodeTok, CodeLine, ViewerState, ViewerThumb, Palette, PaletteRow, PlayerState, HomeState, HomeDrive, HomeFolder, HomeFile, HomeSection, HomeActivity, HomeDay, SettingsState, SysItem, SyncState, SyncCard, SyncHist, SpaceState, SpaceTile, SpaceRow, SpaceJunk, TermState, TermLine, TermRun, AddrSugg }

/// Główne okno PowerDesk – układ jak App.svelte: pasek tytułu, pasek narzędzi, panel boczny, panel plików.
export component MainWindow inherits Window {
    title: "PowerDesk";
    icon: @image-url("../../src-tauri/icons/128x128.png");
    no-frame: true;
    min-width: 720px;
    min-height: 480px;
    preferred-width: 1360px;
    preferred-height: 860px;
    background: Theme.bg;
    default-font-family: Theme.font;
    default-font-size: Theme.font-size;

    in property <[TabData]> tabs;
    in property <[SideItem]> side;
    in property <bool> side-mini;
    in property <bool> is-maximized;

    // Pasek narzędzi.
    in property <[Crumb]> crumbs;
    in property <string> path;
    in property <image> folder-icon;
    in property <bool> special;
    in property <bool> can-back;
    in property <bool> can-forward;
    in property <bool> has-selection;
    in property <bool> can-paste;
    in property <bool> searching;
    in property <bool> search-active;
    in property <string> sort-label;
    in property <string> filter-summary;
    in property <bool> gallery-ok;
    in property <bool> has-facets;
    in property <bool> facets-open;
    in property <int> facets-chosen;
    in property <[FacetRow]> facet-rows;
    in property <string> facet-results;
    in property <bool> can-save-search;
    /// Filtry rozpoznane w polu wyszukiwania i podpowiedzi (QUERY_HINTS).
    in property <[string]> query-chips;
    in property <[string]> hints;
    in property <[string]> hint-tips;
    in-out property <string> query;
    in-out property <float> zoom;
    in property <float> zoom-min;
    in property <float> zoom-max;

    // Widok plików.
    in property <[VisItem]> items;
    in property <int> view;
    in property <length> total-height;
    in property <string> empty-text;
    in property <bool> sort-name;
    in property <string> folder;
    in property <int> rename-sel;
    in property <[Column]> columns;
    in property <[GroupHead]> heads;
    in property <bool> desc;
    in-out property <length> scroll-y;

    // Drugi panel (podział Ctrl+\): te same dane dla karty obok.
    in property <bool> split;
    /// Udział lewego panelu w szerokości obszaru.
    in property <float> split-ratio: 0.5;
    /// Wskazany panel – obramowanie pokazuje, która strona słucha klawiatury.
    in property <int> focused-pane;
    in property <[VisItem]> items2;
    in property <int> view2;
    in property <length> total-height2;
    in property <string> empty-text2;
    in property <bool> sort-name2;
    in property <string> folder2;
    in property <[Column]> columns2;
    in property <[GroupHead]> heads2;
    in property <bool> desc2;
    in-out property <length> scroll-y2;
    callback focus-pane(int);
    /// Przeciągnięcie uchwytu między panelami – nowy udział lewego panelu.
    callback split-resize(float);
    in property <string> status;
    // Transfery i powiadomienia.
    in property <[OpItem]> ops;
    in property <[ToastItem]> toasts;
    in property <string> ops-summary;
    in property <bool> transfers-hidden;
    // Okno konfliktu nazw.
    in property <bool> conflict-open;
    in property <string> conflict-title;
    in property <[ConflictRow]> conflict-rows;
    in property <string> conflict-more;
    in property <bool> conflict-dirs;
    in property <bool> conflict-moving;
    // Potwierdzenie.
    in property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-text;
    in property <string> confirm-ok;
    in property <bool> confirm-danger;

    // Menu.
    in property <[MenuEntry]> menu-entries;
    in property <length> menu-x;
    in property <length> menu-y;
    in property <length> menu-width: 240px;

    callback activate-tab(int);
    callback close-tab(int);
    callback move-tab(int, length);
    callback tab-menu(int, length, length);
    callback new-tab;
    callback minimize;
    callback toggle-maximize;
    callback close-window;
    callback drag;
    callback navigate(string);
    callback back;
    callback forward;
    callback up;
    callback refresh;
    callback crumb-menu(string, length, length);
    callback filter-changed(string);
    callback search(string);
    callback clear-search;
    callback sort-menu(length, length);
    callback set-view(int);
    callback zoom-changed(float);
    callback new-menu(length, length);
    callback command(string);
    callback toggle-facets;
    callback toggle-preview;
    callback toggle-facet(string);
    callback clear-facets;
    callback save-search;
    callback add-hint(string);
    callback side-context(string, length, length);
    /// Koniec przeciągania krawędzi panelu bocznego – nowa szerokość do zapisu.
    callback side-resized(float);
    /// Klawisz w panelu bocznym z fokusem; "" – panel właśnie dostał fokus.
    callback side-key(string);
    in-out property <int> side-cursor: -1;
    in-out property <length> side-width: 248px;
    callback toggle-section(string);
    callback toggle-side-mini;
    callback toggle-transfers;
    callback op-pause(int, bool);
    callback op-cancel(int);
    callback op-dismiss(int);
    callback toast-action(int);
    callback toast-close(int);
    callback conflict-pick(int);
    callback confirm-answer(bool);
    callback viewport-changed(int, length, length, length);
    callback select(int, bool, bool);
    callback open(int);
    callback context(int, length, length, bool);
    callback background-context(length, length, bool);
    callback marquee-begin(bool);
    callback marquee-update(length, length, length, length);
    callback marquee-end;
    callback header-sort(int);
    callback col-move(int, length);
    callback col-resize(int, length);
    callback col-resize-end;
    callback col-reset(int);
    callback col-menu(length, length);
    callback rename-commit(string);
    callback drag-start(int);
    callback toggle-group(int);
    callback select-group(int, bool);
    callback rename-cancel;
    callback rename-next(string, bool);
    callback zoom-step(int);
    callback menu-chosen(int);
    callback key(string, bool, bool, bool);

    public function show-menu() {
        menu.show();
    }

    menu := MenuPopup {
        x: root.menu-x;
        y: root.menu-y;
        menu-width: root.menu-width;
        entries: root.menu-entries;
        chosen(i) => {
            root.menu-chosen(i);
        }
    }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if (e.modifiers.control && e.text == "l") {
                toolbar.edit-address();
                return accept;
            }
            if (e.modifiers.alt && e.text == "d") {
                toolbar.edit-address();
                return accept;
            }
            // F6 / Shift+F6: między panelami (przy podziale) przełącza Rust, dalej panel boczny, podgląd i adres.
            if (e.text == Key.F6 && !(root.split && root.focused-pane == (e.modifiers.shift ? 1 : 0))) {
                if (e.modifiers.shift) {
                    side-bar.focus-in();
                } else if (PreviewState.open && !root.special) {
                    PreviewState.focus-req += 1;
                } else {
                    toolbar.edit-address();
                }
                return accept;
            }
            if ((e.modifiers.control && e.text == "f") || e.text == Key.F3) {
                toolbar.focus-search();
                return accept;
            }
            root.key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt);
            accept
        }

        VerticalLayout {
            tbar := TitleBar {
                tabs: root.tabs;
                maximized: root.is-maximized;
                activate(i) => {
                    root.activate-tab(i);
                }
                close-tab(i) => {
                    root.close-tab(i);
                }
                move-tab(i, x) => {
                    root.move-tab(i, x);
                }
                tab-menu(i, x, y) => {
                    root.tab-menu(i, x, y);
                }
                new-tab => {
                    root.new-tab();
                }
                minimize => {
                    root.minimize();
                }
                toggle-maximize => {
                    root.toggle-maximize();
                }
                close-window => {
                    root.close-window();
                }
                drag => {
                    root.drag();
                }
                commands: !root.special;
                has-selection: root.has-selection;
                can-paste: root.can-paste;
                new-menu(x, y) => {
                    root.new-menu(x, y);
                }
                command(c) => {
                    root.command(c);
                    keys.focus();
                }
            }

            // Bez podziału pasek adresu i poleceń jest jeden, na całą szerokość okna (jak w Eksploratorze).
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                    toolbar := Toolbar {
                        // Kolejność F6: adres → panel boczny → lista (oba panele) → podgląd → adres.
                        leave-address(last) => {
                            if (!last) {
                                side-bar.focus-in();
                            } else if (PreviewState.open && !root.special) {
                                PreviewState.focus-req += 1;
                            } else {
                                keys.focus();
                                root.focus-pane(root.split ? 1 : 0);
                            }
                        }
                        crumbs: root.crumbs;
                        path: root.path;
                        folder-icon: root.folder-icon;
                        special: root.special;
                        can-back: root.can-back;
                        can-forward: root.can-forward;
                        searching: root.searching;
                        search-active: root.search-active;
                        sort-label: root.sort-label;
                        filter-summary: root.filter-summary;
                        gallery-ok: root.gallery-ok;
                        shelf-count: ShelfState.count;
                        shelf-open: ShelfState.open;
                        preview-open: PreviewState.open;
                        toggle-preview => {
                            root.toggle-preview();
                        }
                        terminal-open: TermState.open;
                        toggle-terminal => {
                            TermState.toggle();
                        }
                        toggle-shelf => {
                            ShelfState.toggle();
                        }
                        has-facets: root.has-facets;
                        facets-open: root.facets-open;
                        facets-chosen: root.facets-chosen;
                        can-save-search: root.can-save-search;
                        toggle-facets => {
                            root.toggle-facets();
                        }
                        toggle-facet(id) => {
                            root.toggle-facet(id);
                        }
                        clear-facets => {
                            root.clear-facets();
                        }
                        save-search => {
                            root.save-search();
                        }
                        view: root.view;
                        zoom <=> root.zoom;
                        zoom-min: root.zoom-min;
                        zoom-max: root.zoom-max;
                        query <=> root.query;
                        back => {
                            root.back();
                        }
                        forward => {
                            root.forward();
                        }
                        up => {
                            root.up();
                        }
                        refresh => {
                            root.refresh();
                        }
                        navigate(p) => {
                            root.navigate(p);
                            keys.focus();
                        }
                        crumb-menu(p, x, y) => {
                            root.crumb-menu(p, x, y);
                        }
                        filter-changed(q) => {
                            root.filter-changed(q);
                        }
                        search(q) => {
                            root.search(q);
                        }
                        clear-search => {
                            root.clear-search();
                            keys.focus();
                        }
                        sort-menu(x, y) => {
                            root.sort-menu(x, y);
                        }
                        set-view(v) => {
                            root.set-view(v);
                        }
                        zoom-changed(z) => {
                            root.zoom-changed(z);
                        }
                    }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                padding-left: 8px;
                padding-right: 8px;
                padding-bottom: 8px;
                spacing: 8px;
                side-bar := Sidebar {
                    items: root.side;
                    mini: root.side-mini;
                    panel-width: root.side-width;
                    cursor: root.side-cursor;
                    key(k) => {
                        root.side-key(k);
                    }
                    focused => {
                        root.side-key("");
                    }
                    leave(back) => {
                        if (back) {
                            toolbar.edit-address();
                        } else {
                            keys.focus();
                            root.focus-pane(0);
                        }
                    }
                    toggle-section(n) => {
                        root.toggle-section(n);
                    }
                    toggle-mini => {
                        root.toggle-side-mini();
                    }
                    open(p) => {
                        root.navigate(p);
                    }
                    context(p, x, y) => {
                        root.side-context(p, x, y);
                    }
                    // Uchwyt szerokości na prawej krawędzi (w odstępie przed listą).
                    if !root.side-mini: TouchArea {
                        x: parent.width - 2px;
                        width: 8px;
                        mouse-cursor: MouseCursor.col-resize;
                        moved => {
                            if (self.pressed) {
                                root.side-width = clamp(root.side-width + self.mouse-x - self.pressed-x, 180px, 420px);
                            }
                        }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.up) {
                                root.side-resized(root.side-width / 1px);
                            }
                        }
                    }
                }
                // Panele (Pane.svelte): przy podziale dwa obok siebie, z uchwytem szerokości.
                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.bg;
                    border-radius: Theme.r-l;
                    clip: true;
                    VerticalLayout {
                        panes := HorizontalLayout {
                            vertical-stretch: 1;
                            // Lewy (albo jedyny) panel.
                            Rectangle {
                                horizontal-stretch: root.split ? root.split-ratio * 100 : 1;
                                border-width: root.split && root.focused-pane == 0 ? 1px : 0px;
                                border-color: Theme.line-strong;
                                border-radius: Theme.r;
                                VerticalLayout {
                                FileView {
                                    vertical-stretch: 1;
                                    items: root.items;
                                    view: root.view;
                                    total-height: root.total-height;
                                    empty-text: root.empty-text;
                                    sort-name: root.sort-name;
                                    folder: root.folder;
                                    drag-start(i) => {
                                        root.drag-start(i);
                                    }
                                    rename-sel: root.rename-sel;
                                    rename-commit(t) => {
                                        root.rename-commit(t);
                                        keys.focus();
                                    }
                                    rename-cancel => {
                                        root.rename-cancel();
                                        keys.focus();
                                    }
                                    rename-next(t, back) => {
                                        root.rename-next(t, back);
                                    }
                                    columns: root.columns;
                                    heads: root.heads;
                                    toggle-group(i) => {
                                        root.toggle-group(i);
                                    }
                                    select-group(i, c) => {
                                        keys.focus();
                                        root.select-group(i, c);
                                    }
                                    desc: root.desc;
                                    scroll-y <=> root.scroll-y;
                                    viewport-changed(t, w, h) => {
                                        root.viewport-changed(0, t, w, h);
                                    }
                                    select(i, c, s) => {
                                        keys.focus();
                                        root.select(i, c, s);
                                    }
                                    open(i) => {
                                        root.open(i);
                                    }
                                    context(i, x, y, shift) => {
                                        root.context(i, x, y, shift);
                                    }
                                    background-context(x, y, shift) => {
                                        keys.focus();
                                        root.background-context(x, y, shift);
                                    }
                                    marquee-begin(additive) => {
                                        keys.focus();
                                        root.marquee-begin(additive);
                                    }
                                    marquee-update(x0, y0, x1, y1) => {
                                        root.marquee-update(x0, y0, x1, y1);
                                    }
                                    marquee-end => {
                                        root.marquee-end();
                                    }
                                    header-sort(id) => {
                                        root.header-sort(id);
                                    }
                                    col-move(id, dx) => {
                                        root.col-move(id, dx);
                                    }
                                    col-resize(id, w) => {
                                        root.col-resize(id, w);
                                    }
                                    col-resize-end => {
                                        root.col-resize-end();
                                    }
                                    col-reset(id) => {
                                        root.col-reset(id);
                                    }
                                    col-menu(x, y) => {
                                        root.col-menu(x, y);
                                    }
                                    zoom(d) => {
                                        root.zoom-step(d);
                                    }
                                }
                                }
                                if HomeState.open && (!root.split || root.focused-pane == 0): HomeView {
                                    width: parent.width;
                                    height: parent.height;
                                }
                                if SpaceState.open && (!root.split || root.focused-pane == 0): SpaceView {
                                    width: parent.width;
                                    height: parent.height;
                                }
                                if SyncState.open && (!root.split || root.focused-pane == 0): SyncView {
                                    width: parent.width;
                                    height: parent.height;
                                }
                                if SettingsState.open && (!root.split || root.focused-pane == 0): SettingsView {
                                    width: parent.width;
                                    height: parent.height;
                                }
                            }
                            // Uchwyt szerokości między panelami.
                            if root.split: Rectangle {
                                width: 6px;
                                background: h-ta.has-hover || h-ta.pressed ? Theme.line-strong : transparent;
                                h-ta := TouchArea {
                                    mouse-cursor: ew-resize;
                                    moved => {
                                        if (self.pressed) {
                                            root.split-resize((self.absolute-position.x + self.mouse-x - panes.absolute-position.x) / panes.width);
                                        }
                                    }
                                }
                            }
                            // Prawy panel – karta obok.
                            if root.split: Rectangle {
                                horizontal-stretch: (1 - root.split-ratio) * 100;
                                border-width: root.focused-pane == 1 ? 1px : 0px;
                                border-color: Theme.line-strong;
                                border-radius: Theme.r;
                                VerticalLayout {
                                FileView {
                                    vertical-stretch: 1;
                                    items: root.items2;
                                    view: root.view2;
                                    total-height: root.total-height2;
                                    empty-text: root.empty-text2;
                                    sort-name: root.sort-name2;
                                    folder: root.folder2;
                                    drag-start(i) => {
                                        root.focus-pane(1);
                                        root.drag-start(i);
                                    }
                                    rename-sel: root.rename-sel;
                                    rename-commit(t) => {
                                        root.focus-pane(1);
                                        root.rename-commit(t);
                                        keys.focus();
                                    }
                                    rename-cancel => {
                                        root.focus-pane(1);
                                        root.rename-cancel();
                                        keys.focus();
                                    }
                                    rename-next(t, back) => {
                                        root.focus-pane(1);
                                        root.rename-next(t, back);
                                    }
                                    columns: root.columns2;
                                    heads: root.heads2;
                                    toggle-group(i) => {
                                        root.focus-pane(1);
                                        root.toggle-group(i);
                                    }
                                    select-group(i, c) => {
                                        keys.focus();
                                        root.focus-pane(1);
                                        root.select-group(i, c);
                                    }
                                    desc: root.desc2;
                                    scroll-y <=> root.scroll-y2;
                                    viewport-changed(t, w, h) => {
                                        root.viewport-changed(1, t, w, h);
                                    }
                                    select(i, c, s) => {
                                        keys.focus();
                                        root.focus-pane(1);
                                        root.select(i, c, s);
                                    }
                                    open(i) => {
                                        root.focus-pane(1);
                                        root.open(i);
                                    }
                                    context(i, x, y, shift) => {
                                        root.focus-pane(1);
                                        root.context(i, x, y, shift);
                                    }
                                    background-context(x, y, shift) => {
                                        keys.focus();
                                        root.focus-pane(1);
                                        root.background-context(x, y, shift);
                                    }
                                    marquee-begin(additive) => {
                                        keys.focus();
                                        root.focus-pane(1);
                                        root.marquee-begin(additive);
                                    }
                                    marquee-update(x0, y0, x1, y1) => {
                                        root.focus-pane(1);
                                        root.marquee-update(x0, y0, x1, y1);
                                    }
                                    marquee-end => {
                                        root.focus-pane(1);
                                        root.marquee-end();
                                    }
                                    header-sort(id) => {
                                        root.focus-pane(1);
                                        root.header-sort(id);
                                    }
                                    col-move(id, dx) => {
                                        root.focus-pane(1);
                                        root.col-move(id, dx);
                                    }
                                    col-resize(id, w) => {
                                        root.focus-pane(1);
                                        root.col-resize(id, w);
                                    }
                                    col-resize-end => {
                                        root.focus-pane(1);
                                        root.col-resize-end();
                                    }
                                    col-reset(id) => {
                                        root.focus-pane(1);
                                        root.col-reset(id);
                                    }
                                    col-menu(x, y) => {
                                        root.focus-pane(1);
                                        root.col-menu(x, y);
                                    }
                                    zoom(d) => {
                                        root.focus-pane(1);
                                        root.zoom-step(d);
                                    }
                                }
                                }
                                if HomeState.open && root.focused-pane == 1: HomeView {
                                    width: parent.width;
                                    height: parent.height;
                                }
                                if SpaceState.open && root.focused-pane == 1: SpaceView {
                                    width: parent.width;
                                    height: parent.height;
                                }
                                if SyncState.open && root.focused-pane == 1: SyncView {
                                    width: parent.width;
                                    height: parent.height;
                                }
                                if SettingsState.open && root.focused-pane == 1: SettingsView {
                                    width: parent.width;
                                    height: parent.height;
                                }
                            }
                        }
                        // Terminal (Terminal.svelte) – po ukryciu sesja żyje dalej w termview.rs.
                        if TermState.open: TermPanel { }
                        // Pasek stanu (StatusBar.svelte); po prawej podsumowanie transferów – klik chowa/pokazuje pasek.
                        Rectangle {
                            height: 28px;
                            Label {
                                x: 14px;
                                width: parent.width - 28px - sum.width;
                                text: root.status;
                                font-size: 12px;
                                color: Theme.faint;
                            }
                            sum := Rectangle {
                                x: parent.width - self.width - 8px;
                                y: 2px;
                                height: 24px;
                                width: root.ops-summary == "" ? 0 : sum-row.preferred-width + 16px;
                                border-radius: Theme.r-s;
                                background: sum-ta.has-hover ? Theme.hover : transparent;
                                visible: root.ops-summary != "";
                                sum-row := HorizontalLayout {
                                    x: 8px;
                                    spacing: 6px;
                                    Icon {
                                        y: (parent.height - self.height) / 2;
                                        commands: Icons.sync;
                                        size: 13px;
                                        color: Theme.dim;
                                    }
                                    Label {
                                        text: root.ops-summary;
                                        font-size: 12px;
                                        color: sum-ta.has-hover ? Theme.text : Theme.dim;
                                    }
                                }
                                sum-ta := TipArea {
                                    tip: root.transfers-hidden ? "Pokaż pasek transferów" : "Ukryj pasek transferów";
                                    clicked => {
                                        root.toggle-transfers();
                                    }
                                }
                            }
                        }
                    }
                }
                // Podgląd (PreviewPane.svelte).
                if PreviewState.open && !root.special: PreviewPane {
                    leave(back) => {
                        if (back) {
                            keys.focus();
                            root.focus-pane(root.split ? 1 : 0);
                        } else {
                            toolbar.edit-address();
                        }
                    }
                }
            }
        }
    }

    // Podpowiedzi przy edycji ścieżki – pod polem adresu, nad listą plików.
    if AddrSugg.show && AddrSugg.items.length > 0: Rectangle {
        x: AddrSugg.x;
        y: AddrSugg.y;
        width: AddrSugg.width;
        height: sugg-list.preferred-height;
        drop-shadow-blur: 50px;
        drop-shadow-offset-y: 20px;
        drop-shadow-color: Theme.shadow;
        background: Theme.popup-high;
        border-radius: Theme.r;
        border-width: 1px;
        border-color: Theme.line;
        sugg-list := VerticalLayout {
            padding: 6px;
            for p[i] in AddrSugg.items: Rectangle {
                height: 32px;
                border-radius: Theme.r-s;
                background: i == AddrSugg.index || sg-ta.has-hover ? Theme.press : transparent;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        commands: Icons.folder;
                        size: 15px;
                        color: Theme.dim;
                    }
                    Label {
                        horizontal-stretch: 1;
                        text: p;
                        font-size: 12.5px;
                        color: i == AddrSugg.index || sg-ta.has-hover ? Theme.text : Theme.dim;
                    }
                }
                sg-ta := TouchArea {
                    clicked => {
                        toolbar.pick-suggestion(p);
                    }
                }
            }
        }
    }

    // Paleta poleceń – nad całym oknem, pod paskiem tytułu.
    if Palette.open: PaletteDialog {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
    }

    // Pasek transferów i powiadomienia – prawy dolny róg, nad paskiem stanu.
    // Przeglądarka zdjęć – pod paskiem tytułu (przyciski okna zostają), w pełnym ekranie całe okno.
    if ViewerState.open: ViewerView {
        x: 0;
        y: ViewerState.fullscreen ? 0 : tbar.height;
        width: root.width;
        height: root.height - self.y;
    }
    // Półka – prawy dolny róg; pasek transferów odsuwa się wtedy w lewo.
    if ShelfState.open && !root.special: ShelfPanel {
        x: root.width - self.width - 22px;
        y: root.height - self.height - 44px;
    }
    TransferStack {
        x: root.width - self.width - 22px - (ShelfState.open && !root.special ? 352px : 0);
        y: root.height - self.height - 44px;
        ops: root.ops;
        toasts: root.toasts;
        pause(id, on) => {
            root.op-pause(id, on);
        }
        cancel(id) => {
            root.op-cancel(id);
        }
        dismiss(id) => {
            root.op-dismiss(id);
        }
        toast-action(id) => {
            root.toast-action(id);
        }
        toast-close(id) => {
            root.toast-close(id);
        }
    }

    if root.conflict-open: ConflictDialog {
        title: root.conflict-title;
        rows: root.conflict-rows;
        more: root.conflict-more;
        has-dirs: root.conflict-dirs;
        moving: root.conflict-moving;
        pick(i) => {
            root.conflict-pick(i);
        }
    }
    if root.confirm-open: ConfirmDialog {
        title: root.confirm-title;
        text: root.confirm-text;
        ok: root.confirm-ok;
        danger: root.confirm-danger;
        answer(yes) => {
            root.confirm-answer(yes);
        }
    }
    if Bulk.open: BulkDialog { }
    if Props.open: PropsDialog { }
    if Prompt.open: PromptDialog { }

    // Fasety: panel nad listą; klik obok zamyka.
    if root.facets-open && !root.special: TouchArea {
        clicked => {
            root.toggle-facets();
        }
    }
    if root.facets-open && !root.special: FacetPanel {
        width: min(620px, toolbar.width - 24px);
        x: toolbar.absolute-position.x + toolbar.width - self.width - 12px;
        y: toolbar.absolute-position.y + toolbar.height + 2px;
        facet-rows: root.facet-rows;
        results: root.facet-results;
        toggle-facet(id) => {
            root.toggle-facet(id);
        }
        clear-facets => {
            root.clear-facets();
        }
    }

    // Pomoc do pola wyszukiwania: rozpoznane filtry i podpowiedzi (qhelp w Toolbar.svelte).
    if toolbar.search-focused && !root.special: Rectangle {
        x: toolbar.search-right - self.width;
        y: toolbar.search-bottom + 6px;
        width: 360px;
        height: qhelp.preferred-height;
        border-radius: Theme.r-l;
        background: Theme.popup;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 50px;
        drop-shadow-offset-y: 20px;
        drop-shadow-color: Theme.shadow;
        // Klik w panel nie może zabrać fokusu polu wyszukiwania.
        TouchArea { }
        qhelp := VerticalLayout {
            padding: 12px;
            spacing: 8px;
            if root.query-chips.length > 0: HorizontalLayout {
                spacing: 5px;
                alignment: start;
                Label {
                    text: "Rozpoznane:";
                    font-size: 12px;
                    color: Theme.faint;
                }
                for c in root.query-chips: Rectangle {
                    height: 22px;
                    width: qc.preferred-width + 16px;
                    border-radius: Theme.r-s;
                    background: Theme.accent;
                    qc := Label {
                        text: c;
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.on-accent;
                    }
                }
            }
            Text {
                text: "Pisz, aby filtrować ten folder · Enter szuka także w podfolderach · dodaj filtr:";
                wrap: word-wrap;
                font-family: Theme.font;
                font-size: 12px;
                color: Theme.faint;
            }
            Rectangle {
                height: 5 * 26px + 4 * 5px;
                for h[i] in root.hints: Rectangle {
                    x: mod(i, 2) * (parent.width + 5px) / 2;
                    y: floor(i / 2) * 31px;
                    width: (parent.width - 5px) / 2;
                    height: 26px;
                    border-radius: Theme.r-s;
                    background: hint-ta.has-hover ? Theme.press : Theme.card;
                    Label {
                        x: 10px;
                        width: parent.width - 20px;
                        text: h;
                        font-family: Theme.mono;
                        font-size: 11px;
                        color: hint-ta.has-hover ? Theme.text : Theme.dim;
                    }
                    hint-ta := TipArea {
                        tip: root.hint-tips[i];
                        clicked => {
                            root.add-hint(h);
                        }
                    }
                }
            }
        }
    }

    // Dymek z podpowiedzią – po 0,6 s bez ruchu na tym samym elemencie, zawsze w oknie.
    property <int> tip-shown: -1;
    Timer {
        interval: 600ms;
        running: Tip.text != "" && root.tip-shown != Tip.serial;
        triggered => {
            root.tip-shown = Tip.serial;
        }
    }
    if Tip.text != "" && root.tip-shown == Tip.serial: Rectangle {
        property <length> below: Tip.y + 22px;
        x: max(8px, min(Tip.x - 8px, root.width - self.width - 8px));
        y: self.below + self.height > root.height - 8px ? Tip.y - self.height - 10px : self.below;
        width: min(tip-text.preferred-width, 340px) + 20px;
        height: tip-text.preferred-height + 12px;
        border-radius: Theme.r-s;
        background: Theme.higher;
        border-width: 1px;
        border-color: Theme.line-strong;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: Theme.shadow;
        tip-text := Text {
            x: 10px;
            y: 6px;
            width: parent.width - 20px;
            text: Tip.text;
            wrap: word-wrap;
            font-family: Theme.font;
            font-size: 12px;
            color: Theme.text;
        }
    }
}
export { WidgetData, WDay, WDrive, WidgetItem, WZone, WFc, WRem } from "widgets.slint";
export { OverlayWindow } from "overlay.slint";
