import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Label } from "components.slint";
import { TitleBar, TabData } from "titlebar.slint";
import { Sidebar, SideItem } from "sidebar.slint";
import { Toolbar, Crumb } from "toolbar.slint";
import { FileView, VisItem } from "fileview.slint";
import { MenuPopup, MenuEntry } from "menu.slint";

export { Theme, Icons, TabData, SideItem, Crumb, VisItem, MenuEntry }

/// Główne okno PowerDesk – układ jak App.svelte: pasek tytułu, pasek narzędzi, panel boczny, panel plików.
export component MainWindow inherits Window {
    title: "PowerDesk";
    icon: @image-url("../../src-tauri/icons/128x128.png");
    no-frame: true;
    min-width: 720px;
    min-height: 480px;
    preferred-width: 1360px;
    preferred-height: 860px;
    background: Theme.bg;
    default-font-family: Theme.font;
    default-font-size: Theme.font-size;

    in property <[TabData]> tabs;
    in property <[SideItem]> side;
    in property <bool> is-maximized;

    // Pasek narzędzi.
    in property <[Crumb]> crumbs;
    in property <string> path;
    in property <image> folder-icon;
    in property <bool> special;
    in property <bool> can-back;
    in property <bool> can-forward;
    in property <bool> has-selection;
    in property <bool> searching;
    in property <bool> search-active;
    in property <string> sort-label;
    in-out property <string> query;
    in-out property <float> zoom;
    in property <float> zoom-min;
    in property <float> zoom-max;

    // Widok plików.
    in property <[VisItem]> items;
    in property <int> view;
    in property <length> total-height;
    in property <string> empty-text;
    in property <string> sort-id;
    in property <bool> desc;
    in-out property <length> scroll-y;
    in property <string> status;

    // Menu.
    in property <[MenuEntry]> menu-entries;
    in property <length> menu-x;
    in property <length> menu-y;
    in property <length> menu-width: 240px;

    callback activate-tab(int);
    callback close-tab(int);
    callback new-tab;
    callback minimize;
    callback toggle-maximize;
    callback close-window;
    callback drag;
    callback navigate(string);
    callback back;
    callback forward;
    callback up;
    callback refresh;
    callback crumb-menu(string, length, length);
    callback filter-changed(string);
    callback search(string);
    callback clear-search;
    callback sort-menu(length, length);
    callback set-view(int);
    callback zoom-changed(float);
    callback new-menu(length, length);
    callback command(string);
    callback viewport-changed(length, length, length);
    callback select(int, bool, bool);
    callback open(int);
    callback context(int, length, length);
    callback background-click;
    callback header-sort(string);
    callback zoom-step(int);
    callback menu-chosen(int);
    callback key(string, bool, bool, bool);

    public function show-menu() {
        menu.show();
    }

    menu := MenuPopup {
        x: root.menu-x;
        y: root.menu-y;
        menu-width: root.menu-width;
        entries: root.menu-entries;
        chosen(i) => {
            root.menu-chosen(i);
        }
    }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if (e.modifiers.control && e.text == "l") {
                toolbar.edit-address();
                return accept;
            }
            if (e.modifiers.alt && e.text == "d") {
                toolbar.edit-address();
                return accept;
            }
            if ((e.modifiers.control && e.text == "f") || e.text == Key.F3) {
                toolbar.focus-search();
                return accept;
            }
            root.key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt);
            accept
        }

        VerticalLayout {
            TitleBar {
                tabs: root.tabs;
                maximized: root.is-maximized;
                activate(i) => {
                    root.activate-tab(i);
                }
                close-tab(i) => {
                    root.close-tab(i);
                }
                new-tab => {
                    root.new-tab();
                }
                minimize => {
                    root.minimize();
                }
                toggle-maximize => {
                    root.toggle-maximize();
                }
                close-window => {
                    root.close-window();
                }
                drag => {
                    root.drag();
                }
            }

            // Bez podziału pasek adresu i poleceń jest jeden, na całą szerokość okna (jak w Eksploratorze).
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                    toolbar := Toolbar {
                        crumbs: root.crumbs;
                        path: root.path;
                        folder-icon: root.folder-icon;
                        special: root.special;
                        can-back: root.can-back;
                        can-forward: root.can-forward;
                        has-selection: root.has-selection;
                        searching: root.searching;
                        search-active: root.search-active;
                        sort-label: root.sort-label;
                        view: root.view;
                        zoom <=> root.zoom;
                        zoom-min: root.zoom-min;
                        zoom-max: root.zoom-max;
                        query <=> root.query;
                        back => {
                            root.back();
                        }
                        forward => {
                            root.forward();
                        }
                        up => {
                            root.up();
                        }
                        refresh => {
                            root.refresh();
                        }
                        navigate(p) => {
                            root.navigate(p);
                            keys.focus();
                        }
                        crumb-menu(p, x, y) => {
                            root.crumb-menu(p, x, y);
                        }
                        filter-changed(q) => {
                            root.filter-changed(q);
                        }
                        search(q) => {
                            root.search(q);
                        }
                        clear-search => {
                            root.clear-search();
                            keys.focus();
                        }
                        sort-menu(x, y) => {
                            root.sort-menu(x, y);
                        }
                        set-view(v) => {
                            root.set-view(v);
                        }
                        zoom-changed(z) => {
                            root.zoom-changed(z);
                        }
                        new-menu(x, y) => {
                            root.new-menu(x, y);
                        }
                        command(c) => {
                            root.command(c);
                        }
                    }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                padding-left: 8px;
                padding-right: 8px;
                padding-bottom: 8px;
                spacing: 8px;
                Sidebar {
                    items: root.side;
                    open(p) => {
                        root.navigate(p);
                    }
                }
                // Panel (Pane.svelte).
                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.bg;
                    border-radius: Theme.r-l;
                    clip: true;
                    VerticalLayout {
                        FileView {
                            vertical-stretch: 1;
                            items: root.items;
                            view: root.view;
                            total-height: root.total-height;
                            empty-text: root.empty-text;
                            sort-name: root.sort-id == "name";
                            sort-modified: root.sort-id == "modified";
                            sort-type: root.sort-id == "type";
                            sort-size: root.sort-id == "size";
                            desc: root.desc;
                            scroll-y <=> root.scroll-y;
                            viewport-changed(t, w, h) => {
                                root.viewport-changed(t, w, h);
                            }
                            select(i, c, s) => {
                                keys.focus();
                                root.select(i, c, s);
                            }
                            open(i) => {
                                root.open(i);
                            }
                            context(i, x, y) => {
                                root.context(i, x, y);
                            }
                            background-click => {
                                keys.focus();
                                root.background-click();
                            }
                            header-sort(id) => {
                                root.header-sort(id);
                            }
                            zoom(d) => {
                                root.zoom-step(d);
                            }
                        }
                        // Pasek stanu (StatusBar.svelte).
                        Rectangle {
                            height: 28px;
                            Label {
                                x: 14px;
                                text: root.status;
                                font-size: 12px;
                                color: Theme.faint;
                            }
                        }
                    }
                }
            }
        }
    }
}
