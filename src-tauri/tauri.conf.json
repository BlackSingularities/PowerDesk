{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenFilePower",
  "version": "../package.json",
  "identifier": "pl.openfilepower.win",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OpenFilePower",
        "width": 1360,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#000000",
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Menedżer plików z galerią i synchronizacją",
    "copyright": "adam001d",
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Polish", "English"] },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
